":[1,102870,4125,1,0.96],"很累。星期六我要好好休息。|m":[1,106995,18645,1],"我九点开始工作。":[1,125640,9525,1,0.97],"我九点才起床。你几点上班？":[1,135165,16965,1],"我今天很忙，没有时间。":[1,152130,14205,1,0.96],"我们七点吃饭。":[1,166335,7605,1],"我太累了，想休息一下。":[1,173940,14565,1],"我明天要上班。":[1,188505,8085,1],"我是医生，在医院工作。":[1,196590,14205,1,0.96],"我晚上十一点睡觉。":[1,210795,10245,1],"我每天六点就起床了。|m":[1,221040,11685,1],"我每天工作九个小时，很忙，也很累。":[1,232725,21765,1],"我每天工作八个小时。":[1,254490,10845,1],"我每天早上七点起床。":[1,265335,11325,1],"我每天早上六点起床，七点吃饭，八点上班。":[1,276660,25485,1],"我每天都七点起床。":[1,302145,10125,1,0.95],"我要去北京。":[1,312270,7245,1,0.96],"我要走了，再见！":[1,319515,10485,1,0.95],"早上":[1,330000,4125,1],"早上我喝茶。":[1,334125,7965,1],"时间":[1,342090,4245,0,0.96],"星期六和星期日我不上班，在家休息。":[1,346335,21405,1],"星期日":[1,367740,5565,1,0.95],"星期日我在家休息。":[1,373305,10485,1],"晚上":[1,383790,4125,1],"晚上七点我回家，看一个小时电视，十一点就睡觉了。":[1,387915,29445,1],"晚上我洗衣服。":[1,417360,8445,1],"每个人都很忙。":[1,425805,7965,1],"每个星期我工作五天。":[1,433770,10245,1],"每天":[1,444015,4005,1,0.96],"洗":[1,448020,3885,1,0.45],"累":[1,451905,2925,1,0.4],"要":[1,454830,3885,1,0.42],"请你明天再来。":[1,458715,8205,1],"起床":[1,466920,4125,1,0.96],"一千块太贵了！":[2,0,8325,1],"三百块":[2,8325,5205,1],"三百块。":[2,13530,5205,1],"两百八，可以吗？|m":[2,18735,12165,1,0.91],"两百块":[2,30900,4965,1],"两百块。":[2,35865,4965,1],"今天是星期六，我和妈妈去商店买衣服。":[2,40830,21645,1],"他喜欢穿黑衣服。":[2,62475,9645,1],"你可以坐这里。":[2,72120,7725,1],"你喜欢什么颜色？":[2,79845,8805,1],"你好，这件衣服多少钱？":[2,88650,14925,1],"你穿红的很漂亮。":[2,103575,10005,0],"你穿这件吧。":[2,113580,6765,1],"你穿这件吧，很漂亮。":[2,120345,13485,1],"便宜":[2,133830,4005,1,0.94],"可以，你看吧。":[2,137835,9645,1],"吧":[2,147480,4005,1],"商店里有很多新衣服，有红的、白的，也有黑的。":[2,151485,31605,1],"太贵了！便宜一点吧。":[2,183090,14925,1],"太贵了，便宜一点吧。":[2,198015,14805,1],"好。有黑的吗？":[2,212820,10125,0,0.93],"妈妈说：“你看看这件白的吧，很便宜，两百块。”":[2,222945,30525,1],"很好，我要了。":[2,253470,10125,1,0.91],"我们买了那件白的。":[2,263595,9045,1],"我们去商店吧。":[2,272640,7605,1],"我们去商店看看吧。":[2,280245,9885,1],"我可以看看吗？":[2,290130,7605,1],"我可以穿一下吗？":[2,297735,8685,1],"我喜欢红的。":[2,306420,7245,1],"我很喜欢一件红的，八百块，太贵了。":[2,313665,23205,1],"我想买一件衣服。":[2,336870,9045,1],"我想买一张新桌子。":[2,345915,10845,1],"我穿了一下，很漂亮。":[2,356760,13365,1,0.95],"我要红的，不要白的。":[2,370125,12645,1,0.97],"有。你可以穿一下。|m":[2,382770,12165,0],"白的可以吗？":[2,394935,6765,1],"白的太小了。":[2,401700,7125,1],"红":[2,408825,4005,1,0.49],"这个商店卖水果吗？":[2,412830,9765,1,0.95],"这些衣服都很便宜。":[2,422595,10245,1],"这件很贵吧？":[2,432840,7245,1],"这件衣服多少钱？":[2,440085,9405,1],"这张桌子三千元。":[2,449490,9645,1],"这张桌子很便宜。":[2,459135,9525,1],"这是新衣服吗？":[2,468660,7485,1,0.97],"这本书二十元。":[2,476145,8445,1],"颜色":[2,484590,4125,1,0.97],"他给我买了一个西瓜。":[3,0,9885,1],"你喝完咖啡了吗？":[3,9885,8445,1],"你喝茶还是喝咖啡？":[3,18330,10845,1,0.97],"你要鱼还是羊肉？":[3,29175,8925,1],"你还想吃什么？":[3,38100,7365,1],"公斤":[3,45465,3885,1,0.88],"吃完饭，我们还一起喝一杯咖啡。":[3,49350,19965,1],"咖啡":[3,69315,4005,1,0.9],"好吃":[3,73320,4245,1],"好的":[3,77565,4005,1,0.97],"好的。":[3,81570,4005,1,0.96],"妈妈给我做饭。":[3,85575,8325,1],"您喝茶还是喝咖啡？":[3,93900,10845,1,0.96],"您好！您想吃什么？":[3,104745,12525,1],"我们一起去喝咖啡，怎么样？":[3,117270,15045,1,0.95],"我们一起吃饭吧。":[3,132315,8565,1],"我们每个星期都去那里吃饭。":[3,140880,13485,1],"我吃完了":[3,154365,6165,1,0.93],"我吃完了。":[3,160530,6045,1,0.93],"我和朋友最喜欢去学校后面的一家饭馆。":[3,166575,19125,1],"我喝牛奶":[3,185700,6525,1],"我喝牛奶。":[3,192225,6645,1],"我早上吃两个鸡蛋。":[3,198870,10125,1],"我最喜欢吃羊肉。":[3,208995,9525,1],"我最喜欢那里的鱼，我朋友最喜欢羊肉。":[3,218520,20925,1],"我要羊肉和米饭。|m":[3,239445,8925,1],"我还没吃完。":[3,248370,7485,1],"或者":[3,255855,4125,1,0.89],"服务员":[3,259980,4845,1,0.97],"服务员，再来一杯茶！":[3,264825,13725,1],"服务员，请给我一杯咖啡。":[3,278550,15165,1],"牛奶":[3,293715,4005,1,0.94],"给":[3,297720,4605,1,0.48],"给我一杯咖啡吧。|m":[3,302325,9045,1],"羊肉":[3,311370,4125,1],"茶或者咖啡都可以。":[3,315495,10365,1,0.95],"西瓜":[3,325860,4365,0,0.91],"西瓜多少钱一公斤？":[3,330225,10245,1,0.94],"请给我一杯咖啡。":[3,340470,9045,1],"还":[3,349515,4245,1,0.44],"还是":[3,353760,4125,1],"这家饭馆的菜最好吃。":[3,357885,11325,1],"这里什么菜最好吃？|m":[3,369210,10365,1],"这里的鱼真好吃！":[3,379575,8685,1],"那里的服务员都很好。":[3,388260,10605,1],"那里的菜很好吃，也很便宜。":[3,398865,16845,1],"鱼和羊肉都很好吃。":[3,415710,10725,1,0.94],"鸡蛋":[3,426435,4005,1,0.97],"鸡蛋和牛奶都很便宜。":[3,430