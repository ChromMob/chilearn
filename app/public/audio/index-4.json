{"files":["h4u01.mp3","h4u02.mp3","h4u03.mp3","h4u04.mp3","h4u05.mp3","h4u06.mp3","h4u07.mp3","h4u08.mp3","h4u09.mp3","h4u10.mp3","h4u11.mp3","h4u12.mp3","h4u13.mp3","h4u14.mp3","h4u15.mp3","h4u16.mp3","h4u17.mp3","h4u18.mp3","h4u19.mp3","h4u20.mp3"],"clips":{"一切":[0,0,4725,1],"不过":[0,4725,4485,1,0.85],"与":[0,9210,4125,1,0.39],"之":[0,13335,3165,1,0.35],"今天热死了，我们去喝点东西吧。":[0,16500,18525,1],"他以优秀的成绩毕业了。":[0,35025,12645,1],"他喜欢安静，而他妻子喜欢热闹。":[0,47670,18645,1],"他很努力，最后成为了一位有名的医生。":[0,66315,21285,1],"他很累，却不想休息。":[0,87600,15645,1,0.88],"他说他很好，不过我感觉他不太高兴。":[0,103245,21165,1,0.94],"任何":[0,124410,4965,1,0.9],"休息十分钟以后，会议继续进行。":[0,129375,19605,1,0.93],"优秀":[0,148980,4845,1,0.79],"你对新生活感觉怎么样？":[0,153825,12645,1],"内":[0,166470,3765,1,0.37],"刚来的时候，所有的事情对我来说都很新鲜，不过也有不少困难。":[0,170235,34605,1],"去年秋天，我离开家，来到北京工作。":[0,204840,23085,1],"发生":[0,227925,4965,1,0.97],"场":[0,232890,4965,1,0.53],"大家都来了，他却还没到。":[0,237855,16005,1],"天气突然冷起来了，你要多穿点衣服。":[0,253860,20685,1],"如果有任何问题，你可以直接问我。":[0,274545,19725,1,0.9],"妈妈常常打电话来问我的情况，让我一定要注意安全。":[0,294270,27885,1],"安全":[0,322155,4965,1],"对我来说，安全是最重要的。":[0,327120,16965,1],"对我来说，这是一次很好的机会。":[0,344085,18405,1,0.88],"对我来说，这里已经成为了我的第二个家。":[0,362490,20685,1],"当":[0,383175,4125,1,0.46],"当你感觉很累的时候，就好好休息吧。":[0,387300,20685,1],"当我到家的时候，孩子已经睡觉了。":[0,407985,19725,1],"当我来北京的时候，一个朋友也没有。":[0,427710,19245,1],"当我第一次一个人坐地铁的时候，我不知道应该在哪儿换车，最后在一位阿姨的帮助下才找到了公司。":[0,446955,55725,1],"情况":[0,502680,4845,1,0.87],"感觉":[0,507525,4485,1],"成为":[0,512010,4845,1],"我以前在北京住过两年。":[0,516855,12525,1,0.97],"我叫了他好几次，他却没回答。":[0,529380,18405,1,0.94],"我喜欢吃苹果、西瓜等水果。":[0,547785,17805,1],"我对中国历史很有兴趣。":[0,565590,13485,1,0.9],"我没有放弃，而是继续努力工作，周末去参加各种活动，认识了很多新朋友。":[0,579075,41325,1,0.91],"我的生活发生了很大的变化，一切都越来越好。":[0,620400,25485,1],"所有":[0,645885,4845,1,0.88],"所有的同学都通过了考试。":[0,650730,14445,1],"无":[0,665175,3045,1,0.33],"昨天那场比赛你看了吗？":[0,668220,12645,1],"最后":[0,680865,4845,1,0.92],"最近情况怎么样？一切都好吗？":[0,685710,17925,1],"来北京以后，我的生活发生了很大的变化。":[0,703635,23445,1],"毕业":[0,727080,4245,1,0.84],"热闹":[0,731325,4605,1,0.78],"现在，我已经通过了公司的考试，成为了正式员工。":[0,735930,28605,1],"生活":[0,764535,5085,1,0.86],"由":[0,769620,3045,1,0.39],"直接":[0,772665,4845,1],"组织":[0,777510,4965,1],"继续":[0,782475,4845,1],"而":[0,787320,3045,1,0.34],"虽然北京的冬天冷死了，我却越来越喜欢这座城市。":[0,790365,26925,1],"行":[0,817290,3405,1,0.49],"行，没问题，我明天去。":[0,820695,18525,1],"请在一个星期内完成作业。":[0,839220,13845,1],"起来":[0,853065,4485,1,0.92],"这件事情与他没有关系。":[0,857550,12405,1],"这位老师对学生非常好。":[0,869955,13125,1],"这是我最喜欢的城市之一。":[0,883080,13845,1],"这条路晚上几乎无人，不太安全。":[0,896925,19485,1],"这次比赛由我们学校组织。":[0,916410,13725,1],"进行":[0,930135,5085,1,0.85],"通过":[0,935220,4725,1,0.89],"那时候我常常感觉很孤单，晚上回到家，房间里安静得让人难过。":[0,939945,35565,1],"上个月，我们公司计划组织一次周末旅游。":[1,0,23805,1],"为了了解大家的想法，经理让我做一个调查。":[1,23805,22005,1,0.93],"五十":[1,45810,4845,1],"他工作很忙，周末甚至也要上班。":[1,50655,19605,1],"他很高兴地接受了我们的邀请。":[1,70260,16005,1],"他忙得连周末都不休息。":[1,86265,12765,1],"他连我的名字都忘记了。":[1,99030,12525,1],"份":[1,111555,3885,1,0.43],"你在干什么呢？":[1,115440,8205,1],"你怎么才来呀？大家都在等你。":[1,123645,17685,1],"你拉我一下，我站不起来了。":[1,141330,16365,1],"保护":[1,157695,4845,1],"保证":[1,162540,4845,1],"公司每年都组织大家去旅游。":[1,167385,14805,1],"其中":[1,182190,4725,1],"出发":[1,186915,4725,1],"原因":[1,191640,4725,1,0.81],"反对":[1,196365,4845,1],"发":[1,201210,4125,1,0.57],"只要你努力，就一定能成功。":[1,205335,16485,1],"只要方法对，学习汉语就不难。":[1,221820,17685,1,0.94],"只要有时间，我就去锻炼。":[1,239505,15765,1],"可是":[1,255270,4965,1],"后来我改变了方法：活动不在周末，而改在星期五下午，并且大家可以带家人一起来。":[1,260235,45645,1],"呀":[1,305880,3045,1,0.91],"困难":[1,308925,4485,1,0.91],"失败":[1,313410,4845,1],"完全":[1,318255,5085,1],"干":[1,323340,3765,1,0.46],"当时":[1,327105,4965,1,0.9],"当时我完全不知道发生了什么。":[1,332070,15525,1],"当时我觉得这个计划可能不会成功。":[1,347595,18405,1],"很多人不支持这个计划，有的人甚至非常反对。":[1,366000,24885,1],"成功":[1,390885,4725,1],"我七点就出发了，结果还是迟到了。":[1,395610,19605,1,0.91],"我们每个人都应该保护环境。":[1,415215,14325,1],"我们的计划完全成功了！":[1,429540,11925,1],"我保证下次不会再迟到了。":[1,441465,13965,1],"我同意你说的一部分，可是不完全同意。":[1,455430,20925,1,0.91],"我的手机掉进水里了。":[1,476355,11205,1,0.94],"我给你发了消息，你看到了吗？":[1,487560,16245,1],"我给每个同事都发了一份调查表，一共有四十个人回答了，其中三十个人支持这个计划，可是也有一部分人不想去。":[1,503805,58485,1],"我肯定他今天不会来了。":[1,562290,12165,1],"我问他们原因，有的人说周末要陪孩子，有的人甚至说连周末都要加班，实在没有时间。":[1,574455,46845,1],"拉":[1,621300,4125,1,0.44],"接受":[1,625425,4845,1,0.88],"支持":[1,630270,4965,1,0.89],"改变":[1,635235,4725,1],"方法":[1,639960,4965,1,0.74],"有的":[1,644925,4605,1,0.93],"有问题可以直接给我打电话。":[1,649530,13965,1],"流行":[1,663495,5085,1,0.77],"消息":[1,668580,5085,1],"甚至":[1,673665,5085,1,0.89],"看来你真正有组织能力！”":[1,678750,12165,1],"真正":[1,690915,4845,1,0.79],"真正的朋友会在你困难的时候支持你。":[1,695760,18525,1],"经理听到这个消息以后非常高兴，他说：“只要方法对，问题就能解决。":[1,714285,40005,1,0.97],"结果":[1,754290,4845,1,0.8],"结果，几乎所有的人都接受了这个新计划。":[1,759135,23325,1,0.93],"老人":[1,782460,4485,1],"肯定":[1,786945,4485,1],"能力":[1,791430,4365,1],"计划":[1,795795,4605,1,0.8],"调查":[1,800400,4485,1,0.83],"这个游戏很流行，甚至连老人都在玩。":[1,804885,21045,1],"这个问题太简单了，连孩子都会。":[1,825930,18405,1,0.95],"这份工作对能力的要求很高。":[1,844335,15765,1],"这次失败的原因是什么？":[1,860100,12525,1,0.95],"这次旅游改变了我的生活。":[1,872625,13005,1,0.93],"这次调查一共问了五十个人，其中一半是学生。":[1,885630,24765,1],"邀请":[1,910395,5085,1,0.95],"部分":[1,915480,4365,1,0.88],"上个星期六，我第一次参加了学校组织的献血活动。":[2,0,28125,1],"也许":[2,28125,4845,1,0.94],"也许他已经回家了。":[2,32970,10845,1],"五千":[2,43815,4605,1],"交":[2,48420,3165,1,0.5],"今天天气挺好的，我们出去走走吧。":[2,51585,20085,1],"他一直坚持锻炼，因此身体很健康。":[2,71670,21165,1,0.95],"他今天看起来很有精神。":[2,92835,13485,1],"他好像不太舒服，我们送他回家吧。":[2,106320,19965,1],"他高兴得好像一个孩子一样。":[2,126285,14445,1],"代表":[2,140730,4485,1,0.97],"任务":[2,145215,4605,1,0.96],"你刚才说的“他”是指谁？":[2,149820,18405,1,0.97],"你到底去不去？快决定吧！":[2,168225,15645,1],"你到底想不想去？":[2,183870,9645,1],"你好好考虑一下，明天再告诉我。":[2,193515,19605,1],"使用":[2,213120,4605,1],"健康和生命比钱更重要。":[2,217725,13965,1],"免费":[2,231690,4965,1,0.96],"全部":[2,236655,4965,1,0.75],"刚刚":[2,241620,4485,1],"到了北京以后，记得跟我联系。":[2,246105,17565,1],"到底":[2,263670,4365,1],"医生先给我做了检查，告诉我一切正常，另外还提醒我前一天晚上要好好休息。":[2,268035,40245,1],"另外":[2,308280,4605,1],"另外，我还想说一件事情。":[2,312885,16725,1],"台":[2,329610,3165,1,0.41],"听了这句话，我心里特别激动。":[2,332775,17925,1],"因此":[2,350700,4965,1,0.87],"因此，我决定以后每年都坚持献血。":[2,355665,20565,1,0.86],"在学习方面，他一直很努力。":[2,376230,17205,1],"坚持":[2,393435,5085,1,0.91],"她代表我们班参加了比赛。":[2,398520,14085,1],"她获得了一个去中国留学的机会。":[2,412605,17085,1],"好像要下雨了。":[2,429690,9045,1],"学习汉语要坚持，不能放弃。":[2,438735,18045,1],"学校为我们提供了免费的水和面包。":[2,456780,17085,1],"感谢":[2,473865,4845,1],"感谢大家对我的支持和帮助！":[2,478710,14925,1],"我们永远是好朋友。":[2,493635,10485,1],"我刚刚参加了一个帮助老人的活动。":[2,504120,17205,1,0.94],"我想找一份周末的工作。":[2,521325,12285,1],"我把全部的钱都给了他。":[2,533610,12045,1],"我每年都去医院献血。":[2,545655,11205,1],"我算了算，这次旅游一共花了五千块。":[2,556860,19845,1],"护士说，我的血也许能帮助一个病人留住生命。":[2,576705,25725,1],"指":[2,602430,4485,1,0.33],"按时":[2,606915,5565,1],"提供":[2,612480,4605,1,0.97],"放弃":[2,617085,5205,1,0.93],"方面":[2,622290,4845,1,0.87],"正常":[2,627135,5085,1,0.79],"毕业以后，她决定留在北京工作。":[2,632220,19365,1],"永远":[2,651585,4005,1,0.84],"活动":[2,655590,4725,1,0.73],"活动结束以后，学校还给每位同学提供了一份小礼物，校长代表病人和他们的家人感谢我们。":[2,660315,47565,1],"献":[2,707880,3165,1,0.46],"献血的时候，我好像一点儿也没觉得疼，十分钟左右就结束了。":[2,711045,33645,1],"生命":[2,744690,4965,1,0.96],"留学":[2,749655,4965,1,0.86],"精神":[2,754620,4965,1,0.78],"考虑":[2,759585,4845,1,0.85],"联系":[2,764430,4965,1,0.89],"获得":[2,769395,4125,1,0.83],"血":[2,773520,3045,1,0.41],"说实话，我一开始挺害怕的，因为我从来没献过血。":[2,776565,30165,1,0.9],"请在星期五以前把作业交给老师。":[2,806730,17565,1],"这个任务很重要，你一定要按时完成。":[2,824295,20445,1],"这个方法很简单，因此很多人都在使用。":[2,844740,22125,1],"这件事情到底是谁做的？":[2,866865,13125,1],"这台电脑我已经使用了五年了。":[2,879990,14925,1],"这次活动很成功，因此我们下次还会举行。":[2,894915,23325,1],"这次经历让我明白：帮助别人不只是一个任务，更是一种精神。":[2,918240,33165,1,0.94],"这种情况很正常，你别担心。":[2,951405,17685,1,0.94],"一家人在一起就是最大的幸福。":[3,0,16365,1],"不管":[3,16365,4365,1,0.79],"不管多忙，父亲都会给我打电话。":[3,20730,18645,1],"不管天气怎么样，他都去公园跑步。":[3,39375,19245,1],"不管是周末还是节日，只要有新闻，他都会马上出发。":[3,58620,30165,1],"不管遇到什么困难，他都不放弃。":[3,88785,18285,1],"专业":[3,107070,4845,1,0.95],"两千":[3,111915,4845,1],"严重":[3,116760,4845,1,0.73],"交通":[3,121605,4845,1,0.9],"交通问题越来越严重了。":[3,126450,12885,1],"从这里一直往东走，就到银行了。":[3,139335,18885,1,0.95],"他光说不做，大家都不太相信他。":[3,158220,19365,1,0.93],"他受到了老师的表扬。":[3,177585,11925,1],"他很聪明，并且非常努力。":[3,189510,16365,1],"他的专业是法律。":[3,205875,10005,1],"他确实是一个好记者。":[3,215880,11565,1],"他首先了解了发生了什么，然后跟附近的人谈话，最后他一晚上没睡觉，写出了一篇报道。":[3,227445,47565,1],"会议的时间已经安排好了。":[3,275010,13365,1],"你收到我寄的礼物了吗？":[3,288375,11205,1],"你能解释一下这个词语的意思吗？":[3,299580,15885,1],"你能证明这件事情是他做的吗？":[3,315465,15885,1],"写错了没关系，你可以重新写一遍。":[3,331350,19725,1],"出差":[3,351075,4965,1,0.96],"包括":[3,356040,4845,1,0.9],"原来":[3,360885,4485,1,0.78],"原来你也认识他呀！":[3,365370,10005,1,0.86],"原来是你！我还以为是谁呢。":[3,375375,16845,1,0.97],"原来，他的工作确实很重要！":[3,392220,17445,1,0.84],"参加会议的一共有十个人，包括我在内。":[3,409665,21525,1],"发展":[3,431190,5085,1,0.85],"受到":[3,436275,4965,1,0.8],"后来":[3,441240,4845,1],"后来，楼里的人都被重新安排了住的地方。":[3,446085,22605,1],"复杂":[3,468690,4725,1,0.76],"安排":[3,473415,5445,1,0.91],"寄":[3,478860,2925,1,0.36],"小时候，我常常不理解他：为什么他总是那么忙？":[3,481785,28125,1],"并且":[3,509910,4725,1,0.77],"幸福":[3,514635,5205,1,0.93],"底":[3,519840,4605,1,0.38],"座":[3,524445,2925,1,0.39],"心情":[3,527370,5205,1,0.78],"我们谈谈你的工作吧。":[3,532575,12765,1,0.81],"我原来在银行工作，后来当了老师。":[3,545340,19725,1],"我父亲当了三十年记者。":[3,565065,12645,1,0.85],"我的梦是像父亲一样，用自己的文章让社会变得更好。":[3,577710,27765,1],"我的父亲是一名记者，已经工作了二十多年。":[3,605475,22605,1],"我能理解你现在的心情。":[3,628080,12405,1],"技术":[3,640485,4845,1,0.89],"报道":[3,645330,4365,1],"昨天晚上我做了一个奇怪的梦。":[3,649695,14685,1,0.92],"有一次，城里一座老楼着火了，情况非常严重。":[3,664380,31845,1],"法律":[3,696225,4965,1],"父亲":[3,701190,4845,1],"父亲告诉我，记者的责任就是让大家知道真实的情况。":[3,706035,29925,1],"父亲是第一个到那里的记者。":[3,735960,14205,1],"现在我也上了大学，选择了新闻专业。":[3,750165,20925,1],"现在的手机技术越来越好了。":[3,771090,15885,1],"理解":[3,786975,4725,1,0.96],"确实":[3,791700,5085,1,0.82],"社会":[3,796785,4965,1],"答案":[3,801750,3885,1,0.95],"至少":[3,805635,4845,1,0.87],"表扬":[3,810480,4485,1,0.93],"解释":[3,814965,4965,1,0.8],"记者":[3,819930,4725,1,0.75],"证明":[3,824655,4845,1,0.83],"负责":[3,829500,4005,1,0.81],"这个月底我要去北京出差。":[3,833505,13725,1],"这件事情由我来负责。":[3,847230,11445,1,0.9],"这几年，这座城市发展得很快。":[3,858675,19605,1,0.9],"这是一个很复杂的社会问题。":[3,878280,15165,1],"这条新闻是他报道的。":[3,893445,12285,1],"这篇报道受到了很多人的注意，大家开始讨论老房子的安全问题。":[3,905730,33525,1],"这篇报道至少要写两千字。":[3,939255,14805,1],"遍":[3,954060,3765,1,0.34],"重新":[3,957825,4725,1],"首先":[3,962550,4965,1],"首先我们要了解情况，然后再做决定。":[3,967515,21405,1,0.9],"首先认真读题，然后再写答案。":[3,988920,18765,1],"首先，我们要了解清楚情况。":[3,1007685,17445,1],"仍然":[4,0,4485,1,0.72],"他嘴上说没关系，其实很生气。":[4,4485,19365,1],"他这个月的工资超过了一万块。":[4,23850,14805,1],"你可以试一下这件衣服。":[4,38655,12405,1],"值得":[4,51060,3885,1,0.86],"假":[4,54945,3765,1,0.62],"别紧张，你慢慢说。":[4,58710,13965,1],"千万":[4,72675,4845,1,0.89],"即使":[4,77520,4965,1,0.89],"即使失败了，这也是一次很好的经历。":[4,82485,20805,1],"即使很累，她也不想放弃。":[4,103290,16725,1,0.83],"即使明天下雨，比赛也会继续进行。":[4,120015,20325,1],"压力":[4,140340,4845,1],"去年，我报名参加了学校的汉语比赛，要在台上用汉语讲五分钟。":[4,145185,36405,1],"各":[4,181590,3765,1,0.42],"各位观众，晚上好！":[4,185355,13725,1],"后来，我们再也没有联系过。":[4,199080,16005,1],"后来，我请老师和同学给我提意见，大家一起讨论怎么把我的话讲得更自然。":[4,215085,41445,1],"听了她的话，我觉得轻松了许多。":[4,256530,17685,1,0.92],"地址":[4,274215,4485,1,0.7],"坐地铁上班可以省很多时间。":[4,278700,15285,1],"大家对这个计划有什么意见？":[4,293985,15045,1],"学习的过程比结果更重要。":[4,309030,14685,1],"尽管":[4,323715,4725,1,0.7],"尽管他很努力，可是成绩仍然不太好。":[4,328440,21885,1],"尽管压力很大，他仍然没有放弃。":[4,350325,19005,1],"尽管天气很冷，可是大家都玩得很高兴。":[4,369330,21285,1],"尽管我紧张得一直出汗，我仍然顺利地讲完了。":[4,390615,22845,1,0.96],"工资":[4,413460,4725,1],"弄":[4,418185,3765,1,0.46],"意见":[4,421950,4605,1],"我们讨论了两个小时，还是没有结果。":[4,426555,20205,1],"我的电脑被弟弟弄坏了。":[4,446760,12165,1,0.85],"推迟":[4,458925,4845,1,0.9],"无论":[4,463770,4485,1,0.9],"无论你什么时候来，我都欢迎。":[4,468255,17205,1],"昨天的比赛我们赢了！":[4,485460,11085,1],"最后，我得了第二名。":[4,496545,16125,1],"最近工作压力很大，我经常觉得很累。":[4,512670,20805,1],"最重要的不是结果，而是准备的过程。”":[4,533475,20925,1,0.9],"母亲":[4,554400,5205,1],"母亲总是说，健康比什么都重要。":[4,559605,18885,1],"母亲看出了我的心情，对我说：“即使不能赢，这也是一次值得的经历。":[4,578490,39765,1],"比赛前一个月，我每天都在准备，压力特别大。":[4,618255,26685,1],"比赛那天，台下坐满了人。":[4,644940,16005,1],"深":[4,660945,3285,1,0.49],"由于":[4,664230,4845,1,0.75],"由于天气不好，比赛推迟了。":[4,669075,17445,1,0.66],"由于天气原因，航班推迟了。":[4,686520,17205,1],"由于太紧张，我有好几次都想放弃。":[4,703725,19485,1,0.88],"由于时间关系，我就不多说了。":[4,723210,17565,1],"省":[4,740775,4725,1,0.49],"紧张":[4,745500,5205,1,0.91],"经历":[4,750705,4845,1,0.93],"美丽":[4,755550,4605,1],"自然":[4,760155,4365,1,0.79],"航班":[4,764520,5085,1],"观众":[4,769605,4605,1],"讨论":[4,774210,4605,1],"许多":[4,778815,4845,1],"许多人都经历过失败。":[4,783660,11925,1],"试":[4,795585,3045,1,0.39],"说明":[4,798630,4965,1],"请把你的地址写在这里。":[4,803595,12525,1],"责任":[4,816120,4725,1,0.8],"赢":[4,820845,3765,1,0.49],"超过":[4,824610,4845,1,0.92],"过程":[4,829455,4605,1,0.71],"这个包是假的，你被骗了。":[4,834060,15765,1],"这个地方很值得去看看。":[4,849825,12765,1,0.94],"这个结果说明我们的方法是对的。":[4,862590,16365,1],"这是我的责任，我不能放弃。":[4,878955,16845,1,0.88],"这条河很深，千万别在这里游泳。":[4,895800,18765,1,0.95],"这次经历说明，无论做什么，只要不放弃，就会有好的结果。":[4,914565,34365,1,0.92],"这里的自然风景非常美丽。":[4,948930,13845,1],"风景":[4,962775,5085,1,0.81],"饭馆里坐满了人。":[4,967860,9645,1,0.97],"一群孩子在公园里玩。":[5,0,12045,1],"上大学以前，我遇到了一个很大的困难：选什么专业？":[5,12045,29205,1],"上课":[5,41250,5205,1],"下大雪了，于是我们决定在家休息。":[5,46455,20325,1],"下雨了，于是我们就在家看电影。":[5,66780,20205,1],"主意":[5,86985,7365,1,0.91],"于是":[5,94350,4725,1,0.89],"于是，我决定跟父母好好谈一谈。":[5,99075,20205,1],"从来":[5,119280,4845,1],"他从来不抽烟。":[5,124125,9045,1],"他从来没迟到过。":[5,133170,9285,1,0.94],"他们希望我学管理或者经济，因为市场上需要这方面的人，工作条件也比较好。":[5,142455,40365,1],"他把照片挂在墙上了。":[5,182820,12285,1],"他觉得这个专业很适合自己，于是就选择了它。":[5,195105,25845,1],"你的回答完全正确。":[5,220950,11205,1],"你的房间太乱了，快收拾一下。":[5,232155,18165,1],"关键":[5,250320,4725,1,0.83],"十分":[5,255045,4845,1],"危险":[5,259890,4965,1,0.79],"后来，我的老师对我说：“选专业最关键的是找到适合自己的方向。":[5,264855,36165,1],"周末我要陪妈妈去买东西。":[5,301020,13965,1,0.97],"学习上遇到困难，可以找老师帮忙。":[5,314985,20805,1],"学校规定，上课的时候不能玩手机。":[5,335790,20565,1],"小心，别让孩子玩火。":[5,356355,19125,1],"市场":[5,375480,5325,1],"广告":[5,380805,4365,1,0.81],"引起":[5,385170,4965,1],"我下个月正式开始上班。":[5,390135,13005,1],"我从来没去过那个地方。":[5,403140,12405,1,0.84],"我们为这件事吵了好几次。":[5,415545,13485,1],"我去银行取钱，你等我一下。":[5,429030,16965,1],"我告诉他们，我从来没有这么认真地考虑过一件事。":[5,445995,25845,1],"我本来对艺术很有兴趣，想学画画，可是父母觉得这个专业不好找工作。":[5,471840,44685,1],"我本来打算读法律，后来改变了主意。":[5,516525,20445,1],"我觉得这份工作不太适合我。":[5,536970,15765,1],"我还不清楚自己以后的方向。":[5,552735,14565,1],"抽烟":[5,567300,4845,1],"收拾":[5,572145,4365,1,0.85],"教育":[5,576510,4725,1],"教育孩子需要很多耐心。":[5,581235,12525,1,0.95],"方向":[5,593760,5085,1],"最后，他们同意了。":[5,598845,13365,1],"本来":[5,612210,4125,1],"条件":[5,616335,4965,1],"样子":[5,621300,4845,1],"正式":[5,626145,4965,1,0.93],"正确":[5,631110,5085,1],"爱情":[5,636195,4965,1,0.75],"现在我已经正式成为艺术专业的学生，虽然学习很辛苦，但是我十分快乐。":[5,641160,40125,1],"现在电视上的广告太多了。":[5,681285,14925,1,0.91],"看他的样子，好像很累。":[5,696210,15285,1,0.89],"管理":[5,711495,4365,1,0.78],"约会":[5,715860,4725,1,0.91],"群":[5,720585,4245,1,0.52],"耐心":[5,724830,4845,1],"规定":[5,729675,4485,1,0.76],"警察":[5,734160,5205,1],"这个地方十分安静。":[5,739365,10605,1,0.86],"这个工作条件不错，工资也挺高。":[5,749970,18645,1,0.96],"这个广告引起了很多人的注意。":[5,768615,15765,1],"这个电影讲的是一个爱情故事。":[5,784380,15405,1],"这家公司管理得很好。":[5,799785,11685,1],"这种手机在市场上卖得很好。":[5,811470,15285,1,0.82],"适合":[5,826755,5085,1,0.73],"选择专业的时候，兴趣是最关键的。":[5,831840,20205,1],"遇到危险的时候，要马上给警察打电话。":[5,852045,25605,1],"钱够不够？不够我这里还有。":[5,877650,16125,1,0.94],"难道":[5,893775,4605,1,0.93],"难道你不知道他要结婚了吗？":[5,898380,14685,1],"难道你不知道这件事情吗？":[5,913065,13725,1],"难道你忘记了我们的约会吗？":[5,926790,13605,1],"难道你愿意每天做自己不喜欢的事情吗？”":[5,940395,18765,1],"三年以后，他拍出了自己的第一个电影。":[6,0,21885,1],"中文":[6,21885,4485,1,0.97],"丰富":[6,26370,4965,1,0.85],"为了省钱，他租了一个很小的房间，每天学习到很晚。":[6,31335,29685,1],"于是，他决定放弃律师工作，去学拍电影。":[6,61020,27285,1],"今天天气很好，我的心情也很好。":[6,88305,19605,1],"他们俩的感情一直很好。":[6,107910,12405,1,0.93],"他只学习了半年汉语，竟然能看中文小说了。":[6,120315,24045,1],"他是一位很有经验的律师。":[6,144360,13365,1],"他的工资是我的三倍。":[6,157725,10845,1],"他的工资是我的两倍。":[6,168570,10845,1],"他的普通话很标准。":[6,179415,11205,1],"他的父母和朋友几乎都反对，觉得他的想法太奇怪了。":[6,190620,28005,1],"他真正喜欢的是电影。":[6,218625,11805,1],"他竟然忘记了自己的生日。":[6,230430,13245,1],"他走路的速度很快。":[6,243675,10845,1,0.85],"你学习汉语的目的是什么？":[6,254520,13365,1,0.95],"你想选择什么职业？":[6,267885,10605,1],"俩":[6,278490,4725,1,0.58],"倍":[6,283215,3765,1,0.39],"公司通知我们明天上午开会。":[6,286980,14805,1],"内容":[6,301785,4605,1],"可是工作了五年以后，他发现自己每天早上醒来心情都很差。":[6,306390,30525,1],"国际":[6,336915,4725,1,0.8],"她穿着一条美丽的裙子。":[6,341640,12645,1],"妈妈抱着孩子在门口等我。":[6,354285,15405,1],"实在":[6,369690,4845,1,0.9],"小林却说：“生命只有一次，我不想后悔。”":[6,374535,24645,1],"小说":[6,399180,4965,1],"开会":[6,404145,4605,1,0.96],"当地":[6,408750,4485,1,0.93],"很多人反对这个计划。":[6,413235,11685,1],"律师":[6,424920,4965,1,0.83],"感情":[6,429885,4725,1],"我今天早上六点就醒了。":[6,434610,12885,1,0.74],"我们会按照计划完成任务。":[6,447495,13605,1],"我实在吃不下了。":[6,461100,10125,1,0.88],"我的朋友小林大学毕业以后成了一名律师。":[6,471225,19965,1],"我的鞋破了，要买一双新的。":[6,491190,16725,1],"抱":[6,507915,3765,1,0.5],"按照":[6,511680,4965,1,0.82],"效果":[6,516645,4965,1,0.81],"昨天的演出太精彩了！":[6,521610,12285,1,0.96],"标准":[6,533895,4845,1,0.81],"演出":[6,538740,4965,1],"演出结束以后，观众都站起来鼓掌。":[6,543705,20085,1],"现在小林常说：“以前的律师经验让我更懂得怎么讲故事。”":[6,563790,29325,1],"用刀的时候要小心。":[6,593115,11205,1,0.88],"电影讲的是一家人的感情故事，内容很简单，效果却特别好，观众都说非常精彩。":[6,604320,45045,1],"目的":[6,649365,3765,1,0.84],"科学":[6,653130,4965,1,0.88],"科学技术的发展改变了我们的生活。":[6,658095,18525,1],"竟然":[6,676620,4605,1,0.93],"精彩":[6,681225,4845,1],"经济":[6,686070,5085,1,0.96],"经验":[6,691155,4725,1,0.94],"职业":[6,695880,4485,1,0.76],"范围":[6,700365,4965,1],"让大家没想到的是，这个电影竟然在一个国际电影节上得了奖！":[6,705330,30765,1],"请按照老师的要求去做。":[6,736095,12885,1],"请按照规定的时间交作业。":[6,748980,14805,1],"这个房间比那个大一倍。":[6,763785,12045,1],"这个门要推，不要拉。":[6,775830,12645,1],"这个问题，一个孩子竟然回答对了。":[6,788475,19245,1],"这几年，当地的经济发展得很快。":[6,807720,20205,1],"这是一份很多人羡慕的职业：收入高，工作环境也不错。":[6,827925,31845,1],"这是一场国际比赛，有二十多个国家参加。":[6,859770,22365,1,0.94],"这本书的内容非常丰富。":[6,882135,13125,1],"这本小说我看了三遍。":[6,895260,11565,1,0.93],"这次会议的重点是讨论工资问题。":[6,906825,16725,1],"这次考试的范围很大。":[6,923550,12045,1],"这种药的效果很好。":[6,935595,10845,1,0.88],"通知":[6,946440,4845,1],"速度":[6,951285,4845,1,0.86],"重点":[6,956130,4845,1,0.82],"鼓掌":[6,960975,4485,1,0.76],"上个月，一个著名的艺术团来我们城市演出，而且是免费的！":[7,0,34965,1],"不仅":[7,34965,4365,1,0.81],"不得不":[7,39330,5445,1,0.81],"不过，想看演出要先在网上申请，因为座位不多，竞争非常大。":[7,44775,37245,1],"世纪":[7,82020,4245,1,0.83],"他不仅会唱歌，而且还会跳舞。":[7,86265,18525,1],"他是一位著名的艺术家。":[7,104790,12165,1],"他被爸爸批评了一顿。":[7,116955,11685,1],"他跳舞的动作