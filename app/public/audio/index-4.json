{"files":["h4u01.mp3","h4u02.mp3","h4u03.mp3","h4u04.mp3","h4u05.mp3","h4u06.mp3","h4u07.mp3","h4u08.mp3","h4u09.mp3","h4u10.mp3","h4u11.mp3","h4u12.mp3","h4u13.mp3","h4u14.mp3","h4u15.mp3","h4u16.mp3","h4u17.mp3","h4u18.mp3","h4u19.mp3","h4u20.mp3"],"clips":{"一切":[0,0,4005,1],"不过":[0,4005,3765,1,0.89],"与":[0,7770,4125,1,0.42],"之":[0,11895,3165,1,0.39],"今天热死了，我们去喝点东西吧。":[0,15060,17805,1,0.97],"他以优秀的成绩毕业了。":[0,32865,11925,1],"他喜欢安静，而他妻子喜欢热闹。":[0,44790,17925,1],"他很努力，最后成为了一位有名的医生。":[0,62715,20565,1],"他很累，却不想休息。":[0,83280,14925,1,0.94],"他说他很好，不过我感觉他不太高兴。":[0,98205,20445,1],"任何":[0,118650,4245,1],"休息十分钟以后，会议继续进行。":[0,122895,18885,1],"优秀":[0,141780,4125,1,0.9],"你对新生活感觉怎么样？":[0,145905,11925,1],"内":[0,157830,3765,1,0.4],"刚来的时候，所有的事情对我来说都很新鲜，不过也有不少困难。":[0,161595,33885,1],"去年秋天，我离开家，来到北京工作。":[0,195480,22365,1],"发生":[0,217845,4245,1,0.92],"场":[0,222090,4965,1,0.58],"大家都来了，他却还没到。":[0,227055,15285,1],"天气突然冷起来了，你要多穿点衣服。":[0,242340,19965,1],"如果有任何问题，你可以直接问我。":[0,262305,19005,1],"妈妈常常打电话来问我的情况，让我一定要注意安全。":[0,281310,27165,1],"安全":[0,308475,4245,1],"对我来说，安全是最重要的。":[0,312720,16245,1],"对我来说，这是一次很好的机会。":[0,328965,17685,1,0.97],"对我来说，这里已经成为了我的第二个家。":[0,346650,19965,1],"当":[0,366615,4125,1,0.5],"当你感觉很累的时候，就好好休息吧。":[0,370740,19965,1],"当我到家的时候，孩子已经睡觉了。":[0,390705,19005,1],"当我来北京的时候，一个朋友也没有。":[0,409710,18525,1],"当我第一次一个人坐地铁的时候，我不知道应该在哪儿换车，最后在一位阿姨的帮助下才找到了公司。":[0,428235,47205,0],"情况":[0,475440,4125,1,0.92],"感觉":[0,479565,3765,1,0.94],"成为":[0,483330,4125,1],"我以前在北京住过两年。":[0,487455,11805,1],"我叫了他好几次，他却没回答。":[0,499260,17685,1],"我喜欢吃苹果、西瓜等水果。":[0,516945,17085,1,0.97],"我对中国历史很有兴趣。":[0,534030,12765,1],"我没有放弃，而是继续努力工作，周末去参加各种活动，认识了很多新朋友。":[0,546795,41325,1],"我的生活发生了很大的变化，一切都越来越好。":[0,588120,24765,1],"所有":[0,612885,4125,1,0.89],"所有的同学都通过了考试。":[0,617010,13725,1],"无":[0,630735,3045,1,0.36],"昨天那场比赛你看了吗？":[0,633780,11925,1],"最后":[0,645705,4125,1,0.93],"最近情况怎么样？一切都好吗？":[0,649830,17205,1],"来北京以后，我的生活发生了很大的变化。":[0,667035,22725,1],"毕业":[0,689760,3525,1,0.9],"热闹":[0,693285,3885,1,0.92],"现在，我已经通过了公司的考试，成为了正式员工。":[0,697170,27885,1],"生活":[0,725055,4365,1,0.97],"由":[0,729420,3045,1,0.43],"直接":[0,732465,4125,1,0.95],"组织":[0,736590,4245,1],"继续":[0,740835,4125,1,0.97],"而":[0,744960,3045,1,0.37],"虽然北京的冬天冷死了，我却越来越喜欢这座城市。":[0,748005,26205,1],"行":[0,774210,3405,1,0.54],"行，没问题，我明天去。":[0,777615,17805,1,0.97],"请在一个星期内完成作业。":[0,795420,13125,1],"起来":[0,808545,3765,1,0.9],"这件事情与他没有关系。":[0,812310,11685,1],"这位老师对学生非常好。":[0,823995,12405,1],"这是我最喜欢的城市之一。":[0,836400,13125,1],"这条路晚上几乎无人，不太安全。":[0,849525,18765,1],"这次比赛由我们学校组织。":[0,868290,13005,1],"进行":[0,881295,4365,1,0.91],"通过":[0,885660,4005,1,0.94],"那时候我常常感觉很孤单，晚上回到家，房间里安静得让人难过。":[0,889665,34845,0],"上个月，我们公司计划组织一次周末旅游。":[1,0,23085,1],"为了了解大家的想法，经理让我做一个调查。":[1,23085,22005,1],"五十":[1,45090,4125,1,0.95],"他工作很忙，周末甚至也要上班。":[1,49215,18885,1],"他很高兴地接受了我们的邀请。":[1,68100,15285,0],"他忙得连周末都不休息。":[1,83385,12045,1],"他连我的名字都忘记了。":[1,95430,11805,1],"份":[1,107235,3885,1,0.47],"你在干什么呢？":[1,111120,7485,1],"你怎么才来呀？大家都在等你。":[1,118605,16965,1],"你拉我一下，我站不起来了。":[1,135570,15645,1],"保护":[1,151215,4125,1],"保证":[1,155340,4125,1,0.94],"公司每年都组织大家去旅游。":[1,159465,14085,1],"其中":[1,173550,4005,1,0.97],"出发":[1,177555,4005,0],"原因":[1,181560,4005,1,0.95],"反对":[1,185565,4125,1,0.91],"发":[1,189690,4125,1,0.62],"只要你努力，就一定能成功。":[1,193815,15765,1],"只要方法对，学习汉语就不难。":[1,209580,17685,1],"只要有时间，我就去锻炼。":[1,227265,15045,1,0.97],"可是":[1,242310,4245,1],"后来我改变了方法：活动不在周末，而改在星期五下午，并且大家可以带家人一起来。":[1,246555,44925,1],"呀":[1,291480,3045,1],"困难":[1,294525,3765,1,0.97],"失败":[1,298290,4125,1],"完全":[1,302415,4365,1],"干":[1,306780,3765,1,0.51],"当时":[1,310545,4245,1,0.94],"当时我完全不知道发生了什么。":[1,314790,14805,1],"当时我觉得这个计划可能不会成功。":[1,329595,17685,1],"很多人不支持这个计划，有的人甚至非常反对。":[1,347280,24165,1],"成功":[1,371445,4005,1,0.95],"我七点就出发了，结果还是迟到了。":[1,375450,18885,1,0.95],"我们每个人都应该保护环境。":[1,394335,13605,1],"我们的计划完全成功了！":[1,407940,11205,1],"我保证下次不会再迟到了。":[1,419145,13245,1],"我同意你说的一部分，可是不完全同意。":[1,432390,20925,1],"我的手机掉进水里了。":[1,453315,10485,1],"我给你发了消息，你看到了吗？":[1,463800,15525,1],"我给每个同事都发了一份调查表，一共有四十个人回答了，其中三十个人支持这个计划，可是也有一部分人不想去。":[1,479325,57765,1],"我肯定他今天不会来了。":[1,537090,11445,1],"我问他们原因，有的人说周末要陪孩子，有的人甚至说连周末都要加班，实在没有时间。":[1,548535,46125,1],"拉":[1,594660,4125,1,0.48],"接受":[1,598785,4125,1,0.92],"支持":[1,602910,4245,1],"改变":[1,607155,4005,1,0.94],"方法":[1,611160,4245,0,0.89],"有的":[1,615405,3885,1,0.96],"有问题可以直接给我打电话。":[1,619290,13245,1],"流行":[1,632535,4365,1,0.87],"消息":[1,636900,4365,1,0.93],"甚至":[1,641265,4365,1,0.95],"看来你真正有组织能力！”":[1,645630,11445,1],"真正":[1,657075,4125,1,0.88],"真正的朋友会在你困难的时候支持你。":[1,661200,17805,1],"经理听到这个消息以后非常高兴，他说：“只要方法对，问题就能解决。":[1,679005,40005,1],"结果":[1,719010,4125,1,0.84],"结果，几乎所有的人都接受了这个新计划。":[1,723135,22605,1],"老人":[1,745740,3765,1],"肯定":[1,749505,3765,1,0.95],"能力":[1,753270,3645,1,0.95],"计划":[1,756915,3885,1,0.92],"调查":[1,760800,4485,1,0.91],"这个游戏很流行，甚至连老人都在玩。":[1,765285,20325,1],"这个问题太简单了，连孩子都会。":[1,785610,17685,1],"这份工作对能力的要求很高。":[1,803295,15045,1],"这次失败的原因是什么？":[1,818340,11805,1],"这次旅游改变了我的生活。":[1,830145,12285,1],"这次调查一共问了五十个人，其中一半是学生。":[1,842430,24045,1],"邀请":[1,866475,4365,1,0.96],"部分":[1,870840,3645,1,0.88],"上个星期六，我第一次参加了学校组织的献血活动。":[2,0,27405,1],"也许":[2,27405,4125,1,0.94],"也许他已经回家了。":[2,31530,10125,1],"五千":[2,41655,3885,1],"交":[2,45540,3165,1,0.54],"今天天气挺好的，我们出去走走吧。":[2,48705,19365,1],"他一直坚持锻炼，因此身体很健康。":[2,68070,20445,1],"他今天看起来很有精神。":[2,88515,12765,1],"他好像不太舒服，我们送他回家吧。":[2,101280,19245,1],"他高兴得好像一个孩子一样。":[2,120525,13725,1],"代表":[2,134250,3765,1],"任务":[2,138015,3885,1],"你刚才说的“他”是指谁？":[2,141900,17085,0],"你到底去不去？快决定吧！":[2,158985,14925,1,0.97],"你到底想不想去？":[2,173910,8925,1],"你好好考虑一下，明天再告诉我。":[2,182835,18885,1],"使用":[2,201720,3885,1,0.93],"健康和生命比钱更重要。":[2,205605,13245,1],"免费":[2,218850,4245,1],"全部":[2,223095,4245,1,0.92],"刚刚":[2,227340,3765,1,0.96],"到了北京以后，记得跟我联系。":[2,231105,16845,1],"到底":[2,247950,3645,1,0.93],"医生先给我做了检查，告诉我一切正常，另外还提醒我前一天晚上要好好休息。":[2,251595,39525,1],"另外":[2,291120,3885,1],"另外，我还想说一件事情。":[2,295005,16005,1],"台":[2,311010,3165,1,0.45],"听了这句话，我心里特别激动。":[2,314175,17205,1],"因此":[2,331380,4245,1],"因此，我决定以后每年都坚持献血。":[2,335625,19845,1],"在学习方面，他一直很努力。":[2,355470,16485,1],"坚持":[2,371955,4365,1,0.97],"她代表我们班参加了比赛。":[2,376320,13365,1],"她获得了一个去中国留学的机会。":[2,389685,16365,1],"好像要下雨了。":[2,406050,8325,1],"学习汉语要坚持，不能放弃。":[2,414375,17325,1],"学校为我们提供了免费的水和面包。":[2,431700,16365,1],"感谢":[2,448065,4125,1,0.94],"感谢大家对我的支持和帮助！":[2,452190,14205,1],"我们永远是好朋友。":[2,466395,10485,1],"我刚刚参加了一个帮助老人的活动。":[2,476880,16485,1],"我想找一份周末的工作。":[2,493365,11565,1],"我把全部的钱都给了他。":[2,504930,11325,1],"我每年都去医院献血。":[2,516255,10485,1],"我算了算，这次旅游一共花了五千块。":[2,526740,19125,1],"护士说，我的血也许能帮助一个病人留住生命。":[2,545865,25005,1],"指":[2,570870,4485,1,0.36],"按时":[2,575355,4245,0],"提供":[2,579600,3885,1,0.9],"放弃":[2,583485,4485,1,0.88],"方面":[2,587970,4125,1,0.9],"正常":[2,592095,4365,1],"毕业以后，她决定留在北京工作。":[2,596460,18645,1],"永远":[2,615105,4005,1,0.92],"活动":[2,619110,4005,1,0.86],"活动结束以后，学校还给每位同学提供了一份小礼物，校长代表病人和他们的家人感谢我们。":[2,623115,46845,1],"献":[2,669960,3165,1,0.5],"献血的时候，我好像一点儿也没觉得疼，十分钟左右就结束了。":[2,673125,32925,0],"生命":[2,706050,4245,1,0.95],"留学":[2,710295,4245,1,0.88],"精神":[2,714540,4245,1],"考虑":[2,718785,4125,1],"联系":[2,722910,4245,1,0.93],"获得":[2,727155,4125,1,0.91],"血":[2,731280,3045,1,0.44],"说实话，我一开始挺害怕的，因为我从来没献过血。":[2,734325,29445,1],"请在星期五以前把作业交给老师。":[2,763770,16845,1],"这个任务很重要，你一定要按时完成。":[2,780615,19725,1],"这个方法很简单，因此很多人都在使用。":[2,800340,21405,1],"这件事情到底是谁做的？":[2,821745,12405,1],"这台电脑我已经使用了五年了。":[2,834150,14205,1],"这次活动很成功，因此我们下次还会举行。":[2,848355,22605,1],"这次经历让我明白：帮助别人不只是一个任务，更是一种精神。":[2,870960,33165,1],"这种情况很正常，你别担心。":[2,904125,16965,1],"一家人在一起就是最大的幸福。":[3,0,15645,1],"不管":[3,15645,3645,1,0.85],"不管多忙，父亲都会给我打电话。":[3,19290,17925,1,0.95],"不管天气怎么样，他都去公园跑步。":[3,37215,18525,1],"不管是周末还是节日，只要有新闻，他都会马上出发。":[3,55740,29445,1],"不管遇到什么困难，他都不放弃。":[3,85185,17565,1,0.96],"专业":[3,102750,4125,1,0.92],"两千":[3,106875,4125,0],"严重":[3,111000,4125,1,0.91],"交通":[3,115125,4125,1],"交通问题越来越严重了。":[3,119250,12165,1],"从这里一直往东走，就到银行了。":[3,131415,18165,1],"他光说不做，大家都不太相信他。":[3,149580,18645,1],"他受到了老师的表扬。":[3,168225,11205,1],"他很聪明，并且非常努力。":[3,179430,15645,1],"他的专业是法律。":[3,195075,9285,1],"他确实是一个好记者。":[3,204360,10845,1],"他首先了解了发生了什么，然后跟附近的人谈话，最后他一晚上没睡觉，写出了一篇报道。":[3,215205,46845,1],"会议的时间已经安排好了。":[3,262050,12645,1],"你收到我寄的礼物了吗？":[3,274695,10485,1],"你能解释一下这个词语的意思吗？":[3,285180,15165,1],"你能证明这件事情是他做的吗？":[3,300345,15165,1],"写错了没关系，你可以重新写一遍。":[3,315510,19005,1],"出差":[3,334515,4245,1],"包括":[3,338760,4125,1,0.95],"原来":[3,342885,3765,1,0.89],"原来你也认识他呀！":[3,346650,9285,1],"原来是你！我还以为是谁呢。":[3,355935,16125,1],"原来，他的工作确实很重要！":[3,372060,16725,1,0.96],"参加会议的一共有十个人，包括我在内。":[3,388785,20805,1],"发展":[3,409590,4365,1],"受到":[3,413955,4245,1,0.93],"后来":[3,418200,4125,1],"后来，楼里的人都被重新安排了住的地方。":[3,422325,21885,0],"复杂":[3,444210,4005,1,0.9],"安排":[3,448215,4245,0],"寄":[3,452460,2925,1,0.39],"小时候，我常常不理解他：为什么他总是那么忙？":[3,455385,27405,1],"并且":[3,482790,4005,1,0.91],"幸福":[3,486795,4485,1,0.97],"底":[3,491280,4605,1,0.42],"座":[3,495885,2925,1,0.42],"心情":[3,498810,4485,1],"我们谈谈你的工作吧。":[3,503295,10365,0],"我原来在银行工作，后来当了老师。":[3,513660,19005,1],"我父亲当了三十年记者。":[3,532665,11925,1],"我的梦是像父亲一样，用自己的文章让社会变得更好。":[3,544590,27045,1],"我的父亲是一名记者，已经工作了二十多年。":[3,571635,21885,1],"我能理解你现在的心情。":[3,593520,11685,1],"技术":[3,605205,4125,1,0.91],"报道":[3,609330,3645,1,0.91],"昨天晚上我做了一个奇怪的梦。":[3,612975,13965,1],"有一次，城里一座老楼着火了，情况非常严重。":[3,626940,27885,0],"法律":[3,654825,4245,1,0.94],"父亲":[3,659070,4125,1,0.85],"父亲告诉我，记者的责任就是让大家知道真实的情况。":[3,663195,29205,1],"父亲是第一个到那里的记者。":[3,692400,13485,1],"现在我也上了大学，选择了新闻专业。":[3,705885,20205,1],"现在的手机技术越来越好了。":[3,726090,15165,1],"理解":[3,741255,4005,1,0.97],"确实":[3,745260,4365,1,0.91],"社会":[3,749625,4245,1],"答案":[3,753870,3885,1],"至少":[3,757755,4125,1],"表扬":[3,761880,3765,1,0.93],"解释":[3,765645,4245,1,0.91],"记者":[3,769890,4005,1,0.85],"证明":[3,773895,4125,1,0.96],"负责":[3,778020,4005,1,0.89],"这个月底我要去北京出差。":[3,782025,13005,1],"这件事情由我来负责。":[3,795030,10725,1],"这几年，这座城市发展得很快。":[3,805755,18885,0],"这是一个很复杂的社会问题。":[3,824640,14445,1],"这条新闻是他报道的。":[3,839085,11565,1],"这篇报道受到了很多人的注意，大家开始讨论老房子的安全问题。":[3,850650,32805,1],"这篇报道至少要写两千字。":[3,883455,14085,1],"遍":[3,897540,3765,1,0.37],"重新":[3,901305,4005,1,0.94],"首先":[3,905310,4245,1,0.92],"首先我们要了解情况，然后再做决定。":[3,909555,20685,1],"首先认真读题，然后再写答案。":[3,930240,18045,1],"首先，我们要了解清楚情况。":[3,948285,16725,1],"仍然":[4,0,3765,1,0.91],"他嘴上说没关系，其实很生气。":[4,3765,18645,1],"他这个月的工资超过了一万块。":[4,22410,14085,1],"你可以试一下这件衣服。":[4,36495,11685,1],"值得":[4,48180,3885,1,0.94],"假":[4,52065,3765,1,0.67],"别紧张，你慢慢说。":[4,55830,13245,1,0.95],"千万":[4,69075,4125,1],"即使":[4,73200,4245,1],"即使失败了，这也是一次很好的经历。":[4,77445,20085,1],"即使很累，她也不想放弃。":[4,97530,16005,1],"即使明天下雨，比赛也会继续进行。":[4,113535,19605,1],"压力":[4,133140,4125,1],"去年，我报名参加了学校的汉语比赛，要在台上用汉语讲五分钟。":[4,137265,35685,1],"各":[4,172950,3765,1,0.46],"各位观众，晚上好！":[4,176715,13005,1],"后来，我们再也没有联系过。":[4,189720,15285,1],"后来，我请老师和同学给我提意见，大家一起讨论怎么把我的话讲得更自然。":[4,205005,40725,1],"听了她的话，我觉得轻松了许多。":[4,245730,16965,1,0.96],"地址":[4,262695,3765,1,0.86],"坐地铁上班可以省很多时间。":[4,266460,14565,0],"大家对这个计划有什么意见？":[4,281025,14325,1],"学习的过程比结果更重要。":[4,295350,13965,1],"尽管":[4,309315,4005,1,0.89],"尽管他很努力，可是成绩仍然不太好。":[4,313320,21165,1],"尽管压力很大，他仍然没有放弃。":[4,334485,18285,1],"尽管天气很冷，可是大家都玩得很高兴。":[4,352770,20565,1],"尽管我紧张得一直出汗，我仍然顺利地讲完了。":[4,373335,22845,0],"工资":[4,396180,4005,1,0.89],"弄":[4,400185,3765,1,0.5],"意见":[4,403950,3885,1],"我们讨论了两个小时，还是没有结果。":[4,407835,19485,1],"我的电脑被弟弟弄坏了。":[4,427320,11445,1],"推迟":[4,438765,4125,1,0.94],"无论":[4,442890,3765,1],"无论你什么时候来，我都欢迎。":[4,446655,16485,1,0.97],"昨天的比赛我们赢了！":[4,463140,10365,1],"最后，我得了第二名。":[4,473505,12885,0],"最近工作压力很大，我经常觉得很累。":[4,486390,20085,1],"最重要的不是结果，而是准备的过程。”":[4,506475,20205,1,0.96],"母亲":[4,526680,4005,0,0.95],"母亲总是说，健康比什么都重要。":[4,530685,18165,1],"母亲看出了我的心情，对我说：“即使不能赢，这也是一次值得的经历。":[4,548850,39045,1],"比赛前一个月，我每天都在准备，压力特别大。":[4,587895,25965,1],"比赛那天，台下坐满了人。":[4,613860,15285,1],"深":[4,629145,3285,1,0.54],"由于":[4,632430,4125,1,0.95],"由于天气不好，比赛推迟了。":[4,636555,16725,1],"由于天气原因，航班推迟了。":[4,653280,16485,1],"由于太紧张，我有好几次都想放弃。":[4,669765,18765,1,0.94],"由于时间关系，我就不多说了。":[4,688530,16845,1,0.97],"省":[4,705375,4725,1,0.53],"紧张":[4,710100,4485,1,0.97],"经历":[4,714585,4125,1,0.93],"美丽":[4,718710,3885,1],"自然":[4,722595,3645,1,0.93],"航班":[4,726240,4005,0],"观众":[4,730245,3885,1,0.9],"讨论":[4,734130,3885,1],"许多":[4,738015,4125,1,0.92],"许多人都经历过失败。":[4,742140,11205,1],"试":[4,753345,3045,1,0.43],"说明":[4,756390,4245,1,0.94],"请把你的地址写在这里。":[4,760635,11805,1],"责任":[4,772440,4005,1,0.86],"赢":[4,776445,3765,1,0.54],"超过":[4,780210,4125,1,0.92],"过程":[4,784335,3885,1,0.84],"这个包是假的，你被骗了。":[4,788220,15045,1],"这个地方很值得去看看。":[4,803265,12045,1,0.96],"这个结果说明我们的方法是对的。":[4,815310,15645,1],"这是我的责任，我不能放弃。":[4,830955,16125,1],"这条河很深，千万别在这里游泳。":[4,847080,18765,1],"这次经历说明，无论做什么，只要不放弃，就会有好的结果。":[4,865845,34365,1],"这里的自然风景非常美丽。":[4,900210,13125,1],"风景":[4,913335,4365,1,0.87],"饭馆里坐满了人。":[4,917700,8925,1],"一群孩子在公园里玩。":[5,0,11325,1],"上大学以前，我遇到了一个很大的困难：选什么专业？":[5,11325,28485,1],"上课":[5,39810,4485,1],"下大雪了，于是我们决定在家休息。":[5,44295,19605,1],"下雨了，于是我们就在家看电影。":[5,63900,19485,1],"主意":[5,83385,4125,0,0.92],"于是":[5,87510,4005,1,0.96],"于是，我决定跟父母好好谈一谈。":[5,91515,19485,1],"从来":[5,111000,4125,1,0.97],"他从来不抽烟。":[5,115125,8325,1],"他从来没迟到过。":[5,123450,9285,1],"他们希望我学管理或者经济，因为市场上需要这方面的人，工作条件也比较好。":[5,132735,39645,1],"他把照片挂在墙上了。":[5,172380,11565,1],"他觉得这个专业很适合自己，于是就选择了它。":[5,183945,25125,1],"你的回答完全正确。":[5,209070,10485,0],"你的房间太乱了，快收拾一下。":[5,219555,17445,1],"关键":[5,237000,4005,1,0.88],"十分":[5,241005,4125,1,0.92],"危险":[5,245130,4245,1,0.95],"后来，我的老师对我说：“选专业最关键的是找到适合自己的方向。":[5,249375,35445,1],"周末我要陪妈妈去买东西。":[5,284820,13245,1],"学习上遇到困难，可以找老师帮忙。":[5,298065,20085,1],"学校规定，上课的时候不能玩手机。":[5,318150,19845,1],"小心，别让孩子玩火。":[5,337995,14325,0],"市场":[5,352320,4605,0],"广告":[5,356925,3645,1,0.91],"引起":[5,360570,4245,1,0.97],"我下个月正式开始上班。":[5,364815,12285,1,0.96],"我从来没去过那个地方。":[5,377100,11685,1],"我们为这件事吵了好几次。":[5,388785,12765,1],"我去银行取钱，你等我一下。":[5,401550,16245,1],"我告诉他们，我从来没有这么认真地考虑过一件事。":[5,417795,25125,0],"我本来对艺术很有兴趣，想学画画，可是父母觉得这个专业不好找工作。":[5,442920,38805,0],"我本来打算读法律，后来改变了主意。":[5,481725,19725,1],"我觉得这份工作不太适合我。":[5,501450,15045,1],"我还不清楚自己以后的方向。":[5,516495,13845,1],"抽烟":[5,530340,4125,1,0.96],"收拾":[5,534465,4365,1,0.93],"教育":[5,538830,4005,1,0.97],"教育孩子需要很多耐心。":[5,542835,11805,1],"方向":[5,554640,4365,1,0.91],"最后，他们同意了。":[5,559005,12645,1],"本来":[5,571650,3405,1,0.96],"条件":[5,575055,4245,1,0.96],"样子":[5,579300,4125,1],"正式":[5,583425,4245,1,0.93],"正确":[5,587670,4365,1,0.96],"爱情":[5,592035,4245,1,0.97],"现在我已经正式成为艺术专业的学生，虽然学习很辛苦，但是我十分快乐。":[5,596280,39405,1],"现在电视上的广告太多了。":[5,635685,14205,1],"看他的样子，好像很累。":[5,649890,14565,1],"管理":[5,664455,3645,1,0.87],"约会":[5,668100,4005,1,0.97],"群":[5,672105,4245,1,0.57],"耐心":[5,676350,4125,1],"规定":[5,680475,3765,1,0.83],"警察":[5,684240,4125,0],"这个地方十分安静。":[5,688365,9885,1,0.91],"这个工作条件不错，工资也挺高。":[5,698250,17925,1,0.95],"这个广告引起了很多人的注意。":[5,716175,15045,1],"这个电影讲的是一个爱情故事。":[5,731220,14685,1],"这家公司管理得很好。":[5,745905,10965,0],"这种手机在市场上卖得很好。":[5,756870,14565,0],"适合":[5,771435,4365,1,0.95],"选择专业的时候，兴趣是最关键的。":[5,775800,19485,1],"遇到危险的时候，要马上给警察打电话。":[5,795285,21645,0],"钱够不够？不够我这里还有。":[5,816930,16125,1],"难道":[5,833055,3885,1],"难道你不知道他要结婚了吗？":[5,836940,13965,1],"难道你不知道这件事情吗？":[5,850905,13005,1],"难道你忘记了我们的约会吗？":[5,863910,12885,1],"难道你愿意每天做自己不喜欢的事情吗？”":[5,876795,18045,1],"三年以后，他拍出了自己的第一个电影。":[6,0,21165,1],"中文":[6,21165,3765,1],"丰富":[6,24930,4245,1,0.84],"为了省钱，他租了一个很小的房间，每天学习到很晚。":[6,29175,28965,1],"于是，他决定放弃律师工作，去学拍电影。":[6,58140,26565,1,0.96],"今天天气很好，我的心情也很好。":[6,84705,18885,1],"他们俩的感情一直很好。":[6,103590,11685,1],"他只学习了半年汉语，竟然能看中文小说了。":[6,115275,23325,1],"他是一位很有经验的律师。":[6,138600,12645,1],"他的工资是我的三倍。":[6,151245,10125,1],"他的工资是我的两倍。":[6,161370,10125,1],"他的普通话很标准。":[6,171495,10485,1],"他的父母和朋友几乎都反对，觉得他的想法太奇怪了。":[6,181980,27285,1],"他真正喜欢的是电影。":[6,209265,11085,1],"他竟然忘记了自己的生日。":[6,220350,12525,1],"他走路的速度很快。":[6,232875,10125,1,0.94],"你学习汉语的目的是什么？":[6,243000,12645,1],"你想选择什么职业？":[6,255645,9885,1],"俩":[6,265530,4725,1,0.64],"倍":[6,270255,3765,1,0.43],"公司通知我们明天上午开会。":[6,274020,14085,1],"内容":[6,288105,3885,1],"可是工作了五年以后，他发现自己每天早上醒来心情都很差。":[6,291990,29805,1],"国际":[6,321795,4005,1,0.86],"她穿着一条美丽的裙子。":[6,325800,11925,1],"妈妈抱着孩子在门口等我。":[6,337725,14685,1],"实在":[6,352410,4125,1],"小林却说：“生命只有一次，我不想后悔。”":[6,356535,23925,1],"小说":[6,380460,4245,1,0.96],"开会":[6,384705,3885,1],"当地":[6,388590,3765,1,0.92],"很多人反对这个计划。":[6,392355,10965,1],"律师":[6,403320,4245,1,0.91],"感情":[6,407565,4005,1],"我今天早上六点就醒了。":[6,411570,12165,1],"我们会按照计划完成任务。":[6,423735,12885,1],"我实在吃不下了。":[6,436620,9405,1],"我的朋友小林大学毕业以后成了一名律师。":[6,446025,19245,1],"我的鞋破了，要买一双新的。":[6,465270,16005,1],"抱":[6,481275,3765,1,0.54],"按照":[6,485040,4005,0],"效果":[6,489045,4245,1,0.96],"昨天的演出太精彩了！":[6,493290,11565,1],"标准":[6,504855,4125,1,0.9],"演出":[6,508980,4245,1],"演出结束以后，观众都站起来鼓掌。":[6,513225,19365,1],"现在小林常说：“以前的律师经验让我更懂得怎么讲故事。”":[6,532590,28605,1],"用刀的时候要小心。":[6,561195,10485,1],"电影讲的是一家人的感情故事，内容很简单，效果却特别好，观众都说非常精彩。":[6,571680,44325,1],"目的":[6,616005,3765,1,0.91],"科学":[6,619770,4245,1,0.94],"科学技术的发展改变了我们的生活。":[6,624015,17805,1],"竟然":[6,641820,3885,1,0.93],"精彩":[6,645705,4125,1],"经济":[6,649830,4365,1],"经验":[6,654195,4005,1],"职业":[6,658200,3765,1,0.92],"范围":[6,661965,4245,1],"让大家没想到的是，这个电影竟然在一个国际电影节上得了奖！":[6,666210,30045,1],"请按照老师的要求去做。":[6,696255,12165,1],"请按照规定的时间交作业。":[6,708420,14085,1],"这个房间比那个大一倍。":[6,722505,11325,1],"这个门要推，不要拉。":[6,733830,11925,1],"这个问题，一个孩子竟然回答对了。":[6,745755,18525,1],"这几年，当地的经济发展得很快。":[6,764280,19485,0],"这是一份很多人羡慕的职业：收入高，工作环境也不错。":[6,783765,31125,1],"这是一场国际比赛，有二十多个国家参加。":[6,814890,21645,1,0.96],"这本书的内容非常丰富。":[6,836535,12405,1],"这本小说我看了三遍。":[6,848940,10845,1],"这次会议的重点是讨论工资问题。":[6,859785,16005,1],"这次考试的范围很大。":[6,875790,11325,1],"这种药的效果很好。":[6,887115,10125,1,0.96],"通知":[6,897240,4125,1,0.95],"速度":[6,901365,4125,1,0.91],"重点":[6,905490,4125,1,0.95],"鼓掌":[6,909615,3765,1,0.92],"上个月，一个著名的艺术团来我们城市演出，而且是免费的！":[7,0,34245,1],"不仅":[7,34245,3645,1,0.89],"不得不":[7,37890,4725,1,0.88],"不过，想看演出要先在网上申请，因为座位不多，竞争非常大。":[7,42615,36525,1],"世纪":[7,79140,4245,0,0.91],"他不仅会唱歌，而且还会跳舞。":[7,83385,17805,1],"他是一位著名的艺术家。":[7,101190,11445,1],"他被爸爸批评了一顿。":[7,112635,10965,1],"他跳舞的动作非常好看。":[7,123600,12285,1],"以后有机会，咱们还要来。”":[7,135885,15165,1],"估计":[7,151050,4005,1,0.92],"你们俩是什么时候认识的？":[7,155055,12405,1],"你哥哥长得真帅！":[7,167460,8805,1],"你要按时申请，否则就没有机会了。":[7,176265,18885,1],"允许":[7,195150,4125,0,0.9],"制造":[7,199275,3765,1],"动作":[7,203040,3645,1,0.91],"否则":[7,206685,4245,1,0.91],"吸引":[7,210930,4605,1],"咱们":[7,215535,3765,1,0.94],"咱们一起去看演出吧！":[7,219300,10605,1],"回家的路上，妻子说：“这样的演出不仅让人快乐，而且让我们更了解了艺术。":[7,229905,40965,1],"因为没有钱，他不得不放弃留学的计划。":[7,270870,21165,1],"增加":[7,292035,3885,1,0.91],"大概":[7,295920,4005,1],"天气太差了，演出不得不推迟。":[7,299925,18165,0],"失败了也没关系，下次再来。":[7,318090,16125,1],"她正在申请签证。":[7,334215,9765,1],"当地的人都非常热情。":[7,343980,11685,1],"快走吧，否则就来不及了。":[7,355665,16365,1,0.94],"我估计他大概八点能到。":[7,372030,11565,1],"我估计这场演出大概有两个小时，可是我一点儿也不觉得长。":[7,383595,29325,1],"我和妻子一起申请，没想到我们俩竟然都成功了。":[7,412920,25605,1],"我对艺术一直很有兴趣。":[7,438525,12525,1],"我最讨厌别人迟到。":[7,451050,10245,1],"我的自行车坏了，不得不走路去学校。":[7,461295,20205,1,0.95],"我请她去看电影，可是她拒绝了。":[7,481500,18645,1],"批评":[7,500145,4005,1,0.91],"拒绝":[7,504150,4125,1,0.9],"教授":[7,508275,4245,1],"昨天的比赛我们输了，大家都很难过。":[7,512520,20325,1],"晚上别一个人去，否则我会担心的。":[7,532845,19125,1],"最近来这里旅游的人增加了很多。":[7,551970,15405,1],"来不及":[7,567375,4845,1],"消息一发出来，很多人都想去看。":[7,572220,18165,1],"演出中间，演员还请几个当地的孩子上台一起表演，大家都笑了。":[7,590385,34965,1],"演出那天晚上，里面坐满了观众。":[7,625350,18045,1],"演员的动作又漂亮又整齐，音乐也十分好听，深深地吸引了每一个人。":[7,643395,35085,0],"现在找工作的竞争非常大。":[7,678480,14085,1],"申请":[7,692565,4605,1,0.94],"祝你一切顺利！":[7,697170,7965,1],"竞争":[7,705135,3885,1,0.89],"签证":[7,709020,4125,1,0.94],"艺术":[7,713145,4245,1,0.96],"艺术家":[7,717390,4725,1,0.91],"著名":[7,722115,3765,1,0.93],"讨厌":[7,725880,4005,1],"输":[7,729885,3285,1,0.41],"这个地方不仅风景美丽，而且东西很便宜。":[7,733170,22245,1],"这个广告吸引了很多年轻人。":[7,755415,14445,1],"这位教授的课非常有意思。":[7,769860,13005,1],"这只小猪真可爱！":[7,782865,9285,1],"这场演出不仅精彩，而且免费。":[7,792150,17925,1],"这场演出是免费的，不用买票。":[7,810075,17925,1],"这种手机是在中国制造的。":[7,828000,13485,1],"这种衣服在上个世纪很流行。":[7,841485,14925,1],"这里不允许抽烟。":[7,856410,8925,1],"顺利":[7,865335,4005,1,0.92],"顿":[7,869340,3645,1,0.42],"麻烦":[7,872985,4245,0],"麻烦你把那本书给我。":[7,877230,10845,1],"一个星期很快就过去了，大家玩得非常轻松。":[8,0,23205,0],"中国人觉得“八”是一个好数字。":[8,23205,19605,0],"他是我们班最优秀的学生。":[8,42810,13245,1],"他的工作态度很认真。":[8,56055,11325,1],"价格":[8,67380,4005,1],"你打算毕业以后做什么？":[8,71385,11565,1],"你最好提前买票。":[8,82950,9645,1],"停止":[8,92595,4245,1,0.92],"儿童":[8,96840,3885,1,0.96],"公里":[8,100725,3645,1,0.89],"共同":[8,104370,3885,1],"出发前一天，小王在杂志上看了一篇文章，提醒大家：“那边的天气很复杂，最好带上伞。":[8,108255,49605,1],"到了那里，我们发现周围的风景比照片上还美，当地的菜味道也特别好。":[8,157860,37125,1],"千万别忘记带护照。":[8,194985,10125,1],"另外，钱包和护照千万别丢了！”":[8,205110,18405,1],"周围":[8,223515,4125,1],"味道":[8,227640,3885,1],"回来的时候，我们都说：毕业了，友谊不能断，以后每年都要一起出去旅行。":[8,231525,44085,1],"墙上挂着一张地图。":[8,275610,10605,1],"大学毕业以后，我和三个同学决定一起去南方旅行。":[8,286215,27525,1],"她是一位很有名的演员。":[8,313740,11565,1],"她邀请我们周末去她家玩。":[8,325305,12765,1],"差点":[8,338070,4125,1],"怀疑":[8,342195,4245,1],"态度":[8,346440,4005,1,0.96],"我不知道怎么表达我的感谢。":[8,350445,13605,1],"我们共同的爱好是爬山和吃好吃的东西。":[8,364050,19485,1],"我们明天早上七点出发。":[8,383535,11925,1],"我们正在打电话，突然断了。":[8,395460,15885,1],"我写了一篇关于交通的文章。":[8,411345,13965,1],"我和他有很多共同的爱好。":[8,425310,12765,1],"我家周围有很多饭馆。":[8,438075,11325,1,0.96],"我家距离公司只有两公里。":[8,449400,12165,1],"我怀疑这个消息是假的。":[8,461565,11325,1],"我每个月都买这本杂志。":[8,472890,11925,1],"我的自行车坏了，要拿去修。":[8,484815,16605,1,0.97],"我的钱包丢了！":[8,501420,7845,1],"提前":[8,509265,4005,1,0.94],"提醒":[8,513270,4245,1,0.95],"数字":[8,517515,4365,1,0.93],"文章":[8,521880,4125,1,0.88],"断":[8,526005,3885,1,0.49],"既然":[8,529890,3765,1,0.87],"既然你不舒服，就在家休息吧。":[8,533655,16965,1],"既然你已经决定了，我就不说什么了。":[8,550620,18765,1,0.96],"既然大家都同意，我们就明天出发。":[8,569385,19005,1],"既然大家都有时间，我们就开始做计划。":[8,588390,20565,1,0.95],"最好":[8,608955,4245,1,0.95],"杂志":[8,613200,4245,1],"比赛因为天气原因停止了。":[8,617445,13245,1],"演员":[8,630690,4005,1],"灯还亮着，他可能还没睡觉。":[8,634695,16485,1],"考试结束以后，大家都觉得很轻松。":[8,651180,19845,1],"表达":[8,671025,3765,1,0.87],"谢谢你提醒我，我差点忘记了。":[8,674790,17805,1],"距离":[8,692595,3885,1,0.91],"路上":[8,696480,4005,1,0.94],"路上千万要注意安全。":[8,700485,11325,1],"轻松":[8,711810,4125,1,0.96],"这个城市的交通很方便。":[8,715935,12405,1],"这个菜的味道真不错。":[8,728340,10965,1],"这个问题比我想的复杂。":[8,739305,11805,1],"这件事情你最好先别告诉他。":[8,751110,14805,1],"这件事情千万别告诉别人。":[8,765915,14565,0],"这本书是写给儿童看的。":[8,780480,12045,1],"这里的东西价格都很便宜。":[8,792525,13725,1],"首先要考虑的是交通：坐飞机快，但是价格太贵；坐火车便宜，距离也不算太远，于是我们选择了坐火车。":[8,806250,58605,1],"上个月，我奶奶就差点被人骗了。":[9,0,19125,1],"交流":[9,19125,4125,1],"他以为自己能赢，然而他输了。":[9,23250,16725,1],"他们俩的年龄差不多。":[9,39975,10365,1],"他很努力，然而结果还是不理想。":[9,50340,18165,1],"他激动得哭了。":[9,68505,7845,0],"他虽然年龄不大，但是很成熟。":[9,76350,17685,1],"你昨天没来，真可惜！演出非常精彩。":[9,94035,25125,1],"你真厉害，一次就通过了考试！":[9,119160,16605,1,0.96],"你究竟想说什么？":[9,135765,8925,1],"信任":[9,144690,4125,1,0.92],"兴奋":[9,148815,4365,1],"其实，不管年龄大还是小，都有可能被骗。":[9,153180,24645,1,0.97],"出门":[9,177825,4125,1],"别浪费时间了，快开始吧。":[9,181950,15285,1],"厉害":[9,197235,4125,1,0.96],"另外，上网虽然方便，但也不要浪费太多时间。":[9,201360,27165,1],"可怜":[9,228525,3885,1],"可惜":[9,232410,3885,1,0.96],"听到这个好消息，他激动得哭了。":[9,236295,17925,0],"周末一个人在家，真无聊。":[9,254220,14325,1],"和中国人交流是学习汉语最好的方法。":[9,268545,17565,1],"在网上我们不能随便信任别人，遇到要钱的事情，一定要先问清楚，看看究竟是怎么回事。":[9,286110,48405,1],"地球":[9,334515,3765,1,0.91],"天气很冷，出门最好戴上帽子。":[9,338280,17925,1],"太阳太大，要注意保护皮肤。":[9,356205,16485,1],"奶奶激动得不得了，差点就转了钱。":[9,372690,19605,1],"她收到一条消息，说她的孙子出了事，需要马上给对方转一万块钱。":[9,392295,35445,1],"妈妈做的菜真香！":[9,427740,9285,1],"实际":[9,437025,4245,1,0.83],"尊重":[9,441270,4005,1,0.86],"工具":[9,445275,4005,1,0.86],"差不多":[9,449280,4845,1],"年龄":[9,454125,4005,1],"成熟":[9,458130,4485,1],"我们只有一个地球，要好好保护它。":[9,462615,19485,1],"我们在网站上看新闻、读文章，用手机跟世界上不同国家的人交流。":[9,482100,37965,1],"我们应该尊重别人的选择。":[9,520065,12645,1],"我太困了，想躺一会儿。":[9,532710,13605,1],"我肚子疼得厉害。":[9,546315,8685,1,0.95],"我非常信任他。":[9,555000,8445,1,0.95],"无聊":[9,563445,3765,1],"明天就要去旅游了，孩子非常兴奋。":[9,567210,19365,1],"最近他忙得很。":[9,586575,7965,1],"有用":[9,594540,4005,1,0.92],"有的人躺在床上玩一晚上手机，第二天困得厉害，实在可惜。":[9,598545,32925,1],"浪费":[9,631470,4125,1,0.9],"激动":[9,635595,3885,1,0.89],"然而":[9,639480,4005,1],"然而，网上的东西不一定都是真的。":[9,643485,19485,1],"现在，上网已经成为我们生活中很重要的一部分。":[9,662970,24885,1],"理想":[9,687855,4125,1],"皮肤":[9,691980,4125,1],"究竟":[9,696105,4245,1,0.83],"究竟发生了什么事情？":[9,700350,10965,1],"符合":[9,711315,4125,1,0.93],"网上":[9,715440,4125,1],"网上有很多骗人的广告，你要小心。":[9,719565,19245,1],"网上的文章很多，然而不是每篇都值得读。":[9,738810,21885,1],"网站":[9,760695,4005,1],"肚子":[9,764700,4005,1,0.87],"语言":[9,768705,4005,0,0.96],"语言是交流的工具。":[9,772710,10005,1,0.97],"请把桌子擦干净。":[9,782715,9885,1],"轻":[9,792600,3165,1,0.48],"还好她先给我打了个电话，我告诉她这是骗人的。":[9,795765,24285,1],"这个包很轻，我自己拿吧。":[9,820050,14925,1,0.94],"这个网站上有很多有用的文章。":[9,834975,15045,1],"这个网站上的消息究竟是真的还是假的？":[9,850020,19845,1],"这个计划不太实际。":[9,869865,10125,1,0.92],"这个问题的答案是什么？":[9,879990,11325,1,0.97],"这份工作不符合我的要求。":[9,891315,13485,1],"这只小狗没有家，真可怜。":[9,904800,14805,1],"这篇文章写得很好。":[9,919605,10485,1],"香":[9,930090,3285,1,0.54],"三个月前，我从南方搬到了北京。":[10,0,18285,1],"不过，慢慢地，我发现这座城市也有很多可爱的地方。":[10,18285,31965,0],"互相":[10,50250,4245,1,0.93],"从这里到机场大约要四十分钟。":[10,54495,15405,1],"仔细":[10,69900,4245,1,0.85],"他上课的时候总是积极回答问题。":[10,74145,18045,1],"他们俩经常互相帮助。":[10,92190,11325,1],"他现在一个月能赚一万多块。":[10,103515,14085,1],"他的收入比以前高多了。":[10,117600,11925,1],"他走路不小心，撞到了门上。":[10,129525,16365,1],"你对他的第一印象怎么样？":[10,145890,11925,1],"你对这里熟悉吗？":[10,157815,8805,1],"你猜得到他是谁吗？":[10,166620,10005,1],"你猜我今天遇到谁了？":[10,176625,10605,1],"公园里到处都是花。":[10,187230,10245,1],"写文章以前，要先准备好材料。":[10,197475,19125,1],"农村":[10,216600,4125,1],"冬天的阳光很美，北方的面条和汤也很好吃。":[10,220725,24645,1],"出生":[10,245370,4125,1,0.94],"刚来北京的时候，我很不适应：冬天特别冷，空气也很干燥，我的皮肤总是不舒服。":[10,249495,46365,1],"到处":[10,295860,4125,1,0.97],"印象":[10,299985,4245,1,0.97],"另外，我对周围的环境完全不熟悉，常常走错路，有一次还在地铁站里撞到了别人。":[10,304230,46485,0],"号码":[10,350715,4125,0,0.93],"合适":[10,354840,4245,1],"同事们其实都很热情，常常互相帮助。":[10,359085,21405,1],"响":[10,380490,4845,1,0.68],"回忆":[10,385335,4125,1,0.88],"基础":[10,389460,4125,1],"大约":[10,393585,4005,1],"失望":[10,397590,4125,1],"好喝":[10,401715,4245,1],"妈妈做的汤特别好喝。":[10,405960,10965,1],"学习汉语，基础非常重要。":[10,416925,15645,1],"小时候":[10,432570,5085,1,0.96],"工作上，我暂时还没交到朋友，同事们好像都很忙。":[10,437655,29805,1],"开始的时候，我不太适应这里的天气。":[10,467460,19725,1],"开始的时候，我什么都听不懂。":[10,487185,16485,1],"恐怕":[10,503670,4005,1,0.95],"恐怕他今天来不及了。":[10,507675,10965,1],"恐怕再过一段时间，我就会真正爱上这里吧。":[10,518640,22845,1,0.97],"恐怕明天会下雨。":[10,541485,9885,1],"我们应该互相帮助。":[10,551370,9765,1],"我出生在一个小城市，那里一年四季都很暖和，到处都是绿色。":[10,561135,33045,1],"我是在这座城市出生的。":[10,594180,12645,1,0.94],"我暂时住在朋友家。":[10,606825,10605,1,0.96],"我经常回忆小时候在农村的生活。":[10,617430,17445,1],"手机响了，你快接一下。":[10,634875,14805,1],"收入":[10,649680,4125,1,0.93],"明天的会议提前到九点了。":[10,653805,13485,1],"暂时":[10,667290,4485,1,0.95],"朋友要互相信任。":[10,671775,9405,1],"材料":[10,681180,4005,1],"汤":[10,685185,4005,1,0.52],"熟悉":[10,689190,4245,1,0.95],"现在我的收入比以前高，生活也越来越习惯了。":[10,693435,23805,1],"积极":[10,717240,4125,1],"空气":[10,721365,4245,1,0.96],"说实话，我对北京的第一印象不太好，甚至有点儿失望。":[10,725610,32205,1],"请再仔细检查一遍。":[10,757815,10725,1],"请告诉我你的手机号码。":[10,768540,11805,1],"赚":[10,780345,3885,1,0.57],"过了这座桥就到了。":[10,784230,9525,1,0.93],"这些菜太多了，我们吃不完。":[10,793755,15765,1],"这件衣服你穿很合适。":[10,809520,11445,1],"这件衣服恐怕不太合适。":[10,820965,12645,1],"这家宾馆很高级。":[10,833610,9765,1],"这次的成绩不好，他非常失望。":[10,843375,17805,1],"这种食品对身体不好。":[10,861180,11805,1],"这里的阳光很好，空气也很新鲜。":[10,872985,19125,1],"适应":[10,892110,4125,1,0.96],"阳光":[10,896235,4005,1,0.95],"随便":[10,900240,4125,1,0.82],"随便坐吧，想喝什么自己拿。":[10,904365,16125,1],"食品":[10,920490,4485,1],"高级":[10,924975,4125,1,0.93],"三百":[11,0,4125,1],"不过，读博士也有很多好处：我可以专门研究自己有兴趣的问题，还认识了很多有趣的朋友。":[11,4125,48165,1],"专门":[11,52290,4245,1,0.95],"严格":[11,56535,4005,1,0.96],"为了减少污染，我们应该多坐地铁。":[11,60540,18285,0],"主动":[11,78825,4245,1,0.85],"他已经读了三年博士了。":[11,83070,11325,1],"他把房间租给了一个学生。":[11,94395,12885,1],"他是一个很浪漫的人。":[11,107280,10485,1],"你对这件事情有什么看法？":[11,117765,13605,1],"你来得正好，我有事情想问你。":[11,131370,16485,1],"信心":[11,147855,4365,1],"减少":[11,152220,4365,1,0.9],"判断":[11,156585,4005,1,0.97],"博士":[11,160590,4125,1,0.91],"参加这个比赛没有年龄限制。":[11,164715,14445,1],"及时":[11,179160,4245,1],"周末，我们常常一起去附近的公园散步，或者听她弹钢琴。":[11,183405,31965,1],"大家今天都辛苦了！":[11,215370,10365,1],"她弹钢琴弹得很好。":[11,225735,10245,1],"好处":[11,235980,4365,1,0.97],"对不起，我不是故意的。":[11,240345,14085,1,0.93],"尤其":[11,254430,4245,1,0.93],"尤其是我的同学安娜，她总是主动帮助别人，遇到困难也从来不着急。":[11,258675,35805,1],"弹":[11,294480,4245,1,0.52],"很难判断这个消息是真的还是假的。":[11,298725,18045,1],"我专门为你买了这本书。":[11,316770,11445,1],"我们老师对学生要求很严格。":[11,328215,13965,1],"我叫小陈，正在读博士。":[11,342180,15045,1],"我喜欢吃水果，尤其是西瓜。":[11,357225,16845,1,0.94],"我喜欢运动，尤其是游泳。":[11,374070,15525,1],"我在学校附近租了一个房间。":[11,389595,13845,1],"我家离学校只有三公里。":[11,403440,12045,1],"我对这次比赛很有信心。":[11,415485,12525,1,0.95],"我把自行车借给朋友了。":[11,428010,12285,1],"我正好也要去银行，一起走吧。":[11,440295,17685,1],"我的看法是，不管做什么，只要喜欢，再苦也值得。":[11,457980,30165,1,0.97],"我的老师是一位很严格的教授，他常说：“光有知识还不够，最重要的是学会判断问题。”":[11,488145,46365,1],"手机是现代人最重要的工具之一。":[11,534510,16365,1],"故意":[11,550875,3645,1,0.88],"有时候工作不顺利，我会对自己没有信心，甚至想放弃。":[11,554520,30405,1,0.97],"有趣":[11,584925,4125,1,0.91],"有问题要及时告诉我。":[11,589050,11085,1],"正好":[11,600135,4365,1,0.97],"每天早上，我骑自行车去学校，学校离我租的房子正好三公里。":[11,604500,34725,1],"污染":[11,639225,4005,1],"浪漫":[11,643230,3765,1],"现代":[11,646995,4125,1,0.96],"看法":[11,651120,4125,1],"知识":[11,655245,4005,1],"经常锻炼对身体有很多好处。":[11,659250,16485,1],"请把这些旧报纸扔掉。":[11,675735,11325,1],"读书可以让我们获得很多知识。":[11,687060,14445,1],"读博士很辛苦，工资也不高，每个月交完房租，就剩不下多少钱了。":[11,701505,37605,1],"辛苦":[11,739110,4245,1],"这个故事很有趣。":[11,743355,9285,1,0.97],"这份工作的工资不太高。":[11,752640,11805,1],"这双鞋我穿正好。":[11,764445,9525,1],"这本书一共有三百页。":[11,773970,10605,1],"这种药很苦，孩子不爱吃。":[11,784575,15765,1],"这种面包太硬了。":[11,800340,8925,1],"这里很冷，尤其是晚上。":[11,809265,14565,1],"进门以前请把鞋脱了。":[11,823830,11325,1],"进门以前，他先把鞋脱了。":[11,835155,15285,1],"遇到问题要主动问老师。":[11,850440,11565,1],"钢琴":[11,862005,4365,1],"钱花得差不多了，只剩下二十块。":[11,866370,18405,0],"限制":[11,884775,4365,1,0.96],"页":[11,889140,2805,1,0.38],"一点儿":[12,0,4845,1,0.95],"上个月，书店举办了一次读书活动，请来了一位作者跟大家见面，那天书店里坐满了人。":[12,4845,47925,1],"下个月学校要举办一个读书活动。":[12,52770,15765,1],"举办":[12,68535,4125,1,0.92],"书店不大，里面的书却很丰富，从流行小说到历史书，什么都有。":[12,72660,36525,1,0.97],"书店里有点儿暗，但是很安静，平时很多学生喜欢来这里看书。":[12,109185,33885,1],"今天晚上的月亮又大又圆。":[12,143070,13125,1],"他的回答非常准确。":[12,156195,10245,1,0.93],"他的经验很丰富。":[12,166440,9405,1],"伤心":[12,175845,4245,1,0.94],"作者":[12,180090,4005,1,0.84],"你将来想做什么工作？":[12,184095,10725,1],"你能吃辣的吗？":[12,194820,7365,1],"冷静":[12,202185,3885,1,0.95],"准确":[12,206070,4365,1,0.92],"别吵了，孩子在睡觉。":[12,210435,14805,1],"区别":[12,225240,4005,1,0.97],"原谅":[12,229245,4005,1,0.87],"后悔":[12,233250,4245,1,0.95],"听到这个消息，她伤心地哭了。":[12,237495,17205,0],"吵":[12,254700,4725,1,0.55],"圆":[12,259425,3045,1,0.58],"大部分":[12,262470,4845,1,0.94],"对不起，请原谅我。":[12,267315,13005,1],"将来":[12,280320,4125,1],"平时":[12,284445,4245,1,0.93],"愉快":[12,288690,4005,1],"感动":[12,292695,3765,1,0.96],"我们一边喝茶一边聊天。":[12,296460,12285,1],"我们班由二十个学生组成。":[12,308745,12885,1],"我家楼下有一家小书店，开书店的是一位五十多岁的阿姨。":[12,321630,28125,1],"我希望这家小书店能一直开下去。":[12,349755,17205,1],"我平时很少看电视。":[12,366960,11205,1,0.96],"我很后悔当时没有听你的。":[12,378165,13005,1],"我想把这本书寄给我的朋友。":[12,391170,13845,1],"我最近在看一本很有意思的小说。":[12,405015,16245,1],"我的小说被朋友借走了。":[12,421260,11685,1],"我的理想是写一本自己的小说。":[12,432945,14325,1],"我的自行车叫人骑走了。":[12,447270,11325,1],"我肚子饿了，咱们去吃点东西吧。":[12,458595,17085,1,0.95],"我花了一个下午整理房间。":[12,475680,12765,1],"房间里太暗了，开灯吧。":[12,488445,13485,1],"整理":[12,501930,3885,1,0.89],"暗":[12,505815,4005,1,0.4],"有一次，一个孩子不小心把一本新书弄坏了，他很害怕，以为会被批评。":[12,509820,41325,0],"来这里买书的顾客大部分是学生。":[12,551145,16245,1],"没想到阿姨不但原谅了他，还鼓励他以后多读书。":[12,567390,24285,1],"祝你周末愉快！":[12,591675,7965,1],"禁止":[12,599640,4125,1,0.94],"组成":[12,603765,4005,1,0.95],"老师经常鼓励我们多练习。":[12,607770,12885,1],"聊天":[12,620655,4125,1,0.94],"蛋糕让弟弟吃完了。":[12,624780,10005,1],"详细":[12,634785,4365,1,0.93],"请把你的情况详细地介绍一下。":[12,639150,15645,0],"读书":[12,654795,4125,1,0.94],"质量":[12,658920,3645,1,0.9],"这两个词语有什么区别？":[12,662565,11445,1],"这个故事让我非常感动。":[12,674010,12285,1],"这个星期我一本书也没看。":[12,686295,12405,1],"这个菜一点儿也不辣。":[12,698700,10365,1,0.95],"这件小事让我很感动。":[12,709065,11565,1],"这本书的作者是谁？":[12,720630,10125,1,0.96],"这种手机的质量很好。":[12,730755,11445,1],"这种颜色现在很流行。":[12,742200,11925,1],"这里禁止抽烟。":[12,754125,7965,1],"遇到问题的时候要冷静。":[12,762090,11805,1],"阿姨对每一位顾客都很热情，常常跟大家聊天，还会详细地介绍每本书的作者和内容。":[12,773895,44325,0],"阿姨说，她的理想就是让更多的人爱上读书。":[12,818220,24525,1],"顾客":[12,842745,3765,1,0.88],"鼓励":[12,846510,3525,1,0.86],"一个人住，有时候会觉得很孤单。":[13,0,17805,1],"不过，变化也带来了问题。":[13,17805,15165,1],"中国是亚洲最大的国家之一。":[13,32970,13725,1],"中国有十四亿多人。":[13,46695,9765,1],"为了吸引顾客，商店降低了价格。":[13,56460,17805,1],"二十年前，购物要去商店，现在在手机上点一点，东西第二天就送到家了。":[13,74265,40365,1],"亚洲":[13,114630,4005,1],"亿":[13,118635,2805,1,0.42],"今天的温度比昨天低。":[13,121440,11205,1],"他是一个勇敢的孩子。":[13,132645,10005,1],"他果然没来。":[13,142650,7365,1],"以前出门一定要带钥匙和钱包，现在很多人家里用的是密码门，买东西也用手机。":[13,150015,41205,0],"你尝一下，味道怎么样？":[13,191220,13845,1],"保护森林就是保护我们自己。":[13,205065,14085,1],"勇敢":[13,219150,4005,1,0.87],"十四":[13,223155,4245,1,0.91],"去年夏天特别热，我想买一台空调，跑了好几家商店，空调果然都卖完了，我只好每天开着窗户睡觉。":[13,227400,55605,1],"友好":[13,283005,4125,1,0.87],"只好":[13,287130,4125,1],"商店关门了，我只好明天再来。":[13,291255,17805,1],"城市里的车越来越多，空气污染越来越严重，森林逐渐减少，地球的温度也越来越高。":[13,309060,45285,1],"增长":[13,354345,4245,1,0.92],"大家都说这个菜好吃，果然不错。":[13,358590,18525,1],"她的性格很活泼。":[13,377115,9645,1,0.96],"孤单":[13,386760,3645,1,0.91],"密码":[13,390405,3765,1],"富":[13,394170,3645,1,0.48],"对话":[13,397815,4125,0,0.92],"尝":[13,401940,4005,1,0.5],"巧克力":[13,405945,5445,1,0.96],"广播":[13,411390,3645,1,0.93],"当地人对我们非常友好。":[13,415035,11445,0],"快把东西收拾好，我们要出发了。":[13,426480,17685,1],"性格":[13,444165,4245,1],"成绩好的时候也不能骄傲。":[13,448410,13605,1],"我去一趟超市，马上回来。":[13,462015,16005,1],"我很喜欢吃巧克力。":[13,478020,10605,1],"我忘记了手机的密码。":[13,488625,10125,1],"我忘记带钥匙了，只好在门口等。":[13,498750,17685,1],"我想，为了降低污染，每个人都应该勇敢地做出改变：少用塑料袋，多坐公共汽车，多种树。":[13,516435,52005,0],"我早上起床以后习惯听广播。":[13,568440,14925,1],"我猜他会迟到，他果然迟到了。":[13,583365,17205,1],"数量":[13,600570,4125,1,0.89],"是我错了，我向你道歉。":[13,604695,14325,1,0.97],"有人说，如果我们不改变自己的习惯，将来的情况会更不好。":[13,619020,32085,1],"有时候":[13,651105,4725,1,0.91],"果然":[13,655830,3525,1,0.85],"森林":[13,659355,4245,1,0.94],"沙发":[13,663600,4125,0],"没有公共汽车了，我们只好走回家。":[13,667725,18885,1],"活泼":[13,686610,4245,1,0.86],"温度":[13,690855,3885,1,0.89],"现在很多人喜欢在网上购物。":[13,694740,14925,1],"访问":[13,709665,4005,1,0.91],"请听这段对话，然后回答问题。":[13,713670,18045,1],"购物":[13,731715,3645,1,0.93],"趟":[13,735360,3765,1,0.53],"这个沙发很软，坐着很舒服。":[13,739125,16605,1],"这个苹果太酸了。":[13,755730,9045,1,0.95],"这位记者访问了很多当地人。":[13,764775,14805,0],"这几年，农村的人也逐渐富起来了。":[13,779580,20685,1],"这条河的污染很严重。":[13,800265,11205,1],"这种鸟的数量越来越少。":[13,811470,12285,1],"逐渐":[13,823755,4125,1,0.96],"道歉":[13,827880,4245,1,0.96],"钥匙":[13,832125,4125,1],"降低":[13,836250,4125,1],"随着":[13,840375,4005,1,0.87],"随着天气越来越冷，公园里的人逐渐少了。":[13,844380,21885,1],"随着年龄的增长，他逐渐成熟了。":[13,866265,18645,1],"随着技术的发展，我们的生活越来越方便。":[13,884910,22005,1],"随着科学技术的发展，我们的生活发生了很大的变化。":[13,906915,27645,1],"随着经济的发展，我们的生活越来越好了。":[13,934560,22005,1],"骄傲":[13,956565,4005,1],"中国有五十六个民族。":[14,0,10485,1],"五十六":[14,10485,4965,1,0.9],"今天晚上我有个约会。":[14,15450,11205,1],"今年，医院给小美发了奖金。":[14,26655,16125,1],"他因为迟到被经理批评了。":[14,42780,13125,1],"他没生气，相反，还笑了。":[14,55905,17925,1],"你去超市的时候，顺便给我买点水果。":[14,73830,20085,1],"例如":[14,93915,3885,1],"偶尔":[14,97800,3765,0],"别生气，我只是跟你开玩笑。":[14,101565,18285,1,0.97],"厚":[14,119850,4005,1,0.45],"去年公司的收入增长了很多。":[14,123855,14325,1],"参观":[14,138180,4005,1,0.93],"友谊":[14,142185,3765,0,0.94],"反映":[14,145950,4125,1,0.93],"受不了":[14,150075,4965,1,0.91],"只是":[14,155040,4125,1,0.94],"吃完饭，我们去公园散步，顺便参观了公园里的植物园。":[14,159165,32205,1],"吃饭的时候，她提醒我少吃盐，少喝甜饮料，例如果汁和奶茶。":[14,191370,36285,1],"后来，老人离开医院的时候特别感谢她。":[14,227655,21645,1],"因为天气不好，我们的航班推迟了。":[14,249300,18645,1],"天气很冷，你最好穿厚一点的衣服。":[14,267945,19365,1],"奖金":[14,287310,4245,1],"她工作很辛苦，常常晚上也要上班，可是她对病人一直很有耐心。":[14,291555,35565,1],"她说：“你每天都喝那么多饮料，身体会受不了的。”":[14,327120,27165,1],"小美一点儿也没生气，相反，她每天都去陪老人聊天。":[14,354285,29805,1],"少喝甜饮料，多喝水。":[14,384090,13485,1],"开玩笑":[14,397575,5205,1],"我们下午去参观了他们的公司。":[14,402780,14445,1],"我们两个人一起把沙发抬进房间。":[14,417225,16605,1],"我们俩走的方向正好相反。":[14,433830,13245,1],"我们的友谊已经有二十年了。":[14,447075,12285,1],"我们约好周末见面。":[14,459360,9765,1],"我们认识十年了，偶尔也会吵架，但是我们的友谊一直很好。":[14,469125,30765,1],"我去北京出差，顺便参观了长城。":[14,499890,18765,1],"我去银行取钱，顺便买了点水果。":[14,518655,18645,1],"我喜欢很多运动，例如游泳、跑步等。":[14,537300,23445,1],"我很少喝咖啡，只是偶尔喝一次。":[14,560745,18885,1],"我打电话祝贺她，她开玩笑说：“这些钱正好够请你吃一顿饭。”":[14,579630,32325,1],"我的好朋友小美是一名护士。":[14,611955,13485,1],"我的房间里有很多植物。":[14,625440,12405,1],"我的看法跟你正好相反。":[14,637845,11925,1],"我真笨，又忘记带钥匙了。":[14,649770,16725,1],"我肚子疼，很难受。":[14,666495,12165,1,0.92],"我觉得她的主意很对，决定改一改自己的习惯。":[14,678660,22485,1],"扩大":[14,701145,3645,1,0.85],"护士":[14,704790,4245,1,0.92],"护士让我在这里等一下。":[14,709035,11565,1],"教孩子要有耐心。":[14,720600,9525,1],"有一次，一位老人身体难受，脾气很不好，还批评了她几句。":[14,730125,35805,0],"植物":[14,765930,4005,1,0.85],"民族":[14,769935,4125,1],"汤里盐放多了，太咸了。":[14,774060,14445,1],"生病的时候要多吃水果，例如苹果、香蕉。":[14,788505,24645,1,0.97],"盐":[14,813150,3045,1,0.55],"相反":[14,816195,4485,1],"祝贺":[14,820680,3765,1,0.89],"祝贺你找到了新工作！":[14,824445,10845,1],"这个月公司给每个人发了奖金。":[14,835290,14685,1],"这件事情我已经向经理反映了。":[14,849975,14805,1],"这家公司准备扩大国际市场。":[14,864780,14805,1],"这家公司很重视顾客的意见。":[14,879585,14685,1],"这是个好主意！":[14,894270,8205,1],"这条河很宽。":[14,902475,7965,1],"这里太吵了，我实在受不了。":[14,910440,16365,1],"重视":[14,926805,4245,1,0.94],"长城":[14,931050,4365,1],"难受":[14,935415,4125,1],"顺便":[14,939540,4125,1,0.97],"饮料":[14,943665,3885,1,0.96],"上个月，我和妻子搬进了新家。":[15,0,18525,1,0.93],"不但我喜欢这里，而且我妻子也很喜欢。":[15,18525,21405,1],"为了减肥，她晚上不吃东西。":[15,39930,16365,1],"为了选这个地方，我们商量了很久。":[15,56295,18285,1],"他小时候家里很穷。":[15,74580,10605,1,0.96],"他的脾气很好，从来不生气。":[15,85185,17085,1],"他给我们讲了一个笑话。":[15,102270,10725,1],"代替":[15,112995,4245,1,0.96],"你能把这篇文章翻译一下吗？":[15,117240,13605,1],"信用卡":[15,130845,5205,1,0.97],"健康第一，钱其次。":[15,136050,12645,1],"其次":[15,148695,4245,1],"减肥":[15,152940,4245,1,0.94],"北京是中国的首都。":[15,157185,9885,1],"吃惊":[15,167070,4005,1],"听到这个消息，大家都很吃惊。":[15,171075,17445,1],"周末的时候，公园里往往有很多人。":[15,188520,18645,1],"商量":[15,207165,4245,1,0.94],"地球上大部分地方是海洋。":[15,211410,13965,1],"天气太热了，我走了一会儿就出汗了。":[15,225375,18645,1],"她今天打扮得很漂亮。":[15,244020,11445,0],"妻子的特点是买东西很认真，往往要看好几家店才决定。":[15,255465,28485,1],"孩子最喜欢看狮子和老虎。":[15,283950,13725,1],"家具":[15,297675,4245,1],"对不起，这是我的座位。":[15,301920,14325,1],"对面":[15,316245,3645,1,0.93],"座位":[15,319890,4005,1,0.94],"往往":[15,323895,3885,0,0.93],"我买了一台新的笔记本电脑。":[15,327780,14565,1],"我们下个周末去买家具。":[15,342345,11445,1],"我们公司缺少有经验的人。":[15,353790,13005,1],"我的脾气比较急，可是这次我很有耐心，陪她逛了一整天。":[15,366795,30885,1,0.97],"我租这个房间，首先是便宜，其次是离公司近。":[15,397680,26565,1,0.95],"房间里太热了，开一下窗户吧。":[15,424245,16845,1],"打扮":[15,441090,4005,0],"找工作的时候，我首先考虑兴趣，其次才是工资。":[15,445095,27765,1],"搬完以后，我们去买家具。":[15,472860,14685,1],"搬家那天，天气特别热，我们一边搬东西一边出汗。":[15,487545,28125,1],"新家在城市的东边，对面就是一个公园，窗户外面有几棵大树，风景很美。":[15,515670,40725,1],"最后我们用信用卡买了一个沙发和一个大书架。":[15,556395,20685,1],"有人在敲门，你去看看。":[15,577080,14445,1],"棵":[15,591525,3165,1,0.38],"每个人都有自己的烦恼。":[15,594690,11565,1],"汗":[15,606255,4005,1,0.55],"海洋":[15,610260,4125,1],"烦恼":[15,614385,4245,1,0.97],"特点":[15,618630,4605,1],"狮子":[15,623235,4245,1],"现在，每天晚上我们坐在沙发上阅读，或者稍微看一会儿电视。":[15,627480,34005,1],"电脑不能完全代替老师。":[15,661485,12405,1],"稍微":[15,673890,4245,1],"窗户":[15,678135,4245,1],"笑话":[15,682380,4365,0],"笔记本":[15,686745,4725,1,0.93],"缺少":[15,691470,4125,1,0.93],"翻译":[15,695595,4125,1,0.96],"老虎":[15,699720,4125,1],"能不能稍微便宜一点？":[15,703845,10245,1],"脾气":[15,714090,4125,1],"虽然我们不是很富，但是我觉得我们一点儿也不穷，因为我们有一个温暖的家。":[15,718215,38085,1],"请稍微等一下。":[15,756300,8325,1],"请稍微等一下，我马上就来。":[15,764625,16725,1],"这个地方不但安静，而且交通很方便。":[15,781350,20205,1,0.96],"这个房间不但很大，而且很亮。":[15,801555,17445,1,0.96],"这件事情我要跟妻子商量一下。":[15,819000,15045,1],"这种手机的特点是很轻。":[15,834045,12765,1],"这里可以用信用卡吗？":[15,846810,10245,1],"这里的风景漂亮极了。":[15,857055,10725,1],"银行就在我们公司对面。":[15,867780,11805,1],"门口有两棵大树。":[15,879585,9525,1],"阅读":[15,889110,4245,1,0.94],"阅读可以让我们了解世界。":[15,893355,12645,1],"首先，这里交通方便，离地铁站只有几分钟；其次，价格也比较合适。":[15,906000,41805,0],"首都":[15,947805,4125,1,0.95],"下午回学校以前，老师让我们总结今天学到的东西。":[16,0,26205,1],"中午，我们坐在草地上吃东西，王老师给我们讲了很多关于动物的知识，她说话非常幽默。":[16,26205,47085,1],"乘坐":[16,73290,4245,1,0.95],"乘坐地铁的时候请注意安全。":[16,77535,15285,1],"亲戚":[16,92820,4245,1],"今天学校组织我们去动物园。":[16,97065,14445,1],"今天我高兴极了。":[16,111510,9045,1],"他是一个诚实的人，从来不骗人。":[16,120555,17445,1],"他最大的缺点是太粗心。":[16,138000,12765,1],"他用写日记来练习汉语。":[16,150765,12285,1],"他送给我一朵花。":[16,163050,9165,1],"优点":[16,172215,4125,1,0.9],"会议结束以前，经理做了总结。":[16,176340,17445,1],"你的衣服脏了，换一件吧。":[16,193785,14085,1],"你误会我的意思了。":[16,207870,9045,1],"再忙也要注意身体。":[16,216915,10365,1],"到了动物园，我们先去看老虎。":[16,227280,16845,1],"力气":[16,244125,4365,1],"动物园":[16,248490,4725,1],"动物园里的老虎正在睡觉。":[16,253215,12885,1],"合格":[16,266100,4005,1,0.87],"同情":[16,270105,4125,1],"周末我们去超市逛了逛。":[16,274230,11205,1],"回家以后，我马上写了这篇日记。":[16,285435,18045,1],"大家都很同情他。":[16,303480,9525,1],"天气再冷，他也去跑步。":[16,313005,14925,1],"她站在镜子前面看了很久。":[16,327930,13965,1],"孙子":[16,341895,4245,1,0.94],"孩子看到猴子，高兴极了。":[16,346140,15885,1],"对不起，打扰一下。":[16,362025,12765,1],"师傅":[16,374790,4365,1,0.96],"师傅，去火车站多少钱？":[16,379155,15885,1,0.94],"幽默":[16,395040,4005,1,0.88],"忽然":[16,399045,3885,1,0.92],"忽然，一只小猴子拿走了小明的帽子，小明急得大叫。":[16,402930,29325,1],"总结":[16,432255,4365,1,0.97],"我们去动物园看老虎吧。":[16,436620,11445,1],"我们正在聊天，他忽然站起来走了。":[16,448065,18525,1],"我们的老师很幽默。":[16,466590,9645,1],"我太累了，一点力气也没有了。":[16,476235,16485,1],"我很羡慕你能去中国留学。":[16,492720,13245,1],"我报名参加了学校的网球比赛。":[16,505965,16125,1],"我有写日记的习惯。":[16,522090,9765,1,0.94],"我觉得每种动物都有自己的优点。":[16,531855,16125,1],"打扰":[16,547980,3525,1],"报名":[16,551505,3765,1],"抱歉":[16,555270,4365,1,0.94],"抱歉，让你久等了。":[16,559635,13245,1],"抽烟对身体不好。":[16,572880,9885,1],"接着我们去看猴子，它们跑来跑去，一会儿上树，一会儿下来，大家都笑了。":[16,582765,42165,1],"旁边一位师傅马上过来帮忙，最后帽子拿回来了，可是已经脏了。":[16,624930,34245,1],"日记":[16,659175,4005,1,0.89],"早上七点半，大家在学校门口集合，然后乘坐公共汽车出发。":[16,663180,33525,1],"明天早上八点在学校门口集合。":[16,696705,17205,1],"极其":[16,713910,4245,1],"每个人都有优点和缺点。":[16,718155,11805,1],"爷爷经常带孙子去公园玩。":[16,729960,13485,1],"猴子":[16,743445,4365,1,0.92],"粗心":[16,747810,4125,1,0.97],"缺点":[16,751935,4125,1,0.94],"网球":[16,756060,4245,1],"羡慕":[16,760305,4245,1,0.95],"老虎正躺在地上睡觉，看起来极其安静。":[16,764550,22005,1],"脏":[16,786555,3405,1,0.66],"诚实":[16,789960,4485,1],"误会":[16,794445,4125,1],"起飞":[16,798570,4125,1,0.96],"过年":[16,802695,3645,1,0.93],"过年的时候，我们会去看很多亲戚。":[16,806340,18645,1],"这个问题极其复杂。":[16,824985,10365,1,0.91],"这些食品的质量都合格。":[16,835350,12405,1],"这次考试极其重要。":[16,847755,10125,1],"镜子":[16,857880,4125,1,0.92],"集合":[16,862005,4125,1],"飞机马上就要起飞了。":[16,866130,10845,1],"上个星期，经理通知我去上海出差三天。":[17,0,22005,1],"他不是不想来，而是没有时间。":[17,22005,16845,1],"他太懒了，从来不打扫房间。":[17,38850,16485,1],"他感冒了，一直咳嗽。":[17,55335,13365,1],"他是一个很有礼貌的孩子。":[17,68700,12885,1],"他每次开会都很准时。":[17,81585,11685,1],"他赢了比赛，非常得意。":[17,93270,14325,1],"会议推迟到下个星期了。":[17,107595,11205,1],"传真":[17,118800,4125,1,0.97],"入口":[17,122925,4125,1,0.97],"准时":[17,127050,4365,1,0.96],"出差的时候要多带几双袜子。":[17,131415,15285,1],"别着急，九点出发也来得及。":[17,146700,17085,1,0.94],"别着急，现在出发还来得及。":[17,163785,17685,1,0.95],"到了上海，我准时到了那家公司。":[17,181470,19845,1],"加班":[17,201315,4005,1],"北京的气候比较干燥。":[17,205320,11085,1],"去游泳别忘记带毛巾。":[17,216405,10725,1,0.94],"周末的时候，公园里非常热闹。":[17,227130,16485,1],"咳嗽":[17,243615,4005,1,0.95],"因为时间很少，我当天晚上就开始收拾东西：几件衬衫、几双袜子、一条毛巾，还有一盒饼干。":[17,247620,55485,1],"垃圾桶":[17,303105,5085,1],"大夫":[17,308190,4125,1,0.93],"大夫说我需要多休息。":[17,312315,10845,1],"她太害羞了，脸都红了。":[17,323160,14565,1],"她打算毕业以后读研究生。":[17,337725,13125,1],"她的中文说得非常流利。":[17,350850,12285,1],"害羞":[17,363135,4485,1],"干燥":[17,367620,4005,1],"开会的时候，我按照顺序介绍了我们的计划，大家听完都鼓掌了。":[17,371625,33165,1],"得意":[17,404790,3765,1,0.87],"快走吧，要来不及了。":[17,408555,14205,1],"性别":[17,422760,4125,1],"我下个星期要出差。":[17,426885,10005,1,0.96],"我心里有点儿得意。":[17,436890,9765,1],"我推迟出发，不是因为懒，而是因为生病了。":[17,446655,25365,1],"我饿了，吃了几块饼干。":[17,472020,14925,1,0.97],"握手":[17,486945,4005,1,0.96],"散步":[17,490950,4245,1,0.97],"时间不够了，我们来不及去超市了。":[17,495195,18765,1],"晚上我经常陪爷爷去公园散步。":[17,513960,15645,1],"普遍":[17,529605,3885,1,0.89],"最近工作很忙，我经常加班。":[17,533490,16365,1],"来得及":[17,549855,5085,1,0.96],"毛巾":[17,554940,4125,1,0.97],"气候":[17,559065,4005,1,0.92],"没想到，晚上我开始咳嗽，可能是因为上海的气候比北京湿润，我不太习惯。":[17,563070,44085,1],"流利":[17,607155,3765,1,0.9],"演出结束了，大家热情地鼓掌。":[17,610920,17805,0],"现在年轻人普遍喜欢用手机看新闻。":[17,628725,17925,1],"瓶子":[17,646650,4245,1,0.93],"盒子":[17,650895,4125,1,0.96],"研究生":[17,655020,5325,1,0.92],"礼貌":[17,660345,3765,1],"第二天我去看了大夫，大夫让我多喝水、多休息。":[17,664110,27165,0],"第二天早上，我差点儿来不及去机场，还好航班推迟了半个小时。":[17,691275,33885,1],"虽然这次出差很辛苦，还加了两天班，但是结果很好，我觉得很值得。":[17,725160,40005,1],"袜子":[17,765165,4125,1],"见面的时候，中国人一般握手。":[17,769290,17205,1],"见面的时候，大家互相握手，他们的经理很有礼貌，还给我们准备了热茶。":[17,786495,39885,0],"请从这个入口进。":[17,826380,9765,1],"请写上你的名字、年龄和性别。":[17,836145,18045,1],"请大家按时交作业。":[17,854190,10365,1],"请把瓶子扔进垃圾桶里。":[17,864555,12765,1],"请把这份材料传真给我。":[17,877320,12525,1],"请按照顺序回答问题。":[17,889845,11445,1],"这个盒子里是什么东西？":[17,901290,11685,1],"顺序":[17,912975,4365,1,0.92],"饼干":[17,917340,4245,1,0.9],"一个星期以后，公司通知我去面试。":[18,0,18765,1],"上个月，我在网上看到一家旅游公司正在招聘导游，就马上报了名。":[18,18765,37485,1],"上班的时候经常堵车。":[18,56250,11685,1],"不过他也提醒我，导游工作很辛苦，节日的时候也很少能请假。":[18,67935,35205,1],"乒乓球":[18,103140,5445,1],"今天我请客，大家随便点。":[18,108585,15885,1],"他是经济专业的硕士。":[18,124470,11085,1],"他毕业以后一直在做生意。":[18,135555,12885,1],"他的房间总是很整齐。":[18,148440,11925,1],"你会打乒乓球吗？":[18,160365,9285,1],"你去过长城吗？":[18,169650,8085,1],"你看得出来他多大吗？":[18,177735,10605,1],"做生意":[18,188340,5325,1,0.94],"前面有一个加油站。":[18,193665,10005,1],"加油站":[18,203670,5325,1,0.97],"去中国旅游需要签证吗？":[18,208995,11805,1],"叶子":[18,220800,3885,1,0.96],"听到这个消息，妈妈感动得流泪了。":[18,224685,18045,0],"商店正在打折，东西很便宜。":[18,242730,17205,1],"堵车":[18,259935,4125,1,0.94],"大学毕业以后，我一直想当一名导游。":[18,264060,19845,1],"天气越来越暖和了。":[18,283905,10125,1],"导游":[18,294030,3765,1],"工作经验需要慢慢积累。":[18,297795,12045,1],"我一听就听出来是你了。":[18,309840,11205,1],"我们家的洗衣机坏了。":[18,321045,9885,1],"我们应该节约用水。":[18,330930,9645,1],"我会说好几种语言，还去过十几次长城，可以给客人介绍它的历史。”":[18,340575,37365,1,0.97],"我先认真地写好了表格，又把材料打印出来，寄给了他们。":[18,377940,30285,0],"我爷爷奶奶住在农村。":[18,408225,10605,1],"我生病了，明天想请假。":[18,418830,15045,1],"我说我愿意先积累经验，以后也许自己做生意。":[18,433875,23085,1,0.97],"我说：“我从小在农村长大，喜欢跟不同的人交流。":[18,456960,28125,1],"打":[18,485085,4845,1,0.67],"打印":[18,489930,4005,1],"打折":[18,493935,3765,1],"招聘":[18,497700,4485,1,0.94],"排列":[18,502185,3885,1,0.95],"整齐":[18,506070,4365,0],"暖和":[18,510435,4125,1,0.96],"树上的叶子都黄了。":[18,514560,10005,1,0.93],"洗衣机":[18,524565,5085,1],"流泪":[18,529650,3885,1,0.93],"牙膏":[18,533535,4005,0],"牙膏用完了，别忘记买。":[18,537540,14565,1],"硕士":[18,552105,4365,0,0.94],"积累":[18,556470,3765,1,0.92],"第二天，公司打电话告诉我：我通过了！":[18,560235,25245,0,0.97],"经理听了很满意，还表扬我的回答很有意思。":[18,585480,23085,1],"经理问我：“你为什么想做导游？”":[18,608565,16365,1],"老师在课上表扬了她。":[18,624930,10965,1],"节约":[18,635895,4005,0,0.85],"表格":[18,639900,3765,1,0.91],"西红柿":[18,643665,5685,1,0.91],"西红柿炒鸡蛋是我最喜欢的菜。":[18,649350,15285,1],"请假":[18,664635,4125,1,0.95],"请客":[18,668760,4125,1,0.95],"请把表格打印出来。":[18,672885,10365,1,0.97],"请把这份材料打印一下。":[18,683250,12285,1],"请按照时间顺序排列这些照片。":[18,695535,16245,1],"这个孩子又活泼又可爱。":[18,711780,12045,1],"这个菜太咸了。":[18,723825,8205,1],"这家公司正在招聘导游。":[18,732030,12525,1],"这张表格你写好了吗？":[18,744555,10845,1],"这是我最喜欢的电影之一。":[18,755400,12765,1],"这条路太窄了，公共汽车过不去。":[18,768165,18765,1],"这里的空气太干燥了。":[18,786930,10845,1],"长城是中国最有名的地方之一。":[18,797775,15645,1],"面试那天，路上堵车堵得很厉害，我差点儿迟到。":[18,813420,27765,1],"上课以前要先预习。":[19,0,10845,1],"两百":[19,10845,4005,1,0.92],"个子":[19,14850,3765,1,0.89],"为了保护环境，我们应该少用塑料袋。":[19,18615,19365,1],"为我们的友谊干杯！":[19,37980,9165,1],"九十":[19,47145,4365,1,0.9],"京剧":[19,51510,4245,1,0.95],"人民币":[19,55755,4845,1,0.91],"今天比昨天凉快多了。":[19,60600,11325,1],"他个子很高，喜欢打篮球。":[19,71925,15525,1],"他的汉语说得很流利。":[19,87450,10845,1],"你太粗心了，又写错了一个字。":[19,98295,16845,1],"你要养成经常锻炼的好习惯。":[19,115140,13605,1],"做事情不能马虎。":[19,128745,9765,1,0.96],"养成":[19,138510,4245,1],"凉快":[19,142755,4005,1,0.94],"出发以前，我去大使馆申请了签证，还换了一些人民币。":[19,146760,29565,1],"分之":[19,176325,4245,0,0.87],"刚开始，我的汉语不太流利，上课的时候常常听不懂，只好每天晚上认真预习，遇到不认识的词就查词典。":[19,180570,59445,1],"去年九月，我来到中国留学。":[19,240015,16485,1],"周末我经常和朋友打羽毛球。":[19,256500,14685,1],"售货员":[19,271185,5445,1,0.94],"在老师的帮助下，我养成了每天写日记的习惯，现在已经能用汉语写出几百字的文章了。":[19,276630,42045,1],"塑料袋":[19,318675,5085,1,0.94],"填空":[19,323760,4245,1,0.92],"复印":[19,328005,4005,1,0.88],"大使馆":[19,332010,5085,1,0.97],"她打算毕业以后去中国留学。":[19,337095,14685,1],"寒假":[19,351780,4005,0],"寒假你打算去哪里玩？":[19,355785,11205,1],"寒假的时候，中国朋友请我去他家过年。":[19,366990,21165,1],"干杯":[19,388155,3645,1,0.96],"我们一起包饺子，一起说“干杯”，还看了电视上的京剧表演。":[19,391800,34605,1],"我们班一共有二十一个学生，其中三分之一是亚洲人，其他的同学是从别的国家来的。":[19,426405,42885,1],"我最害怕打针了。":[19,469290,9165,1],"我爷爷最喜欢听京剧。":[19,478455,11205,1,0.93],"我的头发太长了，想去理发。":[19,489660,16125,1],"打针":[19,505785,4485,1],