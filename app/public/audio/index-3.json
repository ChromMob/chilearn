{"files":["h3u01.mp3","h3u02.mp3","h3u03.mp3","h3u04.mp3","h3u05.mp3","h3u06.mp3","h3u07.mp3","h3u08.mp3","h3u09.mp3","h3u10.mp3","h3u11.mp3","h3u12.mp3","h3u13.mp3","h3u14.mp3","h3u15.mp3"],"clips":{"一会儿":[0,0,4005,1],"一般":[0,4005,3765,1,0.96],"七点一刻我从家里出去，坐公共汽车去公司，二十分钟就到了。":[0,7770,33285,1],"下午五点半下班，我一回家就开始做饭。":[0,41055,20925,1],"下班":[0,61980,4245,0],"中午我在公司吃饭，吃完以后休息一会儿。":[0,66225,21045,1],"习惯":[0,87270,4245,1],"他一下班就去跑步。":[0,91515,10125,1],"他总是先喝咖啡，然后开始工作。":[0,101640,19125,1,0.97],"他昨天十点才起床。":[0,120765,10965,1,0.91],"他晚上一般十一点睡觉。":[0,131730,12765,1],"以前":[0,144495,4005,1],"以后":[0,148500,3885,1],"以后十一点以前睡觉吧。":[0,152385,12285,1],"你一般几点起床？":[0,164670,9525,1],"你为什么不吃早饭？":[0,174195,9765,1],"你为什么总是迟到？":[0,183960,9165,1],"你先休息一会儿，再工作吧。":[0,193125,15405,1],"你先休息一会儿，然后再工作。":[0,208530,16605,1],"你早上洗澡一般用多长时间？":[0,225135,14325,1],"出去":[0,239460,4125,1],"刷":[0,243585,3285,1,0.65],"刻":[0,246870,3885,1,0.47],"半":[0,250755,3645,1,0.6],"吃完早饭以后，我去学校。":[0,254400,15525,1,0.97],"吃完饭以后，我经常去跑步。":[0,269925,16965,1],"啊":[0,286890,4125,1],"啊，已经八点了！我要迟到了！":[0,291015,19245,0],"好的，我马上去工作。|m":[0,310260,14445,1],"好，我马上就来！":[0,324705,11445,1],"妈妈六点就起床了。":[0,336150,10245,1],"孩子已经会自己穿衣服了。":[0,346395,12645,1],"对不起，我七点半才起床。|m":[0,359040,17325,1],"对不起，我以后不会再迟到了。":[0,376365,16725,1],"小王":[0,393090,4125,1],"小王，你今天为什么迟到了？":[0,397215,16125,1],"差":[0,413340,3045,1,0.54],"总是":[0,416385,4125,1,0.88],"我一下班就回家。":[0,420510,9165,1,0.97],"我一回家就洗澡。":[0,429675,9285,1,0.96],"我一般七点五十到公司，很少迟到。":[0,438960,18645,1,0.97],"我一般六点半就起床了。昨天晚上我看电影看到一点。|m":[0,457605,29445,1],"我习惯早上喝咖啡。":[0,487050,10845,1,0.96],"我习惯早上洗澡。":[0,497895,9645,1],"我们七点一刻出去吧。":[0,507540,10005,1,0.95],"我先洗澡，然后吃早饭。":[0,517545,14805,1],"我叫王明，在一家公司工作。":[0,532350,16485,1],"我每天早上七点半起床。":[0,548835,12285,1],"我每天早上六点半起床，先洗澡、刷牙，然后吃早饭。":[0,561120,34485,1],"我经常晚上去跑步。":[0,595605,10725,1,0.97],"早饭":[0,606330,4245,0],"星期六和星期天我九点才起床。":[0,610575,16485,1],"晚上我十一点睡觉，睡觉以前总是看一会儿书。":[0,627060,23805,1],"洗澡":[0,650865,4245,1],"然后":[0,655110,4125,1],"现在差一刻八点。":[0,659235,10005,1],"睡觉以前要刷牙。":[0,669240,9765,1],"经常":[0,679005,4245,1],"自己":[0,683250,4005,1,0.96],"迟到":[0,687255,4125,1],"马上":[0,691380,4125,1],"一样":[1,0,3885,1],"今天比昨天冷多了。":[1,3885,10365,1],"今天比较冷，你多穿点衣服。":[1,14250,15885,1],"今天的天气好极了。":[1,30135,9885,1],"他以前很胖，现在瘦了。":[1,40020,15045,1],"他很高，他弟弟更高。":[1,55065,13245,1],"他跟他爸爸一样，特别喜欢运动。":[1,68310,18285,1],"位":[1,86595,2925,1,0.47],"你长得很像你妈妈。":[1,89520,10005,1],"像":[1,99525,3165,1,0.65],"可爱":[1,102690,3885,0,0.93],"哥哥比我大三岁，他跟爸爸一样高，比我高多了。":[1,106575,26925,1],"哥哥非常聪明，学习比我好。":[1,133500,17085,0],"大家都说我长得像妈妈，哥哥长得像爸爸。":[1,150585,21765,1],"头发":[1,172350,4005,1,0.89],"她以前头发很长，现在很短。":[1,176355,17445,1],"她是我们班最聪明的学生。":[1,193800,13365,1],"她是我姐姐。|m":[1,207165,7845,1],"她比你大吗？":[1,215010,6765,1],"她比我大两岁，也比我高一点。|m":[1,221775,16965,1],"她跟你长得特别像！":[1,238740,10125,1],"好看":[1,248865,4245,1],"妈妈比爸爸小两岁，她的头发很短，看上去特别年轻。":[1,253110,30045,1],"年轻":[1,283155,4005,1],"我哥哥比我大三岁。":[1,287160,10365,1,0.96],"我家有爸爸、妈妈、哥哥和我。":[1,297525,19845,1],"我比较矮，也比较瘦。":[1,317370,14205,1],"我比较矮，我弟弟比我还矮。":[1,331575,16485,0],"我没有哥哥那么聪明，但是我比他更喜欢运动。":[1,348060,22365,1],"我没有我哥哥那么高。":[1,370425,9645,1],"我爱我的家人。":[1,380070,7965,1],"我的手机跟你的不一样。":[1,388035,10965,1],"我觉得你比以前年轻了。":[1,399000,11205,1],"我跟我哥哥一样高。":[1,410205,9525,1],"戴":[1,419730,3765,1,0.53],"是吗？很多人都说我们很像。|m":[1,423495,17685,1],"更":[1,441180,3885,1,0.5],"比较":[1,445065,3765,1],"没有":[1,448830,3645,1,0.96],"爸爸五十岁了，很高，有一点胖，戴眼镜。":[1,452475,25845,1],"特别":[1,478320,4005,1,0.97],"相同":[1,482325,4245,1],"眼镜":[1,486570,4125,1],"聪明":[1,490695,4125,1],"胖":[1,494820,3645,1,0.57],"这两个孩子的脸特别像。":[1,498465,12045,1],"这两个手机，你觉得哪个更好看？":[1,510510,17925,1],"这两件衣服的颜色相同。":[1,528435,12165,1],"这个孩子可爱极了！":[1,540600,10125,1,0.96],"这位老师特别年轻。":[1,550725,10125,1],"那个戴眼镜的人是我们老师。":[1,560850,13965,1],"那个戴眼镜的女人是谁？":[1,574815,11565,1],"那么":[1,586380,3645,1],"那位老先生是谁？":[1,590025,9645,1],"上个星期考试，她的汉语成绩不太好，她很不高兴。":[2,0,29325,1],"不客气。你每天都要认真地复习。":[2,29325,19845,0],"他每天都很认真地复习。":[2,49170,12765,0],"他汉语说得很好。":[2,61935,9285,1],"他的字写得很清楚。":[2,71220,10245,1],"他这次的成绩比上次好多了。":[2,81465,14685,1],"作业":[2,96150,3885,1,0.89],"你作业做完了吗？":[2,100035,8325,1],"你复习好了吗？明天就考试了。":[2,108360,16845,1],"你弟弟上几年级？":[2,125205,9045,1],"你明白这个词语的意思吗？":[2,134250,11925,1],"你看见我的铅笔了吗？":[2,146175,10245,1],"努力":[2,156420,3765,1,0.96],"句子":[2,160185,4125,1,0.88],"啊，我明白了！一点也不难。谢谢你！|m":[2,164310,22965,0],"地":[2,187275,3885,1,0.92],"复习":[2,191160,4245,1,0.85],"她学习非常努力。":[2,195405,9405,1],"她学习非常努力，每天晚上都认真地复习。":[2,204810,22845,0],"她最喜欢数学，觉得数学题很容易，但是她觉得汉语比较难。":[2,227655,32205,1],"容易":[2,259860,3885,1,0.9],"年级":[2,263745,4125,1],"慢慢":[2,267870,3765,1],"成绩":[2,271635,4365,1],"我一写完作业就去睡觉。":[2,276000,11805,1],"我已经做完作业了。":[2,287805,9645,1],"我想提高我的数学成绩。":[2,297450,12045,1],"我每天都练习写字。":[2,309495,10125,1,0.97],"我看看。你先看这个句子，明白了吗？":[2,319620,24045,1],"提高":[2,343665,4005,1],"数学":[2,347670,4245,1],"数学太难了，我不喜欢。":[2,351915,14445,1,0.93],"明白":[2,366360,3885,1],"李月明白了老师的意思，现在她每天都练习写字半个小时。":[2,370245,28485,1],"李月是三年级的学生。":[2,398730,10965,1],"校长":[2,409695,4365,1,0.93],"校长在跟老师们说话。":[2,414060,11445,1],"汉语的词语很多，句子也不简单。":[2,425505,17925,1],"清楚":[2,443430,4245,1],"简单":[2,447675,4005,1,0.94],"练习":[2,451680,4245,1],"老师们":[2,455925,4725,1,0.96],"老师告诉她：“你每天练习写字，多读书，成绩就会提高。”":[2,460650,34845,0,0.97],"老师和同学们都为她高兴。":[2,495495,14325,1],"老师的问题你听懂了吗？":[2,509820,11565,1],"老师，黑板上的字我没看清楚。":[2,521385,18165,1],"认真":[2,539550,3885,1],"词语":[2,543435,3885,1,0.86],"请你慢慢地说。":[2,547320,7965,0],"请你慢慢地说，说清楚一点。":[2,555285,16125,0],"请大家看黑板。":[2,571410,8925,1],"还没有。这个数学题太难了，我不明白。|m":[2,580335,25485,1],"这个句子我写错了。":[2,605820,9885,1,0.91],"这个题很简单，谁都会做。":[2,615705,15405,1,0.95],"这次考试不难，比较容易。":[2,631110,15645,1],"这次考试，她的成绩比上次好多了。":[2,646755,19365,1],"铅笔":[2,666120,4005,1],"难":[2,670125,3045,1,0.46],"黑板":[2,673170,4245,1],"上个月我搬家了，很多朋友都来帮忙。":[3,0,20205,1],"上去":[3,20205,4605,1],"今天晚上家里有客人。":[3,24810,11325,1],"他每天都打扫房间。":[3,36135,10365,1],"你把那本书拿给我，好吗？":[3,46500,14805,1],"冰箱":[3,61305,4245,1,0.93],"出去以前请把灯关了。":[3,65550,10965,1],"厨房":[3,76515,4365,1,0.95],"厨房里有一个新冰箱，房间里还有空调。":[3,80880,21285,1],"在几层？有电梯吗？|m":[3,102165,14805,1,0.97],"在十二层，有电梯。我们可以坐电梯把冰箱搬上去。":[3,116970,30045,1],"在学校附近，那里很安静。":[3,147015,15765,1],"声音":[3,162780,4365,1],"大家都说我的新家很漂亮。":[3,167145,13725,1],"太好了。我明天早上八点到。|m":[3,180870,16725,1],"太热了，开一下空调吧。":[3,197595,16605,1],"妈妈正在厨房里做饭。":[3,214200,11445,1],"安静":[3,225645,4125,1],"客人":[3,229770,3765,1,0.96],"客人来以前，我把房间打扫得干干净净，还准备了很多水果。":[3,233535,33045,0],"家里":[3,266580,3885,1],"小张":[3,270465,4485,1],"小张，明天我搬家，你能来帮忙吗？":[3,274950,21525,1],"帮忙":[3,296475,3765,1],"干净":[3,300240,4005,1,0.93],"我下个月要搬家。":[3,304245,8925,1],"我们坐电梯上楼吧。":[3,313170,9645,1,0.96],"我们把冰箱搬到厨房去吧。":[3,322815,12885,1],"我家在六层，没有电梯。":[3,335700,14085,1,0.97],"我家附近有很多饭馆。":[3,349785,11205,1,0.97],"我家附近有很多饭馆和商店，买东西、吃饭都不用走很远。":[3,360990,33645,0],"我已经把房间打扫干净了。":[3,394635,12885,1],"我的邻居是一位老医生。":[3,407520,11445,1],"我的邻居是一位老医生，他人很好，经常跟我说话。":[3,418965,28245,1],"我还没把作业做完。":[3,447210,9765,1],"打扫":[3,456975,4125,1],"把":[3,461100,4605,1,0.75],"搬":[3,465705,4125,1,0.64],"新家不大，但是很干净，也很安静。":[3,469830,21765,1],"新家在五层，楼里有电梯。":[3,491595,15765,1],"旧":[3,507360,2805,1,0.49],"明天你能来帮忙吗？":[3,510165,9645,1],"昨天晚上，我请了几个朋友来我家吃饭。":[3,519810,21285,1],"桌子上放着很多东西。":[3,541095,11685,1],"没问题。你的新家在哪里？|m":[3,552780,16965,1],"灯还开着，他还没睡觉。":[3,569745,14805,1],"电梯":[3,584550,4245,1,0.96],"空调":[3,588795,4125,1],"空调开着，别开门。":[3,592920,12405,1],"请把书放在桌子上。":[3,605325,10485,1],"这个冰箱太旧了，我想买个新的。":[3,615810,17805,1],"这里很安静，我很喜欢。":[3,633615,14685,1],"邻居":[3,648300,4245,1],"邻居家的声音太大了。":[3,652545,11085,1],"附近":[3,663630,4245,1,0.83],"下午我去图书馆借字典，但是那本字典已经被别人借走了。":[4,0,29325,1],"不要拿别人的东西。":[4,29325,9405,1],"他昨天去了北京。":[4,38730,9525,1,0.94],"他请我喝咖啡，我们说了很多以前的事情。":[4,48255,22365,1],"你刚才去哪里了？":[4,70620,9045,1],"你刚才把包放在哪里了？":[4,79665,12165,1],"你怎么了？别着急，慢慢说。":[4,91830,18645,1,0.96],"你还记得我吗？":[4,110475,7245,1],"借":[4,117720,2925,1,0.4],"刚才":[4,120645,4125,1],"别人":[4,124770,3525,1,0.89],"别着急，我们慢慢找。":[4,128295,14565,1],"发现":[4,142860,4365,1,0.93],"啊，你看！我的包在那里！|m":[4,147225,18285,0],"回家的时候，我在路上遇到了一个以前的同学。":[4,165510,23445,1],"图书馆":[4,188955,5205,1,0.9],"在公共汽车上，我突然发现钱包不在包里。":[4,194160,23085,1],"在图书馆，我把包放在桌子上，然后去借书了。|m":[4,217245,27165,1],"坏":[4,244410,4005,1,0.67],"奇怪":[4,248415,3885,1],"字典":[4,252300,3885,1,0.93],"孩子哭了，他怎么了？":[4,256185,12765,1],"小心":[4,268950,4125,1,0.97],"小心！杯子里的水很热。":[4,273075,14805,1],"忘记":[4,287880,4125,1,0.97],"我从图书馆借了两本书。":[4,292005,11925,1],"我们正在跑步，突然下雨了。":[4,303930,15765,1],"我刚才遇到了一个老朋友。":[4,319695,12285,1],"我发现我的钱包不在包里。":[4,331980,13005,1],"我可以借你的字典用一下吗？":[4,344985,13725,1],"我很着急，早饭也没吃就出去了。":[4,358710,18285,1],"我忘记他的名字了。":[4,376995,9645,1,0.97],"我想了一会儿，才记得钱包放在家里的桌子上了。":[4,386640,23805,1],"我找不到我的包了！|m":[4,410445,9645,1],"我没吃过这个菜。":[4,420090,8925,1,0.97],"我的包被人拿走了！":[4,429015,9405,1],"我的字典被别人借走了。":[4,438420,11565,1],"我的电脑被弟弟用坏了。":[4,449985,11325,1],"早上我的手机坏了，我七点半才起床。":[4,461310,20685,1],"昨天是很奇怪的一天。":[4,481995,11445,1,0.97],"是不是":[4,493440,4965,1,0.95],"是不是被别人拿走了？":[4,498405,10845,1],"是不是被别人拿走了？我们去问问吧。":[4,509250,19005,1],"最近":[4,528255,4245,1,0.9],"最近我很忙，没时间看书。":[4,532500,16005,1],"电脑坏了，我的作业都没有了！":[4,548505,16365,1],"真奇怪，他今天为什么没来？":[4,564870,16965,1],"着急":[4,581835,4125,1],"突然":[4,585960,3765,1,0.94],"被":[4,589725,3765,1,0.42],"记得":[4,593490,3885,1,0.89],"这是我昨天最高兴的时候。":[4,597375,12765,1],"这本书你看过没有？":[4,610140,9765,1],"遇到":[4,619905,3765,1,0.93],"钱包":[4,623670,4005,1,0.89],"问问":[4,627675,3885,1],"一直":[5,0,3885,1,0.94],"一直往东走，就是地铁站。":[5,3885,15165,0],"上个星期六，我第一次去朋友小张家。":[5,19050,20925,1,0.97],"下来":[5,39975,4245,1],"不远，走十分钟就到了。|m":[5,44220,15165,1],"中间":[5,59385,3765,1,0.92],"五百":[5,63150,3885,1],"他从包里拿出来一张地图。":[5,67035,13485,1],"他从楼上走下来了。":[5,80520,10365,1],"他家离地铁站很近，是我走错了。":[5,90885,18525,0],"他已经离开北京了。":[5,109410,10125,1],"你什么时候回来？":[5,119535,8565,1],"你有地图吗？我们好像走错了。":[5,128100,16725,1],"你骑过马吗？":[5,144825,7245,1],"出来":[5,152070,4005,1,0.96],"前":[5,156075,4245,1,0.54],"南":[5,160320,3045,1,0.45],"去学校要经过一个医院。":[5,163365,11685,1],"司机":[5,175050,4125,1],"商店在学校和医院中间。":[5,179175,13125,1],"回来":[5,192300,4005,1,0.85],"地图":[5,196305,4005,1,0.9],"地方":[5,200310,3885,1,0.85],"地铁":[5,204195,3885,1,0.88],"地铁比公共汽车快多了。":[5,208080,12285,1],"地铁站":[5,220365,4845,0,0.86],"地铁站就在学校的西边。":[5,225210,12285,0],"地铁站里有洗手间吗？":[5,237495,11325,0,0.97],"好像":[5,248820,4245,1,0.97],"小张给我打电话，告诉我怎么走：“你先坐地铁到东门站，从二号口出来。":[5,253065,39285,0],"往":[5,292350,4845,1,0.63],"往南走五分钟就到了。":[5,297195,10605,1],"快进来吧，别站在门口。":[5,307800,14925,1],"我从地铁站出来以后，不知道哪边是南边，就往西走了。":[5,322725,29325,0],"我家就在一个商店和一个饭馆中间。”":[5,352050,16725,1],"我家离地铁站五百米。":[5,368775,10605,0],"我给小张打电话，他骑自行车来接我。":[5,379380,20445,1],"明天我去机场接你。":[5,399825,10485,1],"有。你一直往前走，经过一个医院，就能看见地铁站了。|m":[5,410310,31365,0],"有，就在二号口旁边。过马路的时候小心一点。|m":[5,441675,27045,0],"洗手间":[5,468720,5565,1,0.97],"然后一直往南走，经过一个医院，过了马路就到了。":[5,474285,26925,1],"离开":[5,501210,3885,1],"离这里远吗？":[5,505095,6765,1],"经过":[5,511860,3885,1,0.9],"街道":[5,515745,4005,1,0.93],"西边":[5,519750,4125,1],"请问":[5,523875,4005,1,0.95],"请问，洗手间在哪里？":[5,527880,13965,1],"请问，附近有地铁站吗？":[5,541845,14445,0],"走了二十分钟，我还没找到。":[5,556290,15645,1],"辆":[5,571935,3765,1,0.42],"过马路的时候要小心。":[5,575700,10965,1],"这个地方我以前来过。":[5,586665,10485,1,0.94],"这里的街道很干净。":[5,597150,10125,1,0.97],"进来":[5,607275,4005,1,0.96],"那个司机开得很快。":[5,611280,9405,0,0.95],"门口":[5,620685,4125,1],"门口有一辆出租车。":[5,624810,10245,1],"马路":[5,635055,4125,1],"一公斤葡萄十二块五角。":[6,0,12765,1],"一碗面条十块钱，又好吃又能吃饱。":[6,12765,19365,1],"中国菜又好吃又便宜，但是菜单上的字她都看不懂，服务员的问题她也听不懂，所以她每次都点面条。":[6,32130,52605,1],"他又饿又累，一回家就睡觉了。":[6,84735,16845,1],"你们":[6,101580,3645,1],"你们吃饱了吗？要不要来点蛋糕？":[6,105225,16845,1],"你会用筷子吗？":[6,122070,7725,1],"你吃得完这碗面条吗？":[6,129795,10485,1],"分":[6,140280,3165,1,0.53],"又":[6,143445,2805,1,0.45],"吃完饭，她还喜欢买一点水果，香蕉、葡萄她都喜欢。":[6,146250,34005,1],"咖啡里要放糖吗？":[6,180255,9165,1],"啤酒":[6,189420,4245,1,0.96],"她经常去学校旁边的一家小饭馆，那里的菜很新鲜，服务员都认识她。":[6,193665,37005,1],"她说：“在中国，我每天都吃得很饱！”":[6,230670,23205,1],"安娜第一次来中国的时候，不会用筷子，吃饭吃得很慢。":[6,253875,30645,0],"您好":[6,284520,4005,1],"您好，这是菜单。你们吃点什么？":[6,288525,20205,1],"我们要两碗面条。有什么喝的？|m":[6,308730,16845,1],"我吃了两碗米饭，吃饱了。":[6,325575,14205,1],"我渴极了，想喝一杯果汁。":[6,339780,14925,1,0.96],"我饱了，真的吃不了了。":[6,354705,14445,1],"我饿了，我们去吃饭吧。":[6,369150,14445,1,0.94],"找你两块三角五分。":[6,383595,10125,1],"新鲜":[6,393720,4365,1],"早上我一般吃面包，喝牛奶。":[6,398085,16365,1],"明天我有事情，去不了。":[6,414450,14085,1],"有果汁、啤酒和茶。":[6,428535,13605,1,0.89],"服务员，来两杯啤酒！":[6,442140,14085,1],"服务员，请把菜单给我们。":[6,456225,15525,1],"来两杯果汁吧。|m":[6,471750,8205,1],"果汁":[6,479955,4005,1,0.89],"现在她已经会用筷子了，也看得懂菜单了。":[6,483960,21645,1],"盘子":[6,505605,4005,1],"真的":[6,509610,4005,1,0.91],"碗":[6,513615,4605,1,0.67],"筷子":[6,518220,4005,1],"老师说得太快，我听不懂。":[6,522225,15045,0],"菜单":[6,537270,4245,1,0.96],"菜太多了，我们吃不完。":[6,541515,14205,1],"葡萄":[6,555720,3885,1],"蛋糕":[6,559605,3525,1],"角":[6,563130,3885,1,0.61],"请再给我一个盘子。":[6,567015,9885,1],"谢谢，我们已经吃饱了，吃不了了。|m":[6,576900,21285,1],"这个蛋糕太甜了。":[6,598185,9405,1,0.95],"这些鸡蛋是今天的，很新鲜。":[6,607590,16365,1,0.95],"这里的水果又新鲜又便宜。":[6,623955,13365,1],"面包":[6,637320,4005,1],"面条":[6,641325,4245,1],"香蕉":[6,645570,4125,1,0.96],"香蕉三块五一公斤。":[6,649695,10365,1],"下雨了，你有伞吗？":[7,0,13485,1],"下雪的北京多么漂亮啊！":[7,13485,11685,1],"下雪的时候，北京多么漂亮啊！":[7,25170,16965,1],"今天天气多么好啊！":[7,42135,9885,1],"今天太阳很好，我们出去走走吧。":[7,52020,18405,1],"今天最低零下五度。":[7,70425,10245,1],"今天的天特别蓝。":[7,80670,9765,1],"但是很多北京人都说，北京的秋天越来越短了。":[7,90435,24525,1],"你最喜欢哪个季节？":[7,114960,10365,1,0.97],"你看，今天的月亮真漂亮！":[7,125325,16125,1],"冬":[7,141450,3765,1,0.46],"冬天":[7,145215,4125,1,0.88],"冬天很冷，有时候零下十几度，但是房间里不冷。":[7,149340,27765,1],"冷极了！今天最低零下十度，还刮风。|m":[7,177105,21765,1],"刮":[7,198870,4005,1,0.58],"北京有四个季节：春天、夏天、秋天和冬天。":[7,202875,29325,1],"北京的春天经常刮风。":[7,232200,11925,1],"北方":[7,244125,4005,1,0.93],"北方的冬天比南方冷多了。":[7,248130,13485,1],"南方":[7,261615,4005,1,0.97],"喂，北京今天天气怎么样？":[7,265620,15045,1],"夏":[7,280665,3165,1,0.66],"夏天":[7,283830,4365,1],"夏天很热，经常下雨，出去的时候包里最好放一把伞。":[7,288195,30885,1],"多么":[7,319080,3405,1,0.85],"天上一点云也没有。":[7,322485,10245,1],"天气越来越冷了。":[7,332730,9165,1],"太阳":[7,341895,4125,1],"好啊":[7,346020,4125,0],"好啊！":[7,350145,4005,0],"季节":[7,354150,4125,1,0.93],"度":[7,358275,3645,1,0.44],"我们这里二十度，太阳很好。":[7,361920,16005,1],"我听人说明天会下雪。":[7,377925,11565,1],"我最喜欢秋天，不冷也不热。":[7,389490,16245,1,0.97],"我越看越喜欢这个地方。":[7,405735,11805,1,0.96],"春天":[7,417540,4365,1,0.96],"春天来了，花都开了。":[7,421905,13485,1],"春天的草是绿的，秋天就黄了。":[7,435390,17565,1],"春天经常刮风，有时候风很大，但是花都开了，非常漂亮。":[7,452955,34725,1],"月亮":[7,487680,3885,1,0.89],"来中国学习汉语的人越来越多。":[7,491565,14925,1],"真好！北方的冬天越来越冷了。|m":[7,506490,18525,1],"秋天":[7,525015,4125,1,0.91],"秋天是北京最好的季节，不冷也不热，天特别蓝，晚上的月亮也很漂亮。":[7,529140,39765,1],"绿":[7,568905,3765,1,0.36],"蓝":[7,572670,4005,1,0.44],"越":[7,576675,2805,1,0.38],"越来越":[7,579480,4725,1,0.94],"这里夏天很热，冬天很冷。":[7,584205,15765,1],"那你春天来我这里玩吧。这里的春天特别漂亮。":[7,599970,23565,1],"雨":[7,623535,4125,1,0.42],"雨越下越大。":[7,627660,7125,1],"零下":[7,634785,4125,1,0.96],"风":[7,638910,3165,1,0.51],"风越刮越大了。":[7,642075,7965,1],"一定":[8,0,3765,1],"七十":[8,3765,4245,1,0.95],"三十九":[8,8010,5685,1,0.96],"三十八":[8,13695,5085,1,0.96],"两天了。昨天晚上三十八度五。|m":[8,18780,17685,0],"从那以后，爸爸每天早上都去跑步，星期六还跟朋友一起去游泳。":[8,36465,36165,1],"他七十岁了，身体还很健康。":[8,72630,16965,1],"他发烧三十九度，需要马上去医院。":[8,89595,19125,1],"他每天在公司坐八个小时，回家以后就看电视。":[8,108720,24885,1],"他还少喝啤酒，多吃水果。":[8,133605,16485,1],"作用":[8,150090,4005,1,0.89],"你一定要去医院检查一下。":[8,154095,11925,1],"你哪里不舒服？":[8,166020,7845,1],"你应该多喝水，多休息。":[8,173865,14325,0,0.97],"健康":[8,188190,4245,1,0.96],"别担心，我已经好多了。":[8,192435,15525,1],"医生给他检查了身体，说：“你的身体没有大问题，但是你需要多锻炼。":[8,207960,37125,1],"医生说我需要休息两天。":[8,245085,12165,1],"医生说没问题，你放心吧。":[8,257250,15165,1],"去年冬天，他感冒了好几次，腿和脚也经常疼。":[8,272415,27525,1],"发烧":[8,299940,4245,1],"发烧几天了？":[8,304185,7005,1],"只":[8,311190,4485,1,0.34],"只要":[8,315675,3885,1],"只要你每天锻炼，身体就会越来越好。":[8,319560,20445,1],"只要多休息，你的感冒就会好。":[8,340005,17085,0],"天气冷了，注意别感冒。":[8,357090,14205,1],"如果":[8,371295,3885,1,0.88],"如果你不舒服，就回家休息吧。":[8,375180,16845,1,0.97],"如果你每天走路半个小时，身体就会好很多。”":[8,392025,23805,1],"如果明天下雨，我们就不去了。":[8,415830,16365,1],"应该":[8,432195,3885,0],"感冒":[8,436080,3525,1],"感冒的时候不应该喝啤酒。":[8,439605,14445,1],"我们都很担心他。":[8,454050,8805,1],"我发烧了，鼻子也不舒服。|m":[8,462855,15045,1],"我只吃了一点东西。":[8,477900,9885,1,0.96],"我感冒了，鼻子很不舒服。":[8,487785,15165,1],"我有点发烧，身体很不舒服。":[8,502950,17085,1],"我每天早上锻炼半个小时。":[8,520035,13365,1],"我爸爸工作很忙，以前很少锻炼。":[8,533400,19125,1],"我的脚疼了一个星期了。":[8,552525,10845,1],"我的腿很疼，走不了路。":[8,563370,14445,1,0.97],"我给你检查一下。你感冒了，不用担心。":[8,577815,22725,1],"我耳朵疼，听不清楚。":[8,600540,13125,0],"我需要吃药吗？|m":[8,613665,7845,1],"担心":[8,621510,4245,1],"放心":[8,625755,4365,1,0.92],"有点":[8,630120,4125,1,0.87],"检查":[8,634245,4245,0,0.97],"注意":[8,638490,3885,1,0.91],"爸爸经常说：“只要每天锻炼，身体就会越来越健康。”":[8,642375,28965,1],"现在爸爸很少感冒，我们都放心了。":[8,671340,19365,1],"耳朵":[8,690705,4005,1,0.97],"脚":[8,694710,3885,1,0.64],"舒服":[8,698595,4245,1,0.97],"这个药没什么作用。":[8,702840,9285,1],"锻炼":[8,712125,3645,1,0.92],"需要":[8,715770,4005,1],"需要。这个药一天吃三次。只要好好休息，几天就会好。":[8,719775,33405,1],"鼻子":[8,753180,3885,1],"一共":[9,0,3885,1,0.96],"万":[9,3885,3765,1,0.59],"三百五十":[9,7650,6765,1],"三百八十":[9,14415,6765,1],"三百八十块。除了鞋以外，您还需要别的吗？":[9,21180,24765,1],"不用了，谢谢。可以刷卡吗？|m":[9,45945,20445,1,0.92],"以外":[9,66390,3765,0],"你喜欢穿裙子还是裤子？":[9,70155,13485,1],"你来看看这双鞋怎么样。":[9,83640,11445,1],"你要红的还是白的？":[9,95085,10005,1],"其他":[9,105090,3885,1],"其他的颜色都卖完了。":[9,108975,11085,1],"别的":[9,120060,3885,1,0.84],"卡":[9,123945,4965,1,0.65],"可以刷卡吗？":[9,128910,7125,1],"商店里的衣服很多，有红的、白的、黑的，还有黄的。":[9,136035,35445,1,0.97],"在超市里，妈妈问我：“晚上吃面条还是米饭？”":[9,171480,25845,1],"好的。这双呢？":[9,197325,10485,1,0.9],"妈妈想给我买一条裙子，但是我更喜欢穿裤子。":[9,207810,24765,1],"妈妈问我：“你满意了吧？”":[9,232575,13605,1],"帽子":[9,246180,4125,1,0.97],"您好，您想买什么？":[9,250305,12525,1],"您看看这双怎么样？这种鞋卖得特别好。":[9,262830,20685,0],"想想":[9,283515,4365,1,0.91],"我们星期六或者星期天去买衣服吧。":[9,287880,16965,1],"我可以试试吗？……有点小，能换一双大一点的吗？|m":[9,304845,25485,1],"我可以试试这件衬衫吗？":[9,330330,11685,1,0.97],"我想买一双鞋。|m":[9,342015,8685,1],"我想想，明天再来买吧。":[9,350700,16485,1],"我要去银行换钱。":[9,367185,9285,1],"我试了好几条裤子，才找到一条又便宜又舒服的。":[9,376470,25245,1],"我说：“满意极了！”":[9,401715,11565,1],"我说：“面条或者米饭都可以。”":[9,413280,17205,1],"星期天":[9,430485,5445,1],"星期天下午，我和妈妈去商店买衣服。":[9,435930,20925,1],"条":[9,456855,3285,1,0.45],"满意":[9,460140,4005,1],"然后我们去超市买了一些水果和面包。":[9,464145,17085,1],"种":[9,481230,3885,1,0.65],"累了就好好休息休息。":[9,485115,11205,1],"衬衫":[9,496320,4125,1],"裙子":[9,500445,4245,1,0.89],"裤子":[9,504690,4245,1,0.93],"试试":[9,508935,4365,1,0.97],"超市":[9,513300,4365,1,0.96],"超市里东西很多，也很便宜。":[9,517665,16845,1],"这个帽子是我妈妈给我买的。":[9,534510,13485,1],"这些东西一共三百五十块。":[9,547995,13485,1],"这件衣服一万块？太贵了！":[9,561480,14565,1],"这件衣服你满意吗？":[9,576045,9885,1],"这双很舒服，我很满意。多少钱？|m":[9,585930,21525,1,0.97],"这双鞋太小了，能换一双吗？":[9,607455,16125,1],"这条裙子多少钱？":[9,623580,9765,1,0.97],"这条裤子有点长，有短一点的吗？":[9,633345,18165,0],"这种帽子有没有黑的？":[9,651510,10365,1],"银行":[9,661875,4005,1],"除了":[9,665880,4125,1,0.96],"除了我以外，大家都去了。":[9,670005,14805,1],"除了衬衫以外，我还买了一条裤子。":[9,684810,18765,1],"除了裤子以外，妈妈还给我买了一件衬衫和一双鞋，一共花了六百多块钱。":[9,703575,36765,1],"上个月，我们一起在学校表演了一个节目，大家都很喜欢。":[10,0,31965,1],"不但":[10,31965,3405,1,0.92],"什么表演":[10,35370,6285,1],"什么表演？":[10,41655,6285,1],"他一边听音乐，一边做作业。":[10,47940,16605,1],"他不但会画画，而且画得很好。":[10,64545,17805,0],"他不但喜欢唱歌，而且喜欢跳舞。":[10,82350,19485,1],"他不敢一个人晚上出去。":[10,101835,11445,1],"体育":[10,113280,4005,1],"你别总是玩游戏。":[10,117285,9285,1],"你敢一个人去爬山吗？":[10,126570,10845,1],"你有什么爱好？":[10,137415,7485,1],"你看，这是我去年夏天的照片。":[10,144900,17445,1],"你能教我游泳吗？":[10,162345,8685,1],"兴趣":[10,171030,4365,1],"去年我参加了学校的画画比赛，老师们都说我画得不错。":[10,175395,28005,0],"参加":[10,203400,4005,1,0.97],"周末":[10,207405,4005,1,0.86],"周末你想做什么？":[10,211410,8925,1],"周末我经常一边听音乐，一边画画。":[10,220335,19605,1],"太好了！晚上我们还可以去看一个表演。|m":[10,239940,20925,1],"孩子们":[10,260865,4965,1,0.94],"孩子们在学校表演了一个节目。":[10,265830,14325,1],"当然":[10,280155,3405,1],"当然可以，我明天教你。":[10,283560,14205,1],"当然！我最喜欢爬山了。我们可以一边爬山，一边说话。":[10,297765,32685,1],"感":[10,330450,4725,1,0.59],"我们一边爬山，一边说话。":[10,335175,15405,1],"我叫大卫，在北京学习汉语。":[10,350580,16485,1],"我对中国音乐也很感兴趣，所以我的中国朋友小李每个星期都教我唱歌。":[10,367065,35565,1],"我对中国音乐很感兴趣。":[10,402630,12765,1],"我对画画没有兴趣。":[10,415395,9765,1,0.95],"我弟弟很喜欢玩电子游戏。":[10,425160,13005,1],"我想买一个新照相机。":[10,438165,10965,1],"我想去爬山。你对爬山感兴趣吗？|m":[10,449130,19005,1],"我最喜欢上体育课。":[10,468135,10485,1,0.94],"我的爱好很多：听音乐、画画、爬山，还有玩电子游戏。":[10,478620,34485,0],"我的爱好是爬山和听音乐。":[10,513105,13005,1],"我觉得有爱好的人不但每天都很快乐，而且身体也很健康。":[10,526110,30405,1],"我还喜欢爬山，北京附近有很多地方可以爬山，我的照相机里有很多爬山的照片。":[10,556515,43125,1],"教":[10,599640,3165,1,0.55],"明天的比赛你参加吗？":[10,602805,11205,1],"是一个音乐节目。我的朋友也参加了，他不但会唱歌，而且还会跳舞。|m":[10,614010,38565,1],"比赛":[10,652575,4005,1],"游戏":[10,656580,4125,1,0.91],"照片":[10,660705,4365,1],"照相机":[10,665070,5205,1,0.95],"爬山":[10,670275,4125,1],"爱好":[10,674400,4125,0],"电子":[10,678525,3765,1,0.91],"画":[10,682290,3165,1,0.61],"画画":[10,685455,4245,0],"而且":[10,689700,4005,1,0.95],"节目":[10,693705,3885,1,0.84],"表演":[10,697590,3765,1,0.92],"这个周末你想做什么？":[10,701355,10725,1],"这个电视节目很有意思。":[10,712080,12165,1],"这次比赛我们班得了第一。":[10,724245,12645,1],"音乐":[10,736890,4005,1],"上个月，经理给了我一个机会，让我一个人完成一个重要的工作。":[11,0,33045,1],"上午九点。这个会议很重要，你必须参加。|m":[11,33045,24285,1],"下午三点有一个重要的会议。":[11,57330,13245,1],"为了":[11,70575,3645,1],"为了学习汉语，他来了中国。":[11,74220,15645,1],"为了找到这个工作，我准备了很长时间。":[11,89865,20445,1,0.96],"为了身体健康，我每天都锻炼。":[11,110310,16965,1],"主要":[11,127275,3885,1,0.92],"主要是关于买新电脑的事情。我们要选择一家公司。|m":[11,131160,26925,1],"他决定离开这家公司。":[11,158085,11325,1,0.95],"会议":[11,169410,4125,1,0.97],"会议主要说什么？":[11,173535,8685,1],"会议几点结束？":[11,182220,8325,1],"你先看看哪家公司的电脑又好又便宜。|m":[11,190545,19845,1],"你是什么时候来的？":[11,210390,9165,1,0.97],"你有什么好办法吗？":[11,219555,9525,1],"信":[11,229080,3165,1,0.44],"关于":[11,232245,3765,1,0.97],"关于这件事情，我们明天再说吧。":[11,236010,17805,1],"决定":[11,253815,4125,1,0.81],"办公室":[11,257940,5085,1,0.92],"办法":[11,263025,4125,1,0.96],"同事":[11,267150,4245,1,0.93],"同事们教我怎么解决问题，我也每天认真地学习。":[11,271395,24885,0],"在会议上，经理说我做得很好。":[11,296280,17445,0],"好的。我需要准备什么？":[11,313725,14085,1,0.96],"完成":[11,327810,4245,1],"开始工作的时候，我遇到了很多问题，每天都很着急。":[11,332055,29205,1],"张经理，明天的会议是几点？":[11,361260,17925,1],"必须":[11,379185,4125,1,0.93],"我不知道应该选择哪个。":[11,383310,11805,1],"我们公司主要卖电脑。":[11,395115,10485,1],"我们公司主要卖电脑和手机。":[11,405600,14085,1],"我们必须今天把这件事情做完。":[11,419685,14685,1],"我们必须在星期五以前完成。":[11,434370,14565,1],"我和同事经常一起吃饭。":[11,448935,12885,1,0.94],"我很高兴我选择了这家公司。":[11,461820,14205,1],"我是去年九月来这家公司工作的。":[11,476025,16245,1],"我是坐地铁来的。":[11,492270,8925,0,0.97],"我的同事都很年轻，也很聪明，我们经常一起吃饭。":[11,501195,27645,1],"我的经理姓张，他对工作要求很高，但是人很好。":[11,528840,27525,1],"我认为这个办法很好。":[11,556365,10845,1,0.95],"星期五":[11,567210,5445,1],"机会":[11,572655,3885,1,0.97],"没问题，我今天下午就能完成。":[11,576540,17805,1,0.97],"终于":[11,594345,3765,1,0.97],"经理":[11,598110,3885,1,0.95],"经理现在不在办公室。":[11,601995,11445,1],"经理要求我们八点以前到公司。":[11,613440,15045,1],"结束":[11,628485,4245,1,0.88],"要求":[11,632730,4245,1],"解决":[11,636975,4125,1,0.89],"认为":[11,641100,4005,1],"这个工作我们终于完成了！":[11,645105,12525,1],"这个问题已经解决了。":[11,657630,10725,1,0.97],"这是一个很好的机会。":[11,668355,10605,1],"这是一本关于中国的书。":[11,678960,11685,1],"这是谁给你的信？":[11,690645,9165,1,0.96],"选择":[11,699810,4245,1],"那几天我每天都工作到晚上九点，终于完成了。":[11,704055,24525,1],"重要":[11,728580,4005,1,0.94],"上个月我感冒了，一个人在家，很难过。":[12,0,22725,1],"下个星期是奶奶的生日，我们送她什么礼物？":[12,22725,21525,1],"他们":[12,44250,3645,1],"他们结婚十年了。":[12,47895,9405,1],"他忙得连饭都没时间吃。":[12,57300,12525,1],"以为":[12,69825,3765,1],"你愿意跟我结婚吗？":[12,73590,9525,1],"你说得对。那我们星期六去看她吧，再给她买一个蛋糕。":[12,83115,28605,0],"你跟他是什么关系？":[12,111720,9165,1],"八十":[12,120885,4365,1],"关心":[12,125250,4125,1,0.92],"关系":[12,129375,4125,1,0.92],"其实":[12,133500,4125,1],"其实奶奶最希望我们去看看她。虽然她不说，但是她很想我们。|m":[12,137625,34245,1],"别生气了，他已经说对不起了。":[12,171870,16725,1,0.96],"叔叔":[12,188595,4245,1,0.97],"同意":[12,192840,4005,1,0.95],"奶奶":[12,196845,4005,1],"奶奶生病了，妈妈在医院照顾她。":[12,200850,18045,1],"她很关心别人，连楼里每家人的名字她都记得。":[12,218895,24165,1],"好！爷爷也一定会很高兴。|m":[12,243060,16365,0],"害怕":[12,259425,4125,1,0.95],"张阿姨六十多岁了，对人非常热情。":[12,263550,19605,1],"张阿姨知道以后，每天都给我送饭，还经常来照顾我。":[12,283155,29205,1],"感冒好了以后，我买了一个礼物送给她。":[12,312360,19845,1],"愿意":[12,332205,4005,1],"我以为他是老师，其实他是学生。":[12,336210,18285,1],"我以为你不来了！":[12,354495,8325,1],"我以为你已经买好了！|m":[12,362820,10845,1],"我们很长时间没见面了。":[12,373665,11565,1],"我妹妹很害怕狗。":[12,385230,9645,1],"我想给她钱，她不同意，说：“你别给我钱，我们是邻居！”":[12,394875,32925,1],"我搬到这里以后，认识了邻居张阿姨。":[12,427800,19845,1],"我爷爷八十岁了，身体还很好。":[12,447645,17685,1],"我相信你一定能做好。":[12,465330,10725,1,0.97],"朋友要离开北京了，我很难过。":[12,476055,17205,1],"热情":[12,493260,4245,1,0.95],"照顾":[12,497505,4005,1,0.94],"爷爷":[12,501510,3885,1],"爸爸妈妈不同意我一个人去旅游。":[12,505395,15645,1],"现在我们的关系就像一家人一样。":[12,521040,16485,1],"生气":[12,537525,4485,1],"相信":[12,542010,4365,1,0.97],"礼物":[12,546375,3885,1],"祝":[12,550260,3885,1,0.47],"祝你生日快乐！":[12,554145,8085,1],"结婚":[12,562230,4005,1,0.88],"虽然下雨了，但是他还是来了。":[12,566235,17325,1],"虽然他很忙，但是他经常给我打电话。":[12,583560,20685,1],"虽然她已经不工作了，但是每天都很忙：早上去锻炼身体，下午去学校接孩子。":[12,604245,43365,1],"见面":[12,647610,4005,1,0.92],"谢谢你的关心。":[12,651615,8205,1],"还没有。奶奶好像什么都有。":[12,659820,16365,1],"这是我送给你的礼物。":[12,676185,9885,1],"这里的人都很热情。":[12,686070,10125,1],"连我奶奶都会用手机了。":[12,696195,11925,1],"阿姨":[12,708120,4125,1],"阿姨，您好！张叔叔在家吗？":[12,712245,19245,1],"难过":[12,731490,4005,1],"三千":[13,0,4245,1,0.93],"不用，谢谢。请问，这几天有什么节日吗？|m":[13,4245,28125,1],"世界":[13,32370,4125,1],"中国人":[13,36495,5445,1,0.93],"中秋节":[13,41940,5325,1,0.96],"中秋节是中国很重要的节日，这一天，家里人都要回家见面。":[13,47265,34725,1],"举行":[13,81990,4245,0,0.91],"久":[13,86235,3645,1,0.58],"了解":[13,89880,4125,1,0.96],"他普通话说得跟中国人一样好。":[13,94005,15645,0],"他的汉语水平提高得很快。":[13,109650,13005,1],"他笑了笑，表示同意。":[13,122655,13245,1],"你在中国住了多久了？":[13,135900,10485,1],"北京有三千多年的历史。":[13,146385,11925,1],"历史":[13,158310,4365,1,0.96],"去别的国家旅游，一定要带护照。":[13,162675,18285,1],"去年九月，她的朋友小李请她去家里过中秋节。":[13,180960,25605,0],"国家":[13,206565,3885,1,0.81],"太好了！我一直想了解中国的节日文化。|m":[13,210450,20685,1],"她很喜欢中国文化，一直想多了解一下中国人的节日。":[13,231135,26925,1],"她觉得这个节日既有意思又让人快乐。":[13,258060,18645,1],"好的，这是我的护照。|m":[13,276705,13605,1],"学校每年都举行一次体育比赛。":[13,290310,14325,1],"安娜来中国已经一年了。":[13,304635,11565,1],"家人":[13,316200,4005,1],"宾馆":[13,320205,3765,1,0.89],"对孩子来说，这个故事有点难。":[13,323970,17085,1],"对安娜来说，这是她第一次在中国人家里过中秋节。":[13,341055,26445,1],"对我来说，普通话不太难。":[13,367500,15045,1],"小李的奶奶给安娜讲了一个关于月亮的故事。":[13,382545,19485,1],"您好，欢迎！请给我看一下您的护照。":[13,402030,22365,1],"您的房间在八层。需要我们把行李箱送上去吗？":[13,424395,24525,1],"我一次也没去过那个国家。":[13,448920,12165,1],"我一点也不累。":[13,461085,7605,1],"我想了解中国文化。":[13,468690,10125,1],"我想去世界上很多国家看看。":[13,478815,15765,1],"护照":[13,494580,4005,1,0.94],"故事":[13,498585,3885,1,0.87],"文化":[13,502470,4245,1,0.85],"既":[13,506715,3885,1,0.4],"明天是中秋节。晚上很多人会和家人一起看月亮。":[13,510600,26325,1],"春节":[13,536925,4245,1],"春节是中国最重要的节日。":[13,541170,14205,1],"晚上，大家坐在一起，一边吃东西一边看月亮。":[13,555375,28005,1],"普通话":[13,583380,5205,1,0.96],"有名":[13,588585,3885,0,0.94],"来说":[13,592470,4125,1],"根据":[13,596595,4005,1,0.91],"根据地图，宾馆就在前面。":[13,600600,15285,1],"水平":[13,615885,4365,1,0.94],"爷爷经常给我讲故事。":[13,620250,10965,1,0.95],"节日":[13,631215,4005,1,0.86],"虽然有的地方安娜听不懂，但是她很喜欢这个故事。":[13,635220,26325,1],"行李箱":[13,661545,5205,1,0.92],"表示":[13,666750,4245,1,0.95],"过去":[13,670995,3885,1,0.85],"过去她只在书上读过关于中国的故事，现在她觉得自己真的开始了解中国了。":[13,674880,38085,1],"过去这里只有几家商店。":[13,712965,11805,1,0.97],"这个节日既有意思又让人快乐。":[13,724770,15285,1],"这个行李箱是谁的？":[13,740055,9765,1,0.94],"这家宾馆既干净又便宜。":[13,749820,12045,1],"这家饭馆非常有名。":[13,761865,10485,1],"这次旅游你带了几个行李箱？":[13,772350,13485,1],"这段时间我很忙。":[13,785835,9885,1],"上网":[14,0,4365,1],"不一定。这里工作机会多，买东西也方便，但是环境不太好。|m":[14,4365,38325,0],"为了使城市的环境更好，最近几年，城市里出现了很多新公园和花园，河边也种了很多树。":[14,42690,48045,1],"人们几乎每天都上网，用手机买东西、看新闻。":[14,90735,26445,1],"他家有一个小花园。":[14,117180,10005,1],"以前是。现在我觉得只有环境好，人才会健康快乐。|m":[14,127185,30285,1],"但是城市大了，车也多了，环境比过去差了。":[14,157470,25485,1],"住在这里买东西很方便。":[14,182955,12405,1],"你一般上网做什么？":[14,195360,9885,1],"你不是最喜欢大城市吗？":[14,205245,12285,1],"你不是说今天要来吗？":[14,217530,10845,1],"你在北京看过熊猫吗？":[14,228375,11205,1],"你打算一直住在这个城市吗？":[14,239580,13725,1],"使":[14,253305,3645,1,0.46],"公园":[14,256950,3765,1],"公园让这个城市更漂亮了。":[14,260715,14205,1],"公园里有很多树和花。":[14,274920,11085,1],"几乎":[14,286005,4005,1],"出现":[14,290010,4245,1,0.97],"动物":[14,294255,3405,1,0.93],"变化":[14,297660,4125,1,0.88],"只有":[14,301785,3885,1,0.92],"只有你去，他才会去。":[14,305670,13365,1],"只有多练习，才能说好汉语。":[14,319035,16365,1],"只有大家都关心环境，城市才会越来越漂亮。":[14,335400,23445,1],"听到":[14,358845,3765,1,0.96],"城市":[14,362610,4485,1],"城市里出现了很多新公园。":[14,367095,14565,1],"天气不好会影响我们的比赛。":[14,381660,14205,0],"影响":[14,395865,4245,1,0.95],"我们不是朋友吗？":[14,400110,8325,1],"我几乎每天都上网。":[14,408435,10245,1,0.96],"我在这个城市住了二十年了，这些年城市的变化非常大。":[14,418680,28485,1],"我打算以后一直住在这里。":[14,447165,12645,1],"我打算以后住在一个小城市，那里有河，有树，还能听到鸟叫。|m":[14,459810,36165,0],"我每天早上都看新闻。":[14,495975,11325,1],"我相信，只有大家都关心环境，我们的城市才会越来越漂亮。":[14,507300,34965,1],"打算":[14,542265,4125,1],"新闻":[14,546390,4125,1],"方便":[14,550515,4245,1,0.88],"是啊，车越来越多，公园越来越少。":[14,554760,21045,1],"树":[14,575805,3045,1,0.45],"树上有两只鸟。":[14,578850,8925,1],"河边有很多人在跑步。":[14,587775,11565,1],"河里的鱼越来越少，树上也几乎看不到鸟了。":[14,599340,22845,1],"熊猫":[14,622185,4125,1,0.9],"熊猫是一种很可爱的动物。":[14,626310,13365,1],"环境":[14,639675,4365,1,0.96],"现在，河里又有鱼了，树上的鸟也多了。":[14,644040,22965,1],"花园":[14,667005,4245,1],"车":[14,671250,3285,1,0.42],"边":[14,674535,4005,1,0.44],"过去这里只有几条街道，几乎没有高楼；现在高楼越来越多，地铁也越来越多，去哪里都很方便。":[14,678540,51765,1],"这个周末你打算做什么？":[14,730305,11565,1],"这个城市的变化太大了！":[14,741870,12045,1],"这个问题很简单，谁不会啊？":[14,753915,16005,0],"这件事情使我很难过。":[14,769920,11565,0],"这几年，城市里的车越来越多。":[14,781485,18165,1]}}