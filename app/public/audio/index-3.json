{"files":["h3u01.mp3","h3u02.mp3","h3u03.mp3","h3u04.mp3","h3u05.mp3","h3u06.mp3","h3u07.mp3","h3u08.mp3","h3u09.mp3","h3u10.mp3","h3u11.mp3","h3u12.mp3","h3u13.mp3","h3u14.mp3","h3u15.mp3"],"clips":{"一会儿":[0,0,4725,1],"一般":[0,4725,4485,1,0.87],"七点一刻我从家里出去，坐公共汽车去公司，二十分钟就到了。":[0,9210,33285,1,0.9],"下午五点半下班，我一回家就开始做饭。":[0,42495,21645,1,0.88],"下班":[0,64140,5325,1],"中午我在公司吃饭，吃完以后休息一会儿。":[0,69465,21765,1],"习惯":[0,91230,4245,1,0.9],"他一下班就去跑步。":[0,95475,10845,1],"他总是先喝咖啡，然后开始工作。":[0,106320,19845,1],"他昨天十点才起床。":[0,126165,11685,1],"他晚上一般十一点睡觉。":[0,137850,13485,1],"以前":[0,151335,4725,1],"以后":[0,156060,4605,1,0.94],"以后十一点以前睡觉吧。":[0,160665,13005,1,0.97],"你一般几点起床？":[0,173670,10245,1,0.97],"你为什么不吃早饭？":[0,183915,10485,1,0.9],"你为什么总是迟到？":[0,194400,9885,1,0.88],"你先休息一会儿，再工作吧。":[0,204285,16125,1],"你先休息一会儿，然后再工作。":[0,220410,17325,1],"你早上洗澡一般用多长时间？":[0,237735,15045,1],"出去":[0,252780,4845,1,0.93],"刷":[0,257625,3285,1,0.59],"刻":[0,260910,3885,1,0.43],"半":[0,264795,3645,1,0.55],"吃完早饭以后，我去学校。":[0,268440,16245,1],"吃完饭以后，我经常去跑步。":[0,284685,17685,1],"啊":[0,302370,4125,1,0.93],"啊，已经八点了！我要迟到了！":[0,306495,21645,1,0.79],"好的，我马上去工作。|m":[0,328140,15165,1],"好，我马上就来！":[0,343305,12165,1],"妈妈六点就起床了。":[0,355470,10965,1],"孩子已经会自己穿衣服了。":[0,366435,13365,1],"对不起，我七点半才起床。|m":[0,379800,18045,1],"对不起，我以后不会再迟到了。":[0,397845,17445,1,0.95],"小王":[0,415290,4845,1],"小王，你今天为什么迟到了？":[0,420135,16845,1],"差":[0,436980,3045,1,0.49],"总是":[0,440025,4845,1,0.88],"我一下班就回家。":[0,444870,9885,1,0.81],"我一回家就洗澡。":[0,454755,9285,1,0.88],"我一般七点五十到公司，很少迟到。":[0,464040,19365,1],"我一般六点半就起床了。昨天晚上我看电影看到一点。|m":[0,483405,30165,1],"我习惯早上喝咖啡。":[0,513570,11565,1,0.89],"我习惯早上洗澡。":[0,525135,10365,1,0.97],"我们七点一刻出去吧。":[0,535500,10725,1],"我先洗澡，然后吃早饭。":[0,546225,15525,1],"我叫王明，在一家公司工作。":[0,561750,17205,1],"我每天早上七点半起床。":[0,578955,13005,1],"我每天早上六点半起床，先洗澡、刷牙，然后吃早饭。":[0,591960,35205,1,0.89],"我经常晚上去跑步。":[0,627165,11445,1,0.92],"早饭":[0,638610,4965,1],"星期六和星期天我九点才起床。":[0,643575,17205,1],"晚上我十一点睡觉，睡觉以前总是看一会儿书。":[0,660780,24525,1],"洗澡":[0,685305,4245,1,0.97],"然后":[0,689550,4845,1,0.78],"现在差一刻八点。":[0,694395,10725,1],"睡觉以前要刷牙。":[0,705120,10485,1],"经常":[0,715605,4965,1],"自己":[0,720570,4725,1,0.83],"迟到":[0,725295,4845,1,0.93],"马上":[0,730140,4845,1],"一样":[1,0,3885,1,0.95],"今天比昨天冷多了。":[1,3885,11085,1,0.95],"今天比较冷，你多穿点衣服。":[1,14970,16605,1],"今天的天气好极了。":[1,31575,10605,1,0.88],"他以前很胖，现在瘦了。":[1,42180,15765,1],"他很高，他弟弟更高。":[1,57945,13965,1],"他跟他爸爸一样，特别喜欢运动。":[1,71910,19005,1],"位":[1,90915,2925,1,0.43],"你长得很像你妈妈。":[1,93840,10725,1,0.96],"像":[1,104565,3165,1,0.59],"可爱":[1,107730,4605,1,0.81],"哥哥比我大三岁，他跟爸爸一样高，比我高多了。":[1,112335,26925,1],"哥哥非常聪明，学习比我好。":[1,139260,17805,1],"大家都说我长得像妈妈，哥哥长得像爸爸。":[1,157065,22485,1],"头发":[1,179550,4725,1,0.85],"她以前头发很长，现在很短。":[1,184275,18165,1],"她是我们班最聪明的学生。":[1,202440,14085,1],"她是我姐姐。|m":[1,216525,8565,1],"她比你大吗？":[1,225090,7485,1],"她比我大两岁，也比我高一点。|m":[1,232575,17685,1],"她跟你长得特别像！":[1,250260,10845,1],"好看":[1,261105,4965,1],"妈妈比爸爸小两岁，她的头发很短，看上去特别年轻。":[1,266070,30765,1],"年轻":[1,296835,4725,1,0.83],"我哥哥比我大三岁。":[1,301560,11085,1,0.86],"我家有爸爸、妈妈、哥哥和我。":[1,312645,20565,1],"我比较矮，也比较瘦。":[1,333210,14925,1],"我比较矮，我弟弟比我还矮。":[1,348135,17205,1,0.91],"我没有哥哥那么聪明，但是我比他更喜欢运动。":[1,365340,23085,1],"我没有我哥哥那么高。":[1,388425,10365,1],"我爱我的家人。":[1,398790,8685,1],"我的手机跟你的不一样。":[1,407475,11685,1],"我觉得你比以前年轻了。":[1,419160,11925,1],"我跟我哥哥一样高。":[1,431085,10245,1],"戴":[1,441330,3765,1,0.49],"是吗？很多人都说我们很像。|m":[1,445095,18405,1],"更":[1,463500,3885,1,0.45],"比较":[1,467385,4485,1],"没有":[1,471870,4365,1,0.87],"爸爸五十岁了，很高，有一点胖，戴眼镜。":[1,476235,26565,1,0.96],"特别":[1,502800,4725,1],"相同":[1,507525,4965,1],"眼镜":[1,512490,4845,1,0.83],"聪明":[1,517335,4845,1],"胖":[1,522180,3645,1,0.52],"这两个孩子的脸特别像。":[1,525825,12765,1],"这两个手机，你觉得哪个更好看？":[1,538590,18645,1],"这两件衣服的颜色相同。":[1,557235,12885,1],"这个孩子可爱极了！":[1,570120,10845,1,0.87],"这位老师特别年轻。":[1,580965,10845,1,0.85],"那个戴眼镜的人是我们老师。":[1,591810,14685,1],"那个戴眼镜的女人是谁？":[1,606495,12285,1],"那么":[1,618780,4365,1,0.93],"那位老先生是谁？":[1,623145,10365,1],"上个星期考试，她的汉语成绩不太好，她很不高兴。":[2,0,30045,1],"不客气。你每天都要认真地复习。":[2,30045,20565,1],"他每天都很认真地复习。":[2,50610,13485,1],"他汉语说得很好。":[2,64095,10005,1],"他的字写得很清楚。":[2,74100,10965,1],"他这次的成绩比上次好多了。":[2,85065,15405,1],"作业":[2,100470,4605,1,0.96],"你作业做完了吗？":[2,105075,9045,1,0.77],"你复习好了吗？明天就考试了。":[2,114120,17565,1,0.96],"你弟弟上几年级？":[2,131685,9765,1,0.96],"你明白这个词语的意思吗？":[2,141450,12645,1],"你看见我的铅笔了吗？":[2,154095,10965,1],"努力":[2,165060,4485,1],"句子":[2,169545,4845,1,0.77],"啊，我明白了！一点也不难。谢谢你！|m":[2,174390,22965,1,0.91],"地":[2,197355,3885,1,0.84],"复习":[2,201240,4965,1,0.79],"她学习非常努力。":[2,206205,10125,1],"她学习非常努力，每天晚上都认真地复习。":[2,216330,23565,1],"她最喜欢数学，觉得数学题很容易，但是她觉得汉语比较难。":[2,239895,32925,1],"容易":[2,272820,4605,1,0.86],"年级":[2,277425,4845,1],"慢慢":[2,282270,4485,1],"成绩":[2,286755,5085,1,0.95],"我一写完作业就去睡觉。":[2,291840,12525,1,0.86],"我已经做完作业了。":[2,304365,10365,1],"我想提高我的数学成绩。":[2,314730,12765,1],"我每天都练习写字。":[2,327495,10845,1],"我看看。你先看这个句子，明白了吗？":[2,338340,24765,1],"提高":[2,363105,4725,1],"数学":[2,367830,4965,1,0.86],"数学太难了，我不喜欢。":[2,372795,15165,1],"明白":[2,387960,4605,1],"李月明白了老师的意思，现在她每天都练习写字半个小时。":[2,392565,28485,1],"李月是三年级的学生。":[2,421050,10965,1,0.92],"校长":[2,432015,5085,1,0.69],"校长在跟老师们说话。":[2,437100,12165,1,0.94],"汉语的词语很多，句子也不简单。":[2,449265,18645,1],"清楚":[2,467910,4965,1,0.94],"简单":[2,472875,4725,1],"练习":[2,477600,4965,1],"老师们":[2,482565,5445,1],"老师告诉她：“你每天练习写字，多读书，成绩就会提高。”":[2,488010,35565,1],"老师和同学们都为她高兴。":[2,523575,15045,1],"老师的问题你听懂了吗？":[2,538620,12285,1],"老师，黑板上的字我没看清楚。":[2,550905,18885,1],"认真":[2,569790,4605,1,0.89],"词语":[2,574395,3885,1,0.78],"请你慢慢地说。":[2,578280,8685,1],"请你慢慢地说，说清楚一点。":[2,586965,16845,1],"请大家看黑板。":[2,603810,8925,1],"还没有。这个数学题太难了，我不明白。|m":[2,612735,26205,1],"这个句子我写错了。":[2,638940,10605,1,0.88],"这个题很简单，谁都会做。":[2,649545,16125,1,0.96],"这次考试不难，比较容易。":[2,665670,16365,1,0.87],"这次考试，她的成绩比上次好多了。":[2,682035,20085,1],"铅笔":[2,702120,4725,1,0.88],"难":[2,706845,3045,1,0.42],"黑板":[2,709890,4965,1],"上个月我搬家了，很多朋友都来帮忙。":[3,0,20925,1],"上去":[3,20925,5325,1],"今天晚上家里有客人。":[3,26250,12045,1],"他每天都打扫房间。":[3,38295,11085,1],"你把那本书拿给我，好吗？":[3,49380,15525,1],"冰箱":[3,64905,4965,1,0.92],"出去以前请把灯关了。":[3,69870,11685,1,0.72],"厨房":[3,81555,5085,1],"厨房里有一个新冰箱，房间里还有空调。":[3,86640,22005,1],"在几层？有电梯吗？|m":[3,108645,15525,1,0.94],"在十二层，有电梯。我们可以坐电梯把冰箱搬上去。":[3,124170,30765,1],"在学校附近，那里很安静。":[3,154935,16485,1],"声音":[3,171420,5085,1,0.93],"大家都说我的新家很漂亮。":[3,176505,14445,1],"太好了。我明天早上八点到。|m":[3,190950,17445,1],"太热了，开一下空调吧。":[3,208395,17325,1],"妈妈正在厨房里做饭。":[3,225720,12165,1],"安静":[3,237885,4845,1],"客人":[3,242730,4485,1,0.9],"客人来以前，我把房间打扫得干干净净，还准备了很多水果。":[3,247215,33765,1],"家里":[3,280980,4605,1],"小张":[3,285585,4485,1,0.94],"小张，明天我搬家，你能来帮忙吗？":[3,290070,22245,1],"帮忙":[3,312315,4485,1],"干净":[3,316800,4725,1,0.8],"我下个月要搬家。":[3,321525,9645,1],"我们坐电梯上楼吧。":[3,331170,10365,1,0.97],"我们把冰箱搬到厨房去吧。":[3,341535,13605,1],"我家在六层，没有电梯。":[3,355140,14805,1],"我家附近有很多饭馆。":[3,369945,11925,1,0.9],"我家附近有很多饭馆和商店，买东西、吃饭都不用走很远。":[3,381870,33645,0,0.93],"我已经把房间打扫干净了。":[3,415515,13605,1],"我的邻居是一位老医生。":[3,429120,12165,1],"我的邻居是一位老医生，他人很好，经常跟我说话。":[3,441285,28965,1],"我还没把作业做完。":[3,470250,10485,1],"打扫":[3,480735,4845,1],"把":[3,485580,4605,1,0.68],"搬":[3,490185,4125,1,0.58],"新家不大，但是很干净，也很安静。":[3,494310,22485,1],"新家在五层，楼里有电梯。":[3,516795,16485,1],"旧":[3,533280,2805,1,0.45],"明天你能来帮忙吗？":[3,536085,10365,1],"昨天晚上，我请了几个朋友来我家吃饭。":[3,546450,22005,1],"桌子上放着很多东西。":[3,568455,12405,1],"没问题。你的新家在哪里？|m":[3,580860,17685,1],"灯还开着，他还没睡觉。":[3,598545,15525,1],"电梯":[3,614070,4965,1],"空调":[3,619035,4845,1],"空调开着，别开门。":[3,623880,13125,1],"请把书放在桌子上。":[3,637005,11205,1],"这个冰箱太旧了，我想买个新的。":[3,648210,18525,1],"这里很安静，我很喜欢。":[3,666735,15405,1,0.96],"邻居":[3,682140,4965,1,0.93],"邻居家的声音太大了。":[3,687105,11805,1],"附近":[3,698910,4965,1,0.83],"下午我去图书馆借字典，但是那本字典已经被别人借走了。":[4,0,30045,1],"不要拿别人的东西。":[4,30045,10125,1],"他昨天去了北京。":[4,40170,10245,1,0.97],"他请我喝咖啡，我们说了很多以前的事情。":[4,50415,23085,1,0.96],"你刚才去哪里了？":[4,73500,9765,1],"你刚才把包放在哪里了？":[4,83265,12885,1],"你怎么了？别着急，慢慢说。":[4,96150,19365,1],"你还记得我吗？":[4,115515,7965,1],"借":[4,123480,2925,1,0.36],"刚才":[4,126405,4845,1],"别人":[4,131250,4245,1,0.84],"别着急，我们慢慢找。":[4,135495,15285,1],"发现":[4,150780,5085,1,0.97],"啊，你看！我的包在那里！|m":[4,155865,19005,1],"回家的时候，我在路上遇到了一个以前的同学。":[4,174870,24165,1],"图书馆":[4,199035,5925,1,0.75],"在公共汽车上，我突然发现钱包不在包里。":[4,204960,23805,1],"在图书馆，我把包放在桌子上，然后去借书了。|m":[4,228765,27885,1],"坏":[4,256650,4005,1,0.61],"奇怪":[4,260655,4605,1],"字典":[4,265260,3885,1,0.85],"孩子哭了，他怎么了？":[4,269145,13485,1,0.91],"小心":[4,282630,4845,1],"小心！杯子里的水很热。":[4,287475,15525,1,0.97],"忘记":[4,303000,4845,1,0.88],"我从图书馆借了两本书。":[4,307845,12645,1],"我们正在跑步，突然下雨了。":[4,320490,16485,1],"我刚才遇到了一个老朋友。":[4,336975,13005,1,0.89],"我发现我的钱包不在包里。":[4,349980,13725,1],"我可以借你的字典用一下吗？":[4,363705,14445,1],"我很着急，早饭也没吃就出去了。":[4,378150,19005,1],"我忘记他的名字了。":[4,397155,10365,1],"我想了一会儿，才记得钱包放在家里的桌子上了。":[4,407520,24525,1],"我找不到我的包了！|m":[4,432045,10365,1],"我没吃过这个菜。":[4,442410,9645,1],"我的包被人拿走了！":[4,452055,10125,1,0.91],"我的字典被别人借走了。":[4,462180,12285,1,0.86],"我的电脑被弟弟用坏了。":[4,474465,12045,1,0.82],"早上我的手机坏了，我七点半才起床。":[4,486510,21405,1],"昨天是很奇怪的一天。":[4,507915,12165,1],"是不是":[4,520080,5685,1,0.94],"是不是被别人拿走了？":[4,525765,11565,1],"是不是被别人拿走了？我们去问问吧。":[4,537330,19725,1],"最近":[4,557055,4965,1,0.87],"最近我很忙，没时间看书。":[4,562020,16725,1,0.95],"电脑坏了，我的作业都没有了！":[4,578745,17085,1,0.96],"真奇怪，他今天为什么没来？":[4,595830,17685,1],"着急":[4,613515,4845,1],"突然":[4,618360,4485,1,0.78],"被":[4,622845,3765,1,0.39],"记得":[4,626610,4605,1,0.81],"这是我昨天最高兴的时候。":[4,631215,13485,1],"这本书你看过没有？":[4,644700,10485,1,0.89],"遇到":[4,655185,4485,1,0.81],"钱包":[4,659670,4725,1,0.89],"问问":[4,664395,4605,1],"一直":[5,0,4605,1],"一直往东走，就是地铁站。":[5,4605,15885,1],"上个星期六，我第一次去朋友小张家。":[5,20490,21645,1],"下来":[5,42135,4965,1],"不远，走十分钟就到了。|m":[5,47100,15885,1],"中间":[5,62985,4485,1],"五百":[5,67470,4605,1,0.95],"他从包里拿出来一张地图。":[5,72075,14205,1],"他从楼上走下来了。":[5,86280,11085,1],"他家离地铁站很近，是我走错了。":[5,97365,19245,1,0.97],"他已经离开北京了。":[5,116610,10845,1],"你什么时候回来？":[5,127455,9285,1,0.94],"你有地图吗？我们好像走错了。":[5,136740,17445,1],"你骑过马吗？":[5,154185,7965,1],"出来":[5,162150,4725,1,0.93],"前":[5,166875,4245,1,0.5],"南":[5,171120,3045,1,0.42],"去学校要经过一个医院。":[5,174165,12405,1,0.83],"司机":[5,186570,4845,1,0.91],"商店在学校和医院中间。":[5,191415,13845,1],"回来":[5,205260,4725,1,0.67],"地图":[5,209985,4725,1,0.84],"地方":[5,214710,4605,1,0.71],"地铁":[5,219315,4605,1,0.75],"地铁比公共汽车快多了。":[5,223920,13005,1],"地铁站":[5,236925,5565,1],"地铁站就在学校的西边。":[5,242490,13005,1],"地铁站里有洗手间吗？":[5,255495,12045,1],"好像":[5,267540,4965,1],"小张给我打电话，告诉我怎么走：“你先坐地铁到东门站，从二号口出来。":[5,272505,40005,1],"往":[5,312510,4845,1,0.58],"往南走五分钟就到了。":[5,317355,11325,1],"快进来吧，别站在门口。":[5,328680,15645,1],"我从地铁站出来以后，不知道哪边是南边，就往西走了。":[5,344325,29325,1,0.91],"我家就在一个商店和一个饭馆中间。”":[5,373650,16725,1,0.97],"我家离地铁站五百米。":[5,390375,10605,1,0.91],"我给小张打电话，他骑自行车来接我。":[5,400980,21165,1],"明天我去机场接你。":[5,422145,11205,1,0.85],"有。你一直往前走，经过一个医院，就能看见地铁站了。|m":[5,433350,31125,1],"有，就在二号口旁边。过马路的时候小心一点。|m":[5,464475,27765,1],"洗手间":[5,492240,6285,1],"然后一直往南走，经过一个医院，过了马路就到了。":[5,498525,27645,1],"离开":[5,526170,4605,1],"离这里远吗？":[5,530775,7485,1,0.95],"经过":[5,538260,4605,1,0.78],"街道":[5,542865,4725,1,0.87],"西边":[5,547590,4125,1,0.91],"请问":[5,551715,4725,1,0.94],"请问，洗手间在哪里？":[5,556440,14685,1,0.97],"请问，附近有地铁站吗？":[5,571125,15165,1,0.97],"走了二十分钟，我还没找到。":[5,586290,16365,1],"辆":[5,602655,3765,1,0.38],"过马路的时候要小心。":[5,606420,11685,1],"这个地方我以前来过。":[5,618105,11205,1,0.9],"这里的街道很干净。":[5,629310,10845,1],"进来":[5,640155,4725,1,0.91],"那个司机开得很快。":[5,644880,9405,1,0.87],"门口":[5,654285,4845,1],"门口有一辆出租车。":[5,659130,10965,1,0.96],"马路":[5,670095,4845,1],"一公斤葡萄十二块五角。":[6,0,13485,1],"一碗面条十块钱，又好吃又能吃饱。":[6,13485,20085,1],"中国菜又好吃又便宜，但是菜单上的字她都看不懂，服务员的问题她也听不懂，所以她每次都点面条。":[6,33570,53325,1],"他又饿又累，一回家就睡觉了。":[6,86895,17565,1,0.9],"你们":[6,104460,4365,1,0.95],"你们吃饱了吗？要不要来点蛋糕？":[6,108825,17565,1],"你会用筷子吗？":[6,126390,8445,1],"你吃得完这碗面条吗？":[6,134835,11205,1],"分":[6,146040,3165,1,0.49],"又":[6,149205,2805,1,0.41],"吃完饭，她还喜欢买一点水果，香蕉、葡萄她都喜欢。":[6,152010,34005,1,0.92],"咖啡里要放糖吗？":[6,186015,9885,1,0.97],"啤酒":[6,195900,4965,1,0.79],"她经常去学校旁边的一家小饭馆，那里的菜很新鲜，服务员都认识她。":[6,200865,37725,1],"她说：“在中国，我每天都吃得很饱！”":[6,238590,23925,1],"安娜第一次来中国的时候，不会用筷子，吃饭吃得很慢。":[6,262515,31365,1],"您好":[6,293880,4725,1],"您好，这是菜单。你们吃点什么？":[6,298605,20925,1,0.79],"我们要两碗面条。有什么喝的？|m":[6,319530,17565,1],"我吃了两碗米饭，吃饱了。":[6,337095,14925,1],"我渴极了，想喝一杯果汁。":[6,352020,14925,1,0.88],"我饱了，真的吃不了了。":[6,366945,15165,1],"我饿了，我们去吃饭吧。":[6,382110,15165,1,0.93],"找你两块三角五分。":[6,397275,10845,1],"新鲜":[6,408120,4365,1,0.9],"早上我一般吃面包，喝牛奶。":[6,412485,17085,1],"明天我有事情，去不了。":[6,429570,14805,1],"有果汁、啤酒和茶。":[6,444375,13605,1,0.82],"服务员，来两杯啤酒！":[6,457980,14805,1],"服务员，请把菜单给我们。":[6,472785,16245,1],"来两杯果汁吧。|m":[6,489030,8925,1],"果汁":[6,497955,4725,1,0.82],"现在她已经会用筷子了，也看得懂菜单了。":[6,502680,22365,1,0.87],"盘子":[6,525045,4725,1],"真的":[6,529770,4725,1],"碗":[6,534495,4605,1,0.62],"筷子":[6,539100,4725,1],"老师说得太快，我听不懂。":[6,543825,15765,1],"菜单":[6,559590,4965,1],"菜太多了，我们吃不完。":[6,564555,14925,1],"葡萄":[6,579480,4605,1,0.97],"蛋糕":[6,584085,4245,1],"角":[6,588330,3885,1,0.56],"请再给我一个盘子。":[6,592215,10605,1,0.97],"谢谢，我们已经吃饱了，吃不了了。|m":[6,602820,22005,1],"这个蛋糕太甜了。":[6,624825,10125,1,0.92],"这些鸡蛋是今天的，很新鲜。":[6,634950,17085,1,0.94],"这里的水果又新鲜又便宜。":[6,652035,14085,1],"面包":[6,666120,4725,1],"面条":[6,670845,4965,1],"香蕉":[6,675810,4845,1,0.89],"香蕉三块五一公斤。":[6,680655,11085,1],"下雨了，你有伞吗？":[7,0,14205,1],"下雪的北京多么漂亮啊！":[7,14205,12405,1,0.96],"下雪的时候，北京多么漂亮啊！":[7,26610,17685,1],"今天天气多么好啊！":[7,44295,10605,1,0.94],"今天太阳很好，我们出去走走吧。":[7,54900,19125,1],"今天最低零下五度。":[7,74025,10965,1],"今天的天特别蓝。":[7,84990,10485,1],"但是很多北京人都说，北京的秋天越来越短了。":[7,95475,25245,1],"你最喜欢哪个季节？":[7,120720,11085,1,0.84],"你看，今天的月亮真漂亮！":[7,131805,16845,1,0.95],"冬":[7,148650,3765,1,0.43],"冬天":[7,152415,4845,1,0.89],"冬天很冷，有时候零下十几度，但是房间里不冷。":[7,157260,28485,1],"冷极了！今天最低零下十度，还刮风。|m":[7,185745,22485,1],"刮":[7,208230,4005,1,0.53],"北京有四个季节：春天、夏天、秋天和冬天。":[7,212235,29325,1,0.93],"北京的春天经常刮风。":[7,241560,12645,1],"北方":[7,254205,4725,1,0.96],"北方的冬天比南方冷多了。":[7,258930,14205,1],"南方":[7,273135,4725,1],"喂，北京今天天气怎么样？":[7,277860,15765,1],"夏":[7,293625,3165,1,0.61],"夏天":[7,296790,5085,1],"夏天很热，经常下雨，出去的时候包里最好放一把伞。":[7,301875,31605,1],"多么":[7,333480,4125,1,0.86],"天上一点云也没有。":[7,337605,10965,1],"天气越来越冷了。":[7,348570,9885,1,0.97],"太阳":[7,358455,4845,1,0.87],"好啊":[7,363300,4125,0,0.95],"好啊！":[7,367425,4005,0,0.97],"季节":[7,371430,4845,1,0.82],"度":[7,376275,3645,1,0.41],"我们这里二十度，太阳很好。":[7,379920,16725,1],"我听人说明天会下雪。":[7,396645,12285,1],"我最喜欢秋天，不冷也不热。":[7,408930,16965,1],"我越看越喜欢这个地方。":[7,425895,12525,1,0.83],"春天":[7,438420,5085,1],"春天来了，花都开了。":[7,443505,14205,1],"春天的草是绿的，秋天就黄了。":[7,457710,18285,1],"春天经常刮风，有时候风很大，但是花都开了，非常漂亮。":[7,475995,35445,1],"月亮":[7,511440,4605,1,0.73],"来中国学习汉语的人越来越多。":[7,516045,15645,1],"真好！北方的冬天越来越冷了。|m":[7,531690,19245,1],"秋天":[7,550935,4845,1,0.84],"秋天是北京最好的季节，不冷也不热，天特别蓝，晚上的月亮也很漂亮。":[7,555780,40485,1],"绿":[7,596265,3765,1,0.33],"蓝":[7,600030,4005,1,0.4],"越":[7,604035,2805,1,0.35],"越来越":[7,606840,5445,1,0.88],"这里夏天很热，冬天很冷。":[7,612285,16485,1],"那你春天来我这里玩吧。这里的春天特别漂亮。":[7,628770,24285,1],"雨":[7,653055,4125,1,0.39],"雨越下越大。":[7,657180,7845,1,0.95],"零下":[7,665025,4845,1],"风":[7,669870,3165,1,0.47],"风越刮越大了。":[7,673035,8685,1],"一定":[8,0,4485,1,0.95],"七十":[8,4485,4965,1,0.82],"三十九":[8,9450,6405,1,0.77],"三十八":[8,15855,5805,1,0.86],"两天了。昨天晚上三十八度五。|m":[8,21660,16965,1,0.79],"从那以后，爸爸每天早上都去跑步，星期六还跟朋友一起去游泳。":[8,38625,36885,1,0.93],"他七十岁了，身体还很健康。":[8,75510,17685,1],"他发烧三十九度，需要马上去医院。":[8,93195,19845,1],"他每天在公司坐八个小时，回家以后就看电视。":[8,113040,25605,1],"他还少喝啤酒，多吃水果。":[8,138645,17205,1,0.95],"作用":[8,155850,4725,1,0.92],"你一定要去医院检查一下。":[8,160575,12645,1],"你哪里不舒服？":[8,173220,8565,1],"你应该多喝水，多休息。":[8,181785,16845,1],"健康":[8,198630,4965,1,0.92],"别担心，我已经好多了。":[8,203595,16245,1],"医生给他检查了身体，说：“你的身体没有大问题，但是你需要多锻炼。":[8,219840,37845,1],"医生说我需要休息两天。":[8,257685,12885,1,0.88],"医生说没问题，你放心吧。":[8,270570,15885,1],"去年冬天，他感冒了好几次，腿和脚也经常疼。":[8,286455,28245,1],"发烧":[8,314700,4965,1],"发烧几天了？":[8,319665,7725,1],"只":[8,327390,4485,1,0.31],"只要":[8,331875,4605,1],"只要你每天锻炼，身体就会越来越好。":[8,336480,21165,1],"只要多休息，你的感冒就会好。":[8,357645,17085,0,0.93],"天气冷了，注意别感冒。":[8,374730,14925,1],"如果":[8,389655,4605,1,0.77],"如果你不舒服，就回家休息吧。":[8,394260,17565,1],"如果你每天走路半个小时，身体就会好很多。”":[8,411825,24525,1],"如果明天下雨，我们就不去了。":[8,436350,17085,1,0.79],"应该":[8,453435,4605,1],"感冒":[8,458040,4245,1],"感冒的时候不应该喝啤酒。":[8,462285,15165,1],"我们都很担心他。":[8,477450,9525,1],"我发烧了，鼻子也不舒服。|m":[8,486975,15765,1],"我只吃了一点东西。":[8,502740,10605,1],"我感冒了，鼻子很不舒服。":[8,513345,15885,1],"我有点发烧，身体很不舒服。":[8,529230,17805,1],"我每天早上锻炼半个小时。":[8,547035,14085,1],"我爸爸工作很忙，以前很少锻炼。":[8,561120,19845,1],"我的脚疼了一个星期了。":[8,580965,11565,1],"我的腿很疼，走不了路。":[8,592530,15165,1],"我给你检查一下。你感冒了，不用担心。":[8,607695,23445,1],"我耳朵疼，听不清楚。":[8,631140,13845,1],"我需要吃药吗？|m":[8,644985,8565,1],"担心":[8,653550,4965,1],"放心":[8,658515,5085,1],"有点":[8,663600,4845,1,0.9],"检查":[8,668445,5325,1,0.68],"注意":[8,673770,4605,1,0.88],"爸爸经常说：“只要每天锻炼，身体就会越来越健康。”":[8,678375,29685,1],"现在爸爸很少感冒，我们都放心了。":[8,708060,20085,1],"耳朵":[8,728145,4005,1,0.88],"脚":[8,732150,3885,1,0.58],"舒服":[8,736035,4965,1,0.97],"这个药没什么作用。":[8,741000,10005,1],"锻炼":[8,751005,4365,1],"需要":[8,755370,4005,1,0.93],"需要。这个药一天吃三次。只要好好休息，几天就会好。":[8,759375,34125,1,0.92],"鼻子":[8,793500,4605,1],"一共":[9,0,4605,1],"万":[9,4605,3765,1,0.54],"三百五十":[9,8370,7485,1],"三百八十":[9,15855,7485,1],"三百八十块。除了鞋以外，您还需要别的吗？":[9,23340,25485,1],"不用了，谢谢。可以刷卡吗？|m":[9,48825,21165,1,0.89],"以外":[9,69990,4485,1],"你喜欢穿裙子还是裤子？":[9,74475,14205,1],"你来看看这双鞋怎么样。":[9,88680,12165,1],"你要红的还是白的？":[9,100845,10725,1],"其他":[9,111570,4605,1],"其他的颜色都卖完了。":[9,116175,11805,1,0.91],"别的":[9,127980,4605,1,0.89],"卡":[9,132585,4965,1,0.6],"可以刷卡吗？":[9,137550,7845,1],"商店里的衣服很多，有红的、白的、黑的，还有黄的。":[9,145395,36165,1],"在超市里，妈妈问我：“晚上吃面条还是米饭？”":[9,181560,26565,1],"好的。这双呢？":[9,208125,11205,1,0.96],"妈妈想给我买一条裙子，但是我更喜欢穿裤子。":[9,219330,25485,1,0.9],"妈妈问我：“你满意了吧？”":[9,244815,14325,1],"帽子":[9,259140,4845,1],"您好，您想买什么？":[9,263985,13245,1,0.84],"您看看这双怎么样？这种鞋卖得特别好。":[9,277230,20685,1,0.92],"想想":[9,297915,4365,1,0.83],"我们星期六或者星期天去买衣服吧。":[9,302280,17685,1,0.97],"我可以试试吗？……有点小，能换一双大一点的吗？|m":[9,319965,26205,1],"我可以试试这件衬衫吗？":[9,346170,12405,1,0.82],"我想买一双鞋。|m":[9,358575,9405,1],"我想想，明天再来买吧。":[9,367980,16485,1,0.94],"我要去银行换钱。":[9,384465,10005,1,0.97],"我试了好几条裤子，才找到一条又便宜又舒服的。":[9,394470,25965,1,0.93],"我说：“满意极了！”":[9,420435,12285,1,0.9],"我说：“面条或者米饭都可以。”":[9,432720,17925,1],"星期天":[9,450645,6165,1],"星期天下午，我和妈妈去商店买衣服。":[9,456810,21645,1],"条":[9,478455,3285,1,0.41],"满意":[9,481740,4725,1],"然后我们去超市买了一些水果和面包。":[9,486465,17805,1],"种":[9,504270,3885,1,0.59],"累了就好好休息休息。":[9,508155,11925,1],"衬衫":[9,520080,4845,1],"裙子":[9,524925,4965,1,0.82],"裤子":[9,529890,4965,1,0.89],"试试":[9,534855,4365,1,0.89],"超市":[9,539220,5085,1,0.9],"超市里东西很多，也很便宜。":[9,544305,17565,1],"这个帽子是我妈妈给我买的。":[9,561870,14205,1,0.93],"这些东西一共三百五十块。":[9,576075,14205,1],"这件衣服一万块？太贵了！":[9,590280,15285,1,0.93],"这件衣服你满意吗？":[9,605565,10605,1],"这双很舒服，我很满意。多少钱？|m":[9,616170,22245,1],"这双鞋太小了，能换一双吗？":[9,638415,16845,1,0.91],"这条裙子多少钱？":[9,655260,10485,1,0.85],"这条裤子有点长，有短一点的吗？":[9,665745,18885,1,0.91],"这种帽子有没有黑的？":[9,684630,11085,1,0.83],"银行":[9,695715,4725,1],"除了":[9,700440,4845,1,0.88],"除了我以外，大家都去了。":[9,705285,15525,1],"除了衬衫以外，我还买了一条裤子。":[9,720810,19485,1],"除了裤子以外，妈妈还给我买了一件衬衫和一双鞋，一共花了六百多块钱。":[9,740295,37485,1],"上个月，我们一起在学校表演了一个节目，大家都很喜欢。":[10,0,32685,1],"不但":[10,32685,4125,1,0.86],"什么表演":[10,36810,7005,1],"什么表演？":[10,43815,7005,1],"他一边听音乐，一边做作业。":[10,50820,17325,1],"他不但会画画，而且画得很好。":[10,68145,18525,1,0.83],"他不但喜欢唱歌，而且喜欢跳舞。":[10,86670,20205,1],"他不敢一个人晚上出去。":[10,106875,12165,1],"体育":[10,119040,4725,1],"你别总是玩游戏。":[10,123765,10005,1],"你敢一个人去爬山吗？":[10,133770,11565,1,0.94],"你有什么爱好？":[10,145335,8205,1],"你看，这是我去年夏天的照片。":[10,153540,18165,1,0.88],"你能教我游泳吗？":[10,171705,9405,1],"兴趣":[10,181110,4365,1,0.91],"去年我参加了学校的画画比赛，老师们都说我画得不错。":[10,185475,28725,1],"参加":[10,214200,4725,1],"周末":[10,218925,4725,1,0.65],"周末你想做什么？":[10,223650,9645,1],"周末我经常一边听音乐，一边画画。":[10,233295,20325,1],"太好了！晚上我们还可以去看一个表演。|m":[10,253620,21645,1],"孩子们":[10,275265,5685,1],"孩子们在学校表演了一个节目。":[10,280950,15045,1],"当然":[10,295995,4125,1],"当然可以，我明天教你。":[10,300120,14925,1],"当然！我最喜欢爬山了。我们可以一边爬山，一边说话。":[10,315045,33405,1],"感":[10,348450,4725,1,0.54],"我们一边爬山，一边说话。":[10,353175,16125,1],"我叫大卫，在北京学习汉语。":[10,369300,17205,1],"我对中国音乐也很感兴趣，所以我的中国朋友小李每个星期都教我唱歌。":[10,386505,36285,1,0.93],"我对中国音乐很感兴趣。":[10,422790,13485,1],"我对画画没有兴趣。":[10,436275,10485,1],"我弟弟很喜欢玩电子游戏。":[10,446760,13725,1],"我想买一个新照相机。":[10,460485,11685,1],"我想去爬山。你对爬山感兴趣吗？|m":[10,472170,19725,1,0.95],"我最喜欢上体育课。":[10,491895,11205,1],"我的爱好很多：听音乐、画画、爬山，还有玩电子游戏。":[10,503100,34485,0,0.95],"我的爱好是爬山和听音乐。":[10,537585,13725,1],"我觉得有爱好的人不但每天都很快乐，而且身体也很健康。":[10,551310,31125,1,0.96],"我还喜欢爬山，北京附近有很多地方可以爬山，我的照相机里有很多爬山的照片。":[10,582435,43845,1],"教":[10,626280,3165,1,0.5],"明天的比赛你参加吗？":[10,629445,11925,1],"是一个音乐节目。我的朋友也参加了，他不但会唱歌，而且还会跳舞。|m":[10,641370,39285,1],"比赛":[10,680655,4725,1,0.89],"游戏":[10,685380,4845,1,0.81],"照片":[10,690225,5085,1],"照相机":[10,695310,5925,1],"爬山":[10,701235,4125,1],"爱好":[10,705360,4125,0,0.95],"电子":[10,709485,4485,1,0.96],"画":[10,713970,3165,1,0.56],"画画":[10,717135,4245,0],"而且":[10,721380,4725,1,0.91],"节目":[10,726105,4605,1,0.77],"表演":[10,730710,4485,1,0.95],"这个周末你想做什么？":[10,735195,11445,1],"这个电视节目很有意思。":[10,746640,12885,1],"这次比赛我们班得了第一。":[10,759525,13365,1],"音乐":[10,772890,4725,1,0.89],"上个月，经理给了我一个机会，让我一个人完成一个重要的工作。":[11,0,33765,1],"上午九点。这个会议很重要，你必须参加。|m":[11,33765,25005,1],"下午三点有一个重要的会议。":[11,58770,13965,1],"为了":[11,72735,4365,1],"为了学习汉语，他来了中国。":[11,77100,16365,1],"为了找到这个工作，我准备了很长时间。":[11,93465,20445,1,0.88],"为了身体健康，我每天都锻炼。":[11,113910,17685,1],"主要":[11,131595,4605,1,0.85],"主要是关于买新电脑的事情。我们要选择一家公司。|m":[11,136200,27645,1],"他决定离开这家公司。":[11,163845,12045,1],"会议":[11,175890,4845,1,0.88],"会议主要说什么？":[11,180735,9405,1],"会议几点结束？":[11,190140,9045,1],"你先看看哪家公司的电脑又好又便宜。|m":[11,199185,20565,1],"你是什么时候来的？":[11,219750,9885,1,0.92],"你有什么好办法吗？":[11,229635,10245,1],"信":[11,239880,3165,1,0.4],"关于":[11,243045,4485,1],"关于这件事情，我们明天再说吧。":[11,247530,18525,1],"决定":[11,266055,4845,1,0.84],"办公室":[11,270900,5805,1],"办法":[11,276705,4845,1,0.8],"同事":[11,281550,4965,1,0.96],"同事们教我怎么解决问题，我也每天认真地学习。":[11,286515,24885,1,0.95],"在会议上，经理说我做得很好。":[11,311400,18165,1],"好的。我需要准备什么？":[11,329565,14805,1,0.84],"完成":[11,344370,4965,1,0.89],"开始工作的时候，我遇到了很多问题，每天都很着急。":[11,349335,29925,1],"张经理，明天的会议是几点？":[11,379260,18645,1],"必须":[11,397905,4845,1],"我不知道应该选择哪个。":[11,402750,12525,1],"我们公司主要卖电脑。":[11,415275,10485,1,0.95],"我们公司主要卖电脑和手机。":[11,425760,14805,1],"我们必须今天把这件事情做完。":[11,440565,15405,1],"我们必须在星期五以前完成。":[11,455970,15285,1],"我和同事经常一起吃饭。":[11,471255,13605,1,0.87],"我很高兴我选择了这家公司。":[11,484860,14925,1],"我是去年九月来这家公司工作的。":[11,499785,16965,1,0.86],"我是坐地铁来的。":[11,516750,9645,1,0.9],"我的同事都很年轻，也很聪明，我们经常一起吃饭。":[11,526395,28365,1],"我的经理姓张，他对工作要求很高，但是人很好。":[11,554760,28245,1],"我认为这个办法很好。":[11,583005,11565,1],"星期五":[11,594570,6165,1],"机会":[11,600735,4605,1],"没问题，我今天下午就能完成。":[11,605340,18525,1,0.97],"终于":[11,623865,4485,1],"经理":[11,628350,4605,1,0.86],"经理现在不在办公室。":[11,632955,12165,1],"经理要求我们八点以前到公司。":[11,645120,15765,1],"结束":[11,660885,4965,1,0.83],"要求":[11,665850,4965,1],"解决":[11,670815,4845,1,0.86],"认为":[11,675660,4725,1],"这个工作我们终于完成了！":[11,680385,13245,1],"这个问题已经解决了。":[11,693630,11445,1,0.92],"这是一个很好的机会。":[11,705075,11325,1],"这是一本关于中国的书。":[11,716400,12405,1],"这是谁给你的信？":[11,728805,9885,1],"选择":[11,738690,4965,1],"那几天我每天都工作到晚上九点，终于完成了。":[11,743655,25245,1],"重要":[11,768900,4725,1,0.86],"上个月我感冒了，一个人在家，很难过。":[12,0,23445,1],"下个星期是奶奶的生日，我们送她什么礼物？":[12,23445,22245,1],"他们":[12,45690,4365,1],"他们结婚十年了。":[12,50055,10125,1],"他忙得连饭都没时间吃。":[12,60180,13245,1],"以为":[12,73425,4485,1],"你愿意跟我结婚吗？":[12,77910,10245,1,0.87],"你说得对。那我们星期六去看她吧，再给她买一个蛋糕。":[12,88155,29325,1],"你跟他是什么关系？":[12,117480,9885,1,0.86],"八十":[12,127365,5085,1],"关心":[12,132450,4845,1,0.85],"关系":[12,137295,4845,1],"其实":[12,142140,4845,1,0.89],"其实奶奶最希望我们去看看她。虽然她不说，但是她很想我们。|m":[12,146985,34965,1],"别生气了，他已经说对不起了。":[12,181950,17445,1],"叔叔":[12,199395,4965,1,0.9],"同意":[12,204360,4725,1],"奶奶":[12,209085,4725,1],"奶奶生病了，妈妈在医院照顾她。":[12,213810,18765,1],"她很关心别人，连楼里每家人的名字她都记得。":[12,232575,24885,1],"好！爷爷也一定会很高兴。|m":[12,257460,17085,1],"害怕":[12,274545,4125,1,0.87],"张阿姨六十多岁了，对人非常热情。":[12,278670,20325,1],"张阿姨知道以后，每天都给我送饭，还经常来照顾我。":[12,298995,29925,1],"感冒好了以后，我买了一个礼物送给她。":[12,328920,20565,1],"愿意":[12,349485,4725,1],"我以为他是老师，其实他是学生。":[12,354210,19005,1,0.96],"我以为你不来了！":[12,373215,9045,1,0.96],"我以为你已经买好了！|m":[12,382260,11565,1],"我们很长时间没见面了。":[12,393825,12285,1],"我妹妹很害怕狗。":[12,406110,10365,1,0.88],"我想给她钱，她不同意，说：“你别给我钱，我们是邻居！”":[12,416475,33645,1],"我搬到这里以后，认识了邻居张阿姨。":[12,450120,20565,1],"我爷爷八十岁了，身体还很好。":[12,470685,18405,1,0.91],"我相信你一定能做好。":[12,489090,11445,1],"朋友要离开北京了，我很难过。":[12,500535,17925,1],"热情":[12,518460,4965,1],"照顾":[12,523425,4725,1],"爷爷":[12,528150,4605,1,0.87],"爸爸妈妈不同意我一个人去旅游。":[12,532755,16365,1],"现在我们的关系就像一家人一样。":[12,549120,17205,1],"生气":[12,566325,4485,1,0.89],"相信":[12,570810,4365,1,0.89],"礼物":[12,575175,4605,1],"祝":[12,579780,3885,1,0.43],"祝你生日快乐！":[12,583665,8805,1],"结婚":[12,592470,4725,1,0.75],"虽然下雨了，但是他还是来了。":[12,597195,18045,1],"虽然他很忙，但是他经常给我打电话。":[12,615240,21405,1],"虽然她已经不工作了，但是每天都很忙：早上去锻炼身体，下午去学校接孩子。":[12,636645,44085,1],"见面":[12,680730,4725,1,0.85],"谢谢你的关心。":[12,685455,8925,1],"还没有。奶奶好像什么都有。":[12,694380,17085,1,0.95],"这是我送给你的礼物。":[12,711465,10605,1,0.88],"这里的人都很热情。":[12,722070,10845,1],"连我奶奶都会用手机了。":[12,732915,12645,1],"阿姨":[12,745560,4845,1],"阿姨，您好！张叔叔在家吗？":[12,750405,19965,1],"难过":[12,770370,4725,1],"三千":[13,0,4965,1,0.96],"不用，谢谢。请问，这几天有什么节日吗？|m":[13,4965,28845,1],"世界":[13,33810,4845,1,0.95],"中国人":[13,38655,6165,1,0.8],"中秋节":[13,44820,6045,1],"中秋节是中国很重要的节日，这一天，家里人都要回家见面。":[13,50865,35445,1],"举行":[13,86310,4965,1,0.91],"久":[13,91275,3645,1,0.53],"了解":[13,94920,4845,1,0.97],"他普通话说得跟中国人一样好。":[13,99765,16365,1],"他的汉语水平提高得很快。":[13,116130,13725,1],"他笑了笑，表示同意。":[13,129855,13245,1,0.93],"你在中国住了多久了？":[13,143100,11205,1],"北京有三千多年的历史。":[13,154305,12645,1],"历史":[13,166950,5085,1,0.81],"去别的国家旅游，一定要带护照。":[13,172035,19005,1],"去年九月，她的朋友小李请她去家里过中秋节。":[13,191040,25605,1,0.95],"国家":[13,216645,4605,1,0.64],"太好了！我一直想了解中国的节日文化。|m":[13,221250,21405,1],"她很喜欢中国文化，一直想多了解一下中国人的节日。":[13,242655,27645,1,0.97],"她觉得这个节日既有意思又让人快乐。":[13,270300,19365,1],"好的，这是我的护照。|m":[13,289665,14325,1],"学校每年都举行一次体育比赛。":[13,303990,15045,1],"安娜来中国已经一年了。":[13,319035,12285,1],"家人":[13,331320,4725,1],"宾馆":[13,336045,4485,1,0.85],"对孩子来说，这个故事有点难。":[13,340530,17805,1],"对安娜来说，这是她第一次在中国人家里过中秋节。":[13,358335,27165,1,0.85],"对我来说，普通话不太难。":[13,385500,15765,1],"小李的奶奶给安娜讲了一个关于月亮的故事。":[13,401265,20205,1],"您好，欢迎！请给我看一下您的护照。":[13,421470,23085,1,0.96],"您的房间在八层。需要我们把行李箱送上去吗？":[13,444555,25245,1],"我一次也没去过那个国家。":[13,469800,12165,1,0.94],"我一点也不累。":[13,481965,8325,1,0.95],"我想了解中国文化。":[13,490290,10845,1,0.75],"我想去世界上很多国家看看。":[13,501135,16485,1,0.96],"护照":[13,517620,4725,1,0.85],"故事":[13,522345,4605,1,0.86],"文化":[13,526950,4965,1,0.73],"既":[13,531915,3885,1,0.37],"明天是中秋节。晚上很多人会和家人一起看月亮。":[13,535800,27045,1],"春节":[13,562845,4965,1],"春节是中国最重要的节日。":[13,567810,14925,1],"晚上，大家坐在一起，一边吃东西一边看月亮。":[13,582735,28725,1],"普通话":[13,611460,5925,1],"有名":[13,617385,4605,1],"来说":[13,621990,4845,1],"根据":[13,626835,4725,1,0.9],"根据地图，宾馆就在前面。":[13,631560,16005,1,0.96],"水平":[13,647565,5085,1,0.85],"爷爷经常给我讲故事。":[13,652650,11685,1],"节日":[13,664335,4725,1,0.88],"虽然有的地方安娜听不懂，但是她很喜欢这个故事。":[13,669060,27045,1],"行李箱":[13,696105,5925,1,0.78],"表示":[13,702030,4965,1],"过去":[13,706995,4605,1,0.88],"过去她只在书上读过关于中国的故事，现在她觉得自己真的开始了解中国了。":[13,711600,38805,1,0.92],"过去这里只有几家商店。":[13,750405,12525,1,0.93],"这个节日既有意思又让人快乐。":[13,762930,16005,1],"这个行李箱是谁的？":[13,778935,10485,1,0.96],"这家宾馆既干净又便宜。":[13,789420,12765,1],"这家饭馆非常有名。":[13,802185,11205,1],"这次旅游你带了几个行李箱？":[13,813390,14205,1,0.91],"这段时间我很忙。":[13,827595,10605,1,0.97],"上网":[14,0,4365,1,0.94],"不一定。这里工作机会多，买东西也方便，但是环境不太好。|m":[14,4365,36285,1],"为了使城市的环境更好，最近几年，城市里出现了很多新公园和花园，河边也种了很多树。":[14,40650,48765,1],"人们几乎每天都上网，用手机买东西、看新闻。":[14,89415,26445,1,0.94],"他家有一个小花园。":[14,115860,10725,1],"以前是。现在我觉得只有环境好，人才会健康快乐。|m":[14,126585,31005,1],"但是城市大了，车也多了，环境比过去差了。":[14,157590,26205,1,0.97],"住在这里买东西很方便。":[14,183795,13125,1],"你一般上网做什么？":[14,196920,10605,1],"你不是最喜欢大城市吗？":[14,207525,13005,1],"你不是说今天要来吗？":[14,220530,11565,1,0.83],"你在北京看过熊猫吗？":[14,232095,11925,1],"你打算一直住在这个城市吗？":[14,244020,14445,1],"使":[14,258465,3645,1,0.42],"公园":[14,262110,4485,1,0.93],"公园让这个城市更漂亮了。":[14,266595,14925,1],"公园里有很多树和花。":[14,281520,11805,1,0.95],"几乎":[14,293325,4725,1,0.89],"出现":[14,298050,4965,1,0.89],"动物":[14,303015,4125,1],"变化":[14,307140,4845,1,0.75],"只有":[14,311985,4605,1,0.8],"只有你去，他才会去。":[14,316590,14085,1],"只有多练习，才能说好汉语。":[14,330675,17085,1],"只有大家都关心环境，城市才会越来越漂亮。":[14,347760,24165,1],"听到":[14,371925,4485,1],"城市":[14,376410,5205,1],"城市里出现了很多新公园。":[14,381615,14565,1],"天气不好会影响我们的比赛。":[14,396180,14925,1],"影响":[14,411105,4965,1,0.83],"我们不是朋友吗？":[14,416070,9045,1],"我几乎每天都上网。":[14,425115,10965,1,0.79],"我在这个城市住了二十年了，这些年城市的变化非常大。":[14,436080,29205,1],"我打算以后一直住在这里。":[14,465285,13365,1],"我打算以后住在一个小城市，那里有河，有树，还能听到鸟叫。|m":[14,478650,40485,1],"我每天早上都看新闻。":[14,519135,12045,1],"我相信，只有大家都关心环境，我们的城市才会越来越漂亮。":[14,531180,35685,1,0.92],"打算":[14,566865,4845,1],"新闻":[14,571710,4845,1],"方便":[14,576555,4965,1,0.87],"是啊，车越来越多，公园越来越少。":[14,581520,21765,1],"树":[14,603285,3045,1,0.41],"树上有两只鸟。":[14,606330,9645,1],"河边有很多人在跑步。":[14,615975,12285,1,0.89],"河里的鱼越来越少，树上也几乎看不到鸟了。":[14,628260,23565,1,0.91],"熊猫":[14,651825,4845,1,0.8],"熊猫是一种很可爱的动物。":[14,656670,14085,1],"环境":[14,670755,5085,1,0.89],"现在，河里又有鱼了，树上的鸟也多了。":[14,675840,23685,1,0.91],"花园":[14,699525,4965,1],"车":[14,704490,3285,1,0.38],"边":[14,707775,4005,1,0.4],"过去这里只有几条街道，几乎没有高楼；现在高楼越来越多，地铁也越来越多，去哪里都很方便。":[14,711780,52485,1],"这个周末你打算做什么？":[14,764265,12285,1],"这个城市的变化太大了！":[14,776550,12765,1,0.97],"这个问题很简单，谁不会啊？":[14,789315,17685,1,0.91],"这件事情使我很难过。":[14,807000,11565,0,0.93],"这几年，城市里的车越来越多。":[14,818565,18885,1]}}