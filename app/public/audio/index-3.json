{"files":["h3u01.f9ad0129.mp3","h3u02.6818a4a6.mp3","h3u03.e27787c5.mp3","h3u04.e7e74373.mp3","h3u05.98eab62c.mp3","h3u06.be8616fa.mp3","h3u07.279ec80a.mp3","h3u08.897d5dfc.mp3","h3u09.b703baa5.mp3","h3u10.af6abe4b.mp3","h3u11.fc9f7476.mp3","h3u12.bd3459c4.mp3","h3u13.d12f508b.mp3","h3u14.b26a01dc.mp3","h3u15.07473d31.mp3"],"clips":{"一会儿":[0,0,4725,1],"一般":[0,4725,4485,1,0.87],"七点一刻我从家里出去，坐公共汽车去公司，二十分钟就到了。":[0,9210,33285,1,0.9],"下午五点半下班，我一回家就开始做饭。":[0,42495,21645,1,0.88],"下班":[0,64140,5325,1],"中午我在公司吃饭，吃完以后休息一会儿。":[0,69465,21765,1],"习惯":[0,91230,4245,1,0.9],"他一下班就去跑步。":[0,95475,10845,1],"他总是先喝咖啡，然后开始工作。":[0,106320,19845,1],"他昨天十点才起床。":[0,126165,11685,1],"他晚上一般十一点睡觉。":[0,137850,13485,1],"以前":[0,151335,4725,1],"以后":[0,156060,4605,1,0.94],"以后十一点以前睡觉吧。":[0,160665,13005,1,0.97],"你一般几点起床？":[0,173670,10245,1,0.97],"你为什么不吃早饭？":[0,183915,10485,1,0.9],"你为什么总是迟到？":[0,194400,9885,1,0.88],"你先休息一会儿，再工作吧。":[0,204285,16125,1],"你先休息一会儿，然后再工作。":[0,220410,17325,1],"你早上洗澡一般用多长时间？":[0,237735,15045,1],"出去":[0,252780,4845,1,0.93],"刷":[0,257625,3285,1,0.56],"刻":[0,260910,2925,1,0.44],"半":[0,263835,2805,1,0.45],"吃完早饭以后，我去学校。":[0,266640,16245,1],"吃完饭以后，我经常去跑步。":[0,282885,17685,1],"啊":[0,300570,2805,1,0.31],"啊，已经八点了！我要迟到了！":[0,303375,21645,1,0.79],"好的，我马上去工作。|m":[0,325020,15165,1],"好，我马上就来！":[0,340185,12165,1],"妈妈六点就起床了。":[0,352350,10965,1],"孩子已经会自己穿衣服了。":[0,363315,13365,1],"对不起，我七点半才起床。|m":[0,376680,18045,1],"对不起，我以后不会再迟到了。":[0,394725,17445,1,0.95],"小王":[0,412170,4845,1],"小王，你今天为什么迟到了？":[0,417015,16845,1],"差":[0,433860,3165,1,0.4],"总是":[0,437025,4845,1,0.88],"我一下班就回家。":[0,441870,9885,1,0.81],"我一回家就洗澡。":[0,451755,9285,1,0.88],"我一般七点五十到公司，很少迟到。":[0,461040,19365,1],"我一般六点半就起床了。昨天晚上我看电影看到一点。|m":[0,480405,30165,1],"我习惯早上喝咖啡。":[0,510570,11565,1,0.89],"我习惯早上洗澡。":[0,522135,10365,1,0.97],"我们七点一刻出去吧。":[0,532500,10725,1],"我先洗澡，然后吃早饭。":[0,543225,15525,1],"我叫王明，在一家公司工作。":[0,558750,17205,1],"我每天早上七点半起床。":[0,575955,13005,1],"我每天早上六点半起床，先洗澡、刷牙，然后吃早饭。":[0,588960,35205,1,0.89],"我经常晚上去跑步。":[0,624165,11445,1,0.92],"早饭":[0,635610,4965,1],"星期六和星期天我九点才起床。":[0,640575,17205,1],"晚上我十一点睡觉，睡觉以前总是看一会儿书。":[0,657780,24525,1],"洗澡":[0,682305,4245,1,0.97],"然后":[0,686550,4845,1,0.78],"现在差一刻八点。":[0,691395,10725,1],"睡觉以前要刷牙。":[0,702120,10485,1],"经常":[0,712605,4965,1],"自己":[0,717570,4725,1,0.83],"迟到":[0,722295,4845,1,0.93],"马上":[0,727140,4845,1],"一样":[1,0,3885,1,0.95],"今天比昨天冷多了。":[1,3885,11085,1,0.95],"今天比较冷，你多穿点衣服。":[1,14970,16605,1],"今天的天气好极了。":[1,31575,10605,1,0.88],"他以前很胖，现在瘦了。":[1,42180,15765,1],"他很高，他弟弟更高。":[1,57945,13965,1],"他跟他爸爸一样，特别喜欢运动。":[1,71910,19005,1],"位":[1,90915,2925,1,0.46],"你长得很像你妈妈。":[1,93840,10725,1,0.96],"像":[1,104565,3165,1,0.48],"可爱":[1,107730,4605,1,0.81],"哥哥比我大三岁，他跟爸爸一样高，比我高多了。":[1,112335,26925,1],"哥哥非常聪明，学习比我好。":[1,139260,17805,1],"大家都说我长得像妈妈，哥哥长得像爸爸。":[1,157065,22485,1],"头发":[1,179550,4725,1,0.85],"她以前头发很长，现在很短。":[1,184275,18165,1],"她是我们班最聪明的学生。":[1,202440,14085,1],"她是我姐姐。|m":[1,216525,8565,1],"她比你大吗？":[1,225090,7485,1],"她比我大两岁，也比我高一点。|m":[1,232575,17685,1],"她跟你长得特别像！":[1,250260,10845,1],"好看":[1,261105,4965,1],"妈妈比爸爸小两岁，她的头发很短，看上去特别年轻。":[1,266070,30765,1],"年轻":[1,296835,4725,1,0.83],"我哥哥比我大三岁。":[1,301560,11085,1,0.86],"我家有爸爸、妈妈、哥哥和我。":[1,312645,20565,1],"我比较矮，也比较瘦。":[1,333210,14925,1],"我比较矮，我弟弟比我还矮。":[1,348135,17205,1,0.91],"我没有哥哥那么聪明，但是我比他更喜欢运动。":[1,365340,23085,1],"我没有我哥哥那么高。":[1,388425,10365,1],"我爱我的家人。":[1,398790,8685,1],"我的手机跟你的不一样。":[1,407475,11685,1],"我觉得你比以前年轻了。":[1,419160,11925,1],"我跟我哥哥一样高。":[1,431085,10245,1],"戴":[1,441330,2925,1,0.46],"是吗？很多人都说我们很像。|m":[1,444255,18405,1],"更":[1,462660,2925,1,0.44],"比较":[1,465585,4485,1],"没有":[1,470070,4365,1,0.87],"爸爸五十岁了，很高，有一点胖，戴眼镜。":[1,474435,26565,1,0.96],"特别":[1,501000,4725,1],"相同":[1,505725,4965,1],"眼镜":[1,510690,4845,1,0.83],"聪明":[1,515535,4845,1],"胖":[1,520380,2805,1,0.4],"这两个孩子的脸特别像。":[1,523185,12765,1],"这两个手机，你觉得哪个更好看？":[1,535950,18645,1],"这两件衣服的颜色相同。":[1,554595,12885,1],"这个孩子可爱极了！":[1,567480,10845,1,0.87],"这位老师特别年轻。":[1,578325,10845,1,0.85],"那个戴眼镜的人是我们老师。":[1,589170,14685,1],"那个戴眼镜的女人是谁？":[1,603855,12285,1],"那么":[1,616140,4365,1,0.93],"那位老先生是谁？":[1,620505,10365,1],"上个星期考试，她的汉语成绩不太好，她很不高兴。":[2,0,30045,1],"不客气。你每天都要认真地复习。":[2,30045,20565,1],"他每天都很认真地复习。":[2,50610,13485,1],"他汉语说得很好。":[2,64095,10005,1],"他的字写得很清楚。":[2,74100,10965,1],"他这次的成绩比上次好多了。":[2,85065,15405,1],"作业":[2,100470,4605,1,0.96],"你作业做完了吗？":[2,105075,9045,1,0.77],"你复习好了吗？明天就考试了。":[2,114120,17565,1,0.96],"你弟弟上几年级？":[2,131685,9765,1,0.96],"你明白这个词语的意思吗？":[2,141450,12645,1],"你看见我的铅笔了吗？":[2,154095,10965,1],"努力":[2,165060,4485,1],"句子":[2,169545,4845,1,0.77],"啊，我明白了！一点也不难。谢谢你！|m":[2,174390,22965,1,0.91],"地":[2,197355,2805,1,0.36],"复习":[2,200160,4965,1,0.79],"她学习非常努力。":[2,205125,10125,1],"她学习非常努力，每天晚上都认真地复习。":[2,215250,23565,1],"她最喜欢数学，觉得数学题很容易，但是她觉得汉语比较难。":[2,238815,32925,1],"容易":[2,271740,4605,1,0.86],"年级":[2,276345,4845,1],"慢慢":[2,281190,4485,1],"成绩":[2,285675,5085,1,0.95],"我一写完作业就去睡觉。":[2,290760,12525,1,0.86],"我已经做完作业了。":[2,303285,10365,1],"我想提高我的数学成绩。":[2,313650,12765,1],"我每天都练习写字。":[2,326415,10845,1],"我看看。你先看这个句子，明白了吗？":[2,337260,24765,1],"提高":[2,362025,4725,1],"数学":[2,366750,4965,1,0.86],"数学太难了，我不喜欢。":[2,371715,15165,1],"明白":[2,386880,4605,1],"李月明白了老师的意思，现在她每天都练习写字半个小时。":[2,391485,28485,1],"李月是三年级的学生。":[2,419970,10965,1,0.92],"校长":[2,430935,5085,1,0.69],"校长在跟老师们说话。":[2,436020,12165,1,0.94],"汉语的词语很多，句子也不简单。":[2,448185,18645,1],"清楚":[2,466830,4965,1,0.94],"简单":[2,471795,4725,1],"练习":[2,476520,4965,1],"老师们":[2,481485,5445,1],"老师告诉她：“你每天练习写字，多读书，成绩就会提高。”":[2,486930,35565,1],"老师和同学们都为她高兴。":[2,522495,15045,1],"老师的问题你听懂了吗？":[2,537540,12285,1],"老师，黑板上的字我没看清楚。":[2,549825,18885,1],"认真":[2,568710,4605,1,0.89],"词语":[2,573315,3885,1,0.78],"请你慢慢地说。":[2,577200,8685,1],"请你慢慢地说，说清楚一点。":[2,585885,16845,1],"请大家看黑板。":[2,602730,8925,1],"还没有。这个数学题太难了，我不明白。|m":[2,611655,26205,1],"这个句子我写错了。":[2,637860,10605,1,0.88],"这个题很简单，谁都会做。":[2,648465,16125,1,0.96],"这次考试不难，比较容易。":[2,664590,16365,1,0.87],"这次考试，她的成绩比上次好多了。":[2,680955,20085,1],"铅笔":[2,701040,4725,1,0.88],"难":[2,705765,3285,1,0.39],"黑板":[2,709050,4965,1],"上个月我搬家了，很多朋友都来帮忙。":[3,0,20925,1],"上去":[3,20925,5325,1],"今天晚上家里有客人。":[3,26250,12045,1],"他每天都打扫房间。":[3,38295,11085,1],"你把那本书拿给我，好吗？":[3,49380,15525,1],"冰箱":[3,64905,4965,1,0.92],"出去以前请把灯关了。":[3,69870,11685,1,0.72],"厨房":[3,81555,5085,1],"厨房里有一个新冰箱，房间里还有空调。":[3,86640,22005,1],"在几层？有电梯吗？|m":[3,108645,15525,1,0.94],"在十二层，有电梯。我们可以坐电梯把冰箱搬上去。":[3,124170,30765,1],"在学校附近，那里很安静。":[3,154935,16485,1],"声音":[3,171420,5085,1,0.93],"大家都说我的新家很漂亮。":[3,176505,14445,1],"太好了。我明天早上八点到。|m":[3,190950,17445,1],"太热了，开一下空调吧。":[3,208395,17325,1],"妈妈正在厨房里做饭。":[3,225720,12165,1],"安静":[3,237885,4845,1],"客人":[3,242730,4485,1,0.9],"客人来以前，我把房间打扫得干干净净，还准备了很多水果。":[3,247215,33765,1],"家里":[3,280980,4605,1],"小张":[3,285585,4485,1,0.94],"小张，明天我搬家，你能来帮忙吗？":[3,290070,22245,1],"帮忙":[3,312315,4485,1],"干净":[3,316800,4725,1,0.8],"我下个月要搬家。":[3,321525,9645,1],"我们坐电梯上楼吧。":[3,331170,10365,1,0.97],"我们把冰箱搬到厨房去吧。":[3,341535,13605,1],"我家在六层，没有电梯。":[3,355140,14805,1],"我家附近有很多饭馆。":[3,369945,11925,1,0.9],"我家附近有很多饭馆和商店，买东西、吃饭都不用走很远。":[3,381870,33645,0,0.93],"我已经把房间打扫干净了。":[3,415515,13605,1],"我的邻居是一位老医生。":[3,429120,12165,1],"我的邻居是一位老医生，他人很好，经常跟我说话。":[3,441285,28965,1],"我还没把作业做完。":[3,470250,10485,1],"打扫":[3,480735,4845,1],"把":[3,485580,3645,1,0.67],"搬":[3,489225,3165,1,0.46],"新家不大，但是很干净，也很安静。":[3,492390,22485,1],"新家在五层，楼里有电梯。":[3,514875,16485,1],"旧":[3,531360,2925,1,0.4],"明天你能来帮忙吗？":[3,534285,10365,1],"昨天晚上，我请了几个朋友来我家吃饭。":[3,544650,22005,1],"桌子上放着很多东西。":[3,566655,12405,1],"没问题。你的新家在哪里？|m":[3,579060,17685,1],"灯还开着，他还没睡觉。":[3,596745,15525,1],"电梯":[3,612270,4965,1],"空调":[3,617235,4845,1],"空调开着，别开门。":[3,622080,13125,1],"请把书放在桌子上。":[3,635205,11205,1],"这个冰箱太旧了，我想买个新的。":[3,646410,18525,1],"这里很安静，我很喜欢。":[3,664935,15405,1,0.96],"邻居":[3,680340,4965,1,0.93],"邻居家的声音太大了。":[3,685305,11805,1],"附近":[3,697110,4965,1,0.83],"下午我去图书馆借字典，但是那本字典已经被别人借走了。":[4,0,30045,1],"不要拿别人的东西。":[4,30045,10125,1],"他昨天去了北京。":[4,40170,10245,1,0.97],"他请我喝咖啡，我们说了很多以前的事情。":[4,50415,23085,1,0.96],"你刚才去哪里了？":[4,73500,9765,1],"你刚才把包放在哪里了？":[4,83265,12885,1],"你怎么了？别着急，慢慢说。":[4,96150,19365,1],"你还记得我吗？":[4,115515,7965,1],"借":[4,123480,2925,1,0.47],"刚才":[4,126405,4845,1],"别人":[4,131250,4245,1,0.84],"别着急，我们慢慢找。":[4,135495,15285,1],"发现":[4,150780,5085,1,0.97],"啊，你看！我的包在那里！|m":[4,155865,19005,1],"回家的时候，我在路上遇到了一个以前的同学。":[4,174870,24165,1],"图书馆":[4,199035,5925,1,0.75],"在公共汽车上，我突然发现钱包不在包里。":[4,204960,23805,1],"在图书馆，我把包放在桌子上，然后去借书了。|m":[4,228765,27885,1],"坏":[4,256650,3045,1,0.56],"奇怪":[4,259695,4605,1],"字典":[4,264300,3885,1,0.85],"孩子哭了，他怎么了？":[4,268185,13485,1,0.91],"小心":[4,281670,4845,1],"小心！杯子里的水很热。":[4,286515,15525,1,0.97],"忘记":[4,302040,4845,1,0.88],"我从图书馆借了两本书。":[4,306885,12645,1],"我们正在跑步，突然下雨了。":[4,319530,16485,1],"我刚才遇到了一个老朋友。":[4,336015,13005,1,0.89],"我发现我的钱包不在包里。":[4,349020,13725,1],"我可以借你的字典用一下吗？":[4,362745,14445,1],"我很着急，早饭也没吃就出去了。":[4,377190,19005,1],"我忘记他的名字了。":[4,396195,10365,1],"我想了一会儿，才记得钱包放在家里的桌子上了。":[4,406560,24525,1],"我找不到我的包了！|m":[4,431085,10365,1],"我没吃过这个菜。":[4,441450,9645,1],"我的包被人拿走了！":[4,451095,10125,1,0.91],"我的字典被别人借走了。":[4,461220,12285,1,0.86],"我的电脑被弟弟用坏了。":[4,473505,12045,1,0.82],"早上我的手机坏了，我七点半才起床。":[4,485550,21405,1],"昨天是很奇怪的一天。":[4,506955,12165,1],"是不是":[4,519120,5685,1,0.94],"是不是被别人拿走了？":[4,524805,11565,1],"是不是被别人拿走了？我们去问问吧。":[4,536370,19725,1],"最近":[4,556095,4965,1,0.87],"最近我很忙，没时间看书。":[4,561060,16725,1,0.95],"电脑坏了，我的作业都没有了！":[4,577785,17085,1,0.96],"真奇怪，他今天为什么没来？":[4,594870,17685,1],"着急":[4,612555,4845,1],"突然":[4,617400,4485,1,0.78],"被":[4,621885,2925,1,0.36],"记得":[4,624810,4605,1,0.81],"这是我昨天最高兴的时候。":[4,629415,13485,1],"这本书你看过没有？":[4,642900,10485,1,0.89],"遇到":[4,653385,4485,1,0.81],"钱包":[4,657870,4725,1,0.89],"问问":[4,662595,4605,1],"一直":[5,0,4605,1],"一直往东走，就是地铁站。":[5,4605,15885,1],"上个星期六，我第一次去朋友小张家。":[5,20490,21645,1],"下来":[5,42135,4965,1],"不远，走十分钟就到了。|m":[5,47100,15885,1],"中间":[5,62985,4485,1],"五百":[5,67470,4605,1,0.95],"他从包里拿出来一张地图。":[5,72075,14205,1],"他从楼上走下来了。":[5,86280,11085,1],"他家离地铁站很近，是我走错了。":[5,97365,19245,1,0.97],"他已经离开北京了。":[5,116610,10845,1],"你什么时候回来？":[5,127455,9285,1,0.94],"你有地图吗？我们好像走错了。":[5,136740,17445,1],"你骑过马吗？":[5,154185,7965,1],"出来":[5,162150,4725,1,0.93],"前":[5,166875,3405,1,0.5],"南":[5,170280,3285,1,0.39],"去学校要经过一个医院。":[5,173565,12405,1,0.83],"司机":[5,185970,4845,1,0.91],"商店在学校和医院中间。":[5,190815,13845,1],"回来":[5,204660,4725,1,0.67],"地图":[5,209385,4725,1,0.84],"地方":[5,214110,4605,1,0.71],"地铁":[5,218715,4605,1,0.75],"地铁比公共汽车快多了。":[5,223320,13005,1],"地铁站":[5,236325,5565,1],"地铁站就在学校的西边。":[5,241890,13005,1],"地铁站里有洗手间吗？":[5,254895,12045,1],"好像":[5,266940,4965,1],"小张给我打电话，告诉我怎么走：“你先坐地铁到东门站，从二号口出来。":[5,271905,40005,1],"往":[5,311910,3645,1,0.54],"往南走五分钟就到了。":[5,315555,11325,1],"快进来吧，别站在门口。":[5,326880,15645,1],"我从地铁站出来以后，不知道哪边是南边，就往西走了。":[5,342525,29325,1,0.91],"我家就在一个商店和一个饭馆中间。”":[5,371850,16725,1,0.97],"我家离地铁站五百米。":[5,388575,10605,1,0.91],"我给小张打电话，他骑自行车来接我。":[5,399180,21165,1],"明天我去机场接你。":[5,420345,11205,1,0.85],"有。你一直往前走，经过一个医院，就能看见地铁站了。|m":[5,431550,31125,1],"有，就在二号口旁边。过马路的时候小心一点。|m":[5,462675,27765,1],"洗手间":[5,490440,6285,1],"然后一直往南走，经过一个医院，过了马路就到了。":[5,496725,27645,1],"离开":[5,524370,4605,1],"离这里远吗？":[5,528975,7485,1,0.95],"经过":[5,536460,4605,1,0.78],"街道":[5,541065,4725,1,0.87],"西边":[5,545790,4125,1,0.91],"请问":[5,549915,4725,1,0.94],"请问，洗手间在哪里？":[5,554640,14685,1,0.97],"请问，附近有地铁站吗？":[5,569325,15165,1,0.97],"走了二十分钟，我还没找到。":[5,584490,16365,1],"辆":[5,600855,2925,1,0.44],"过马路的时候要小心。":[5,603780,11685,1],"这个地方我以前来过。":[5,615465,11205,1,0.9],"这里的街道很干净。":[5,626670,10845,1],"进来":[5,637515,4725,1,0.91],"那个司机开得很快。":[5,642240,9405,1,0.87],"门口":[5,651645,4845,1],"门口有一辆出租车。":[5,656490,10965,1,0.96],"马路":[5,667455,4845,1],"一公斤葡萄十二块五角。":[6,0,13485,1],"一碗面条十块钱，又好吃又能吃饱。":[6,13485,20085,1],"中国菜又好吃又便宜，但是菜单上的字她都看不懂，服务员的问题她也听不懂，所以她每次都点面条。":[6,33570,53325,1],"他又饿又累，一回家就睡觉了。":[6,86895,17565,1,0.9],"你们":[6,104460,4365,1,0.95],"你们吃饱了吗？要不要来点蛋糕？":[6,108825,17565,1],"你会用筷子吗？":[6,126390,8445,1],"你吃得完这碗面条吗？":[6,134835,11205,1],"分":[6,146040,3285,1,0.48],"又":[6,149325,2805,1,0.43],"吃完饭，她还喜欢买一点水果，香蕉、葡萄她都喜欢。":[6,152130,34005,1,0.92],"咖啡里要放糖吗？":[6,186135,9885,1,0.97],"啤酒":[6,196020,4965,1,0.79],"她经常去学校旁边的一家小饭馆，那里的菜很新鲜，服务员都认识她。":[6,200985,37725,1],"她说：“在中国，我每天都吃得很饱！”":[6,238710,23925,1],"安娜第一次来中国的时候，不会用筷子，吃饭吃得很慢。":[6,262635,31365,1],"您好":[6,294000,4725,1],"您好，这是菜单。你们吃点什么？":[6,298725,20925,1,0.79],"我们要两碗面条。有什么喝的？|m":[6,319650,17565,1],"我吃了两碗米饭，吃饱了。":[6,337215,14925,1],"我渴极了，想喝一杯果汁。":[6,352140,14925,1,0.88],"我饱了，真的吃不了了。":[6,367065,15165,1],"我饿了，我们去吃饭吧。":[6,382230,15165,1,0.93],"找你两块三角五分。":[6,397395,10845,1],"新鲜":[6,408240,4365,1,0.9],"早上我一般吃面包，喝牛奶。":[6,412605,17085,1],"明天我有事情，去不了。":[6,429690,14805,1],"有果汁、啤酒和茶。":[6,444495,13605,1,0.82],"服务员，来两杯啤酒！":[6,458100,14805,1],"服务员，请把菜单给我们。":[6,472905,16245,1],"来两杯果汁吧。|m":[6,489150,8925,1],"果汁":[6,498075,4725,1,0.82],"现在她已经会用筷子了，也看得懂菜单了。":[6,502800,22365,1,0.87],"盘子":[6,525165,4725,1],"真的":[6,529890,4725,1],"碗":[6,534615,3645,1,0.56],"筷子":[6,538260,4725,1],"老师说得太快，我听不懂。":[6,542985,15765,1],"菜单":[6,558750,4965,1],"菜太多了，我们吃不完。":[6,563715,14925,1],"葡萄":[6,578640,4605,1,0.97],"蛋糕":[6,583245,4245,1],"角":[6,587490,4005,1,0.69],"请再给我一个盘子。":[6,591495,10605,1,0.97],"谢谢，我们已经吃饱了，吃不了了。|m":[6,602100,22005,1],"这个蛋糕太甜了。":[6,624105,10125,1,0.92],"这些鸡蛋是今天的，很新鲜。":[6,634230,17085,1,0.94],"这里的水果又新鲜又便宜。":[6,651315,14085,1],"面包":[6,665400,4725,1],"面条":[6,670125,4965,1],"香蕉":[6,675090,4845,1,0.89],"香蕉三块五一公斤。":[6,679935,11085,1],"下雨了，你有伞吗？":[7,0,14205,1],"下雪的北京多么漂亮啊！":[7,14205,12405,1,0.96],"下雪的时候，北京多么漂亮啊！":[7,26610,17685,1],"今天天气多么好啊！":[7,44295,10605,1,0.94],"今天太阳很好，我们出去走走吧。":[7,54900,19125,1],"今天最低零下五度。":[7,74025,10965,1],"今天的天特别蓝。":[7,84990,10485,1],"但是很多北京人都说，北京的秋天越来越短了。":[7,95475,25245,1],"你最喜欢哪个季节？":[7,120720,11085,1,0.84],"你看，今天的月亮真漂亮！":[7,131805,16845,1,0.95],"冬":[7,148650,2925,1,0.4],"冬天":[7,151575,4845,1,0.89],"冬天很冷，有时候零下十几度，但是房间里不冷。":[7,156420,28485,1],"冷极了！今天最低零下十度，还刮风。|m":[7,184905,22485,1],"刮":[7,207390,3045,1,0.49],"北京有四个季节：春天、夏天、秋天和冬天。":[7,210435,29325,1,0.93],"北京的春天经常刮风。":[7,239760,12645,1],"北方":[7,252405,4725,1,0.96],"北方的冬天比南方冷多了。":[7,257130,14205,1],"南方":[7,271335,4725,1],"喂，北京今天天气怎么样？":[7,276060,15765,1],"夏":[7,291825,3165,1,0.5],"夏天":[7,294990,5085,1],"夏天很热，经常下雨，出去的时候包里最好放一把伞。":[7,300075,31605,1],"多么":[7,331680,4125,1,0.86],"天上一点云也没有。":[7,335805,10965,1],"天气越来越冷了。":[7,346770,9885,1,0.97],"太阳":[7,356655,4845,1,0.87],"好啊":[7,361500,4125,0,0.95],"好啊！":[7,365625,4005,0,0.97],"季节":[7,369630,4845,1,0.82],"度":[7,374475,2685,1,0.42],"我们这里二十度，太阳很好。":[7,377160,16725,1],"我听人说明天会下雪。":[7,393885,12285,1],"我最喜欢秋天，不冷也不热。":[7,406170,16965,1],"我越看越喜欢这个地方。":[7,423135,12525,1,0.83],"春天":[7,435660,5085,1],"春天来了，花都开了。":[7,440745,14205,1],"春天的草是绿的，秋天就黄了。":[7,454950,18285,1],"春天经常刮风，有时候风很大，但是花都开了，非常漂亮。":[7,473235,35445,1],"月亮":[7,508680,4605,1,0.73],"来中国学习汉语的人越来越多。":[7,513285,15645,1],"真好！北方的冬天越来越冷了。|m":[7,528930,19245,1],"秋天":[7,548175,4845,1,0.84],"秋天是北京最好的季节，不冷也不热，天特别蓝，晚上的月亮也很漂亮。":[7,553020,40485,1],"绿":[7,593505,2805,1,0.38],"蓝":[7,596310,3285,1,0.45],"越":[7,599595,2805,1,0.46],"越来越":[7,602400,5445,1,0.88],"这里夏天很热，冬天很冷。":[7,607845,16485,1],"那你春天来我这里玩吧。这里的春天特别漂亮。":[7,624330,24285,1],"雨":[7,648615,3165,1,0.4],"雨越下越大。":[7,651780,7845,1,0.95],"零下":[7,659625,4845,1],"风":[7,664470,3165,1,0.45],"风越刮越大了。":[7,667635,8685,1],"一定":[8,0,4485,1,0.95],"七十":[8,4485,4965,1,0.82],"三十九":[8,9450,6405,1,0.77],"三十八":[8,15855,5805,1,0.86],"两天了。昨天晚上三十八度五。|m":[8,21660,16965,1,0.79],"从那以后，爸爸每天早上都去跑步，星期六还跟朋友一起去游泳。":[8,38625,36885,1,0.93],"他七十岁了，身体还很健康。":[8,75510,17685,1],"他发烧三十九度，需要马上去医院。":[8,93195,19845,1],"他每天在公司坐八个小时，回家以后就看电视。":[8,113040,25605,1],"他还少喝啤酒，多吃水果。":[8,138645,17205,1,0.95],"作用":[8,155850,4725,1,0.92],"你一定要去医院检查一下。":[8,160575,12645,1],"你哪里不舒服？":[8,173220,8565,1],"你应该多喝水，多休息。":[8,181785,16845,1],"健康":[8,198630,4965,1,0.92],"别担心，我已经好多了。":[8,203595,16245,1],"医生给他检查了身体，说：“你的身体没有大问题，但是你需要多锻炼。":[8,219840,37845,1],"医生说我需要休息两天。":[8,257685,12885,1,0.88],"医生说没问题，你放心吧。":[8,270570,15885,1],"去年冬天，他感冒了好几次，腿和脚也经常疼。":[8,286455,28245,1],"发烧":[8,314700,4965,1],"发烧几天了？":[8,319665,7725,1],"只":[8,327390,3525,1,0.36],"只要":[8,330915,4605,1],"只要你每天锻炼，身体就会越来越好。":[8,335520,21165,1],"只要多休息，你的感冒就会好。":[8,356685,17085,0,0.93],"天气冷了，注意别感冒。":[8,373770,14925,1],"如果":[8,388695,4605,1,0.77],"如果你不舒服，就回家休息吧。":[8,393300,17565,1],"如果你每天走路半个小时，身体就会好很多。”":[8,410865,24525,1],"如果明天下雨，我们就不去了。":[8,435390,17085,1,0.79],"应该":[8,452475,4605,1],"感冒":[8,457080,4245,1],"感冒的时候不应该喝啤酒。":[8,461325,15165,1],"我们都很担心他。":[8,476490,9525,1],"我发烧了，鼻子也不舒服。|m":[8,486015,15765,1],"我只吃了一点东西。":[8,501780,10605,1],"我感冒了，鼻子很不舒服。":[8,512385,15885,1],"我有点发烧，身体很不舒服。":[8,528270,17805,1],"我每天早上锻炼半个小时。":[8,546075,14085,1],"我爸爸工作很忙，以前很少锻炼。":[8,560160,19845,1],"我的脚疼了一个星期了。":[8,580005,11565,1],"我的腿很疼，走不了路。":[8,591570,15165,1],"我给你检查一下。你感冒了，不用担心。":[8,606735,23445,1],"我耳朵疼，听不清楚。":[8,630180,13845,1],"我需要吃药吗？|m":[8,644025,8565,1],"担心":[8,652590,4965,1],"放心":[8,657555,5085,1],"有点":[8,662640,4845,1,0.9],"检查":[8,667485,5325,1,0.68],"注意":[8,672810,4605,1,0.88],"爸爸经常说：“只要每天锻炼，身体就会越来越健康。”":[8,677415,29685,1],"现在爸爸很少感冒，我们都放心了。":[8,707100,20085,1],"耳朵":[8,727185,4005,1,0.88],"脚":[8,731190,4005,1,0.77],"舒服":[8,735195,4965,1,0.97],"这个药没什么作用。":[8,740160,10005,1],"锻炼":[8,750165,4365,1],"需要":[8,754530,4005,1,0.93],"需要。这个药一天吃三次。只要好好休息，几天就会好。":[8,758535,34125,1,0.92],"鼻子":[8,792660,4605,1],"一共":[9,0,4605,1],"万":[9,4605,2805,1,0.46],"三百五十":[9,7410,7485,1],"三百八十":[9,14895,7485,1],"三百八十块。除了鞋以外，您还需要别的吗？":[9,22380,25485,1],"不用了，谢谢。可以刷卡吗？|m":[9,47865,21165,1,0.89],"以外":[9,69030,4485,1],"你喜欢穿裙子还是裤子？":[9,73515,14205,1],"你来看看这双鞋怎么样。":[9,87720,12165,1],"你要红的还是白的？":[9,99885,10725,1],"其他":[9,110610,4605,1],"其他的颜色都卖完了。":[9,115215,11805,1,0.91],"别的":[9,127020,4605,1,0.89],"卡":[9,131625,3525,1,0.51],"可以刷卡吗？":[9,135150,7845,1],"商店里的衣服很多，有红的、白的、黑的，还有黄的。":[9,142995,36165,1],"在超市里，妈妈问我：“晚上吃面条还是米饭？”":[9,179160,26565,1],"好的。这双呢？":[9,205725,11205,1,0.96],"妈妈想给我买一条裙子，但是我更喜欢穿裤子。":[9,216930,25485,1,0.9],"妈妈问我：“你满意了吧？”":[9,242415,14325,1],"帽子":[9,256740,4845,1],"您好，您想买什么？":[9,261585,13245,1,0.84],"您看看这双怎么样？这种鞋卖得特别好。":[9,274830,20685,1,0.92],"想想":[9,295515,4365,1,0.83],"我们星期六或者星期天去买衣服吧。":[9,299880,17685,1,0.97],"我可以试试吗？……有点小，能换一双大一点的吗？|m":[9,317565,26205,1],"我可以试试这件衬衫吗？":[9,343770,12405,1,0.82],"我想买一双鞋。|m":[9,356175,9405,1],"我想想，明天再来买吧。":[9,365580,16485,1,0.94],"我要去银行换钱。":[9,382065,10005,1,0.97],"我试了好几条裤子，才找到一条又便宜又舒服的。":[9,392070,25965,1,0.93],"我说：“满意极了！”":[9,418035,12285,1,0.9],"我说：“面条或者米饭都可以。”":[9,430320,17925,1],"星期天":[9,448245,6165,1],"星期天下午，我和妈妈去商店买衣服。":[9,454410,21645,1],"条":[9,476055,3525,1,0.46],"满意":[9,479580,4725,1],"然后我们去超市买了一些水果和面包。":[9,484305,17805,1],"种":[9,502110,4005,1,0.61],"累了就好好休息休息。":[9,506115,11925,1],"衬衫":[9,518040,4845,1],"裙子":[9,522885,4965,1,0.82],"裤子":[9,527850,4965,1,0.89],"试试":[9,532815,4365,1,0.89],"超市":[9,537180,5085,1,0.9],"超市里东西很多，也很便宜。":[9,542265,17565,1],"这个帽子是我妈妈给我买的。":[9,559830,14205,1,0.93],"这些东西一共三百五十块。":[9,574035,14205,1],"这件衣服一万块？太贵了！":[9,588240,15285,1,0.93],"这件衣服你满意吗？":[9,603525,10605,1],"这双很舒服，我很满意。多少钱？|m":[9,614130,22245,1],"这双鞋太小了，能换一双吗？":[9,636375,16845,1,0.91],"这条裙子多少钱？":[9,653220,10485,1,0.85],"这条裤子有点长，有短一点的吗？":[9,663705,18885,1,0.91],"这种帽子有没有黑的？":[9,682590,11085,1,0.83],"银行":[9,693675,4725,1],"除了":[9,698400,4845,1,0.88],"除了我以外，大家都去了。":[9,703245,15525,1],"除了衬衫以外，我还买了一条裤子。":[9,718770,19485,1],"除了裤子以外，妈妈还给我买了一件衬衫和一双鞋，一共花了六百多块钱。":[9,738255,37485,1],"上个月，我们一起在学校表演了一个节目，大家都很喜欢。":[10,0,32685,1],"不但":[10,32685,4125,1,0.86],"什么表演":[10,36810,7005,1],"什么表演？":[10,43815,7005,1],"他一边听音乐，一边做作业。":[10,50820,17325,1],"他不但会画画，而且画得很好。":[10,68145,18525,1,0.83],"他不但喜欢唱歌，而且喜欢跳舞。":[10,86670,20205,1],"他不敢一个人晚上出去。":[10,106875,12165,1],"体育":[10,119040,4725,1],"你别总是玩游戏。":[10,123765,10005,1],"你敢一个人去爬山吗？":[10,133770,11565,1,0.94],"你有什么爱好？":[10,145335,8205,1],"你看，这是我去年夏天的照片。":[10,153540,18165,1,0.88],"你能教我游泳吗？":[10,171705,9405,1],"兴趣":[10,181110,4365,1,0.91],"去年我参加了学校的画画比赛，老师们都说我画得不错。":[10,185475,28725,1],"参加":[10,214200,4725,1],"周末":[10,218925,4725,1,0.65],"周末你想做什么？":[10,223650,9645,1],"周末我经常一边听音乐，一边画画。":[10,233295,20325,1],"太好了！晚上我们还可以去看一个表演。|m":[10,253620,21645,1],"孩子们":[10,275265,5685,1],"孩子们在学校表演了一个节目。":[10,280950,15045,1],"当然":[10,295995,4125,1],"当然可以，我明天教你。":[10,300120,14925,1],"当然！我最喜欢爬山了。我们可以一边爬山，一边说话。":[10,315045,33405,1],"感":[10,348450,3645,1,0.57],"我们一边爬山，一边说话。":[10,352095,16125,1],"我叫大卫，在北京学习汉语。":[10,368220,17205,1],"我对中国音乐也很感兴趣，所以我的中国朋友小李每个星期都教我唱歌。":[10,385425,36285,1,0.93],"我对中国音乐很感兴趣。":[10,421710,13485,1],"我对画画没有兴趣。":[10,435195,10485,1],"我弟弟很喜欢玩电子游戏。":[10,445680,13725,1],"我想买一个新照相机。":[10,459405,11685,1],"我想去爬山。你对爬山感兴趣吗？|m":[10,471090,19725,1,0.95],"我最喜欢上体育课。":[10,490815,11205,1],"我的爱好很多：听音乐、画画、爬山，还有玩电子游戏。":[10,502020,34485,0,0.95],"我的爱好是爬山和听音乐。":[10,536505,13725,1],"我觉得有爱好的人不但每天都很快乐，而且身体也很健康。":[10,550230,31125,1,0.96],"我还喜欢爬山，北京附近有很多地方可以爬山，我的照相机里有很多爬山的照片。":[10,581355,43845,1],"教":[10,625200,3285,1,0.51],"明天的比赛你参加吗？":[10,628485,11925,1],"是一个音乐节目。我的朋友也参加了，他不但会唱歌，而且还会跳舞。|m":[10,640410,39285,1],"比赛":[10,679695,4725,1,0.89],"游戏":[10,684420,4845,1,0.81],"照片":[10,689265,5085,1],"照相机":[10,694350,5925,1],"爬山":[10,700275,4125,1],"爱好":[10,704400,4125,0,0.95],"电子":[10,708525,4485,1,0.96],"画":[10,713010,3165,1,0.51],"画画":[10,716175,4245,0],"而且":[10,720420,4725,1,0.91],"节目":[10,725145,4605,1,0.77],"表演":[10,729750,4485,1,0.95],"这个周末你想做什么？":[10,734235,11445,1],"这个电视节目很有意思。":[10,745680,12885,1],"这次比赛我们班得了第一。":[10,758565,13365,1],"音乐":[10,771930,4725,1,0.89],"上个月，经理给了我一个机会，让我一个人完成一个重要的工作。":[11,0,33765,1],"上午九点。这个会议很重要，你必须参加。|m":[11,33765,25005,1],"下午三点有一个重要的会议。":[11,58770,13965,1],"为了":[11,72735,4365,1],"为了学习汉语，他来了中国。":[11,77100,16365,1],"为了找到这个工作，我准备了很长时间。":[11,93465,20445,1,0.88],"为了身体健康，我每天都锻炼。":[11,113910,17685,1],"主要":[11,131595,4605,1,0.85],"主要是关于买新电脑的事情。我们要选择一家公司。|m":[11,136200,27645,1],"他决定离开这家公司。":[11,163845,12045,1],"会议":[11,175890,4845,1,0.88],"会议主要说什么？":[11,180735,9405,1],"会议几点结束？":[11,190140,9045,1],"你先看看哪家公司的电脑又好又便宜。|m":[11,199185,20565,1],"你是什么时候来的？":[11,219750,9885,1,0.92],"你有什么好办法吗？":[11,229635,10245,1],"信":[11,239880,3165,1,0.37],"关于":[11,243045,4485,1],"关于这件事情，我们明天再说吧。":[11,247530,18525,1],"决定":[11,266055,4845,1,0.84],"办公室":[11,270900,5805,1],"办法":[11,276705,4845,1,0.8],"同事":[11,281550,4965,1,0.96],"同事们教我怎么解决问题，我也每天认真地学习。":[11,286515,24885,1,0.95],"在会议上，经理说我做得很好。":[11,311400,18165,1],"好的。我需要准备什么？":[11,329565,14805,1,0.84],"完成":[11,344370,4965,1,0.89],"开始工作的时候，我遇到了很多问题，每天都很着急。":[11,349335,29925,1],"张经理，明天的会议是几点？":[11,379260,18645,1],"必须":[11,397905,4845,1],"我不知道应该选择哪个。":[11,402750,12525,1],"我们公司主要卖电脑。":[11,415275,10485,1,0.95],"我们公司主要卖电脑和手机。":[11,425760,14805,1],"我们必须今天把这件事情做完。":[11,440565,15405,1],"我们必须在星期五以前完成。":[11,455970,15285,1],"我和同事经常一起吃饭。":[11,471255,13605,1,0.87],"我很高兴我选择了这家公司。":[11,484860,14925,1],"我是去年九月来这家公司工作的。":[11,499785,16965,1,0.86],"我是坐地铁来的。":[11,516750,9645,1,0.9],"我的同事都很年轻，也很聪明，我们经常一起吃饭。":[11,526395,28365,1],"我的经理姓张，他对工作要求很高，但是人很好。":[11,554760,28245,1],"我认为这个办法很好。":[11,583005,11565,1],"星期五":[11,594570,6165,1],"机会":[11,600735,4605,1],"没问题，我今天下午就能完成。":[11,605340,18525,1,0.97],"终于":[11,623865,4485,1],"经理":[11,628350,4605,1,0.86],"经理现在不在办公室。":[11,632955,12165,1],"经理要求我们八点以前到公司。":[11,645120,15765,1],"结束":[11,660885,4965,1,0.83],"要求":[11,665850,4965,1],"解决":[11,670815,4845,1,0.86],"认为":[11,675660,4725,1],"这个工作我们终于完成了！":[11,680385,13245,1],"这个问题已经解决了。":[11,693630,11445,1,0.92],"这是一个很好的机会。":[11,705075,11325,1],"这是一本关于中国的书。":[11,716400,12405,1],"这是谁给你的信？":[11,728805,9885,1],"选择":[11,738690,4965,1],"那几天我每天都工作到晚上九点，终于完成了。":[11,743655,25245,1],"重要":[11,768900,4725,1,0.86],"上个月我感冒了，一个人在家，很难过。":[12,0,23445,1],"下个星期是奶奶的生日，我们送她什么礼物？":[12,23445,22245,1],"他们":[12,45690,4365,1],"他们结婚十年了。":[12,50055,10125,1],"他忙得连饭都没时间吃。":[12,60180,13245,1],"以为":[12,73425,4485,1],"你愿意跟我结婚吗？":[12,77910,10245,1,0.87],"你说得对。那我们星期六去看她吧，再给她买一个蛋糕。":[12,88155,29325,1],"你跟他是什么关系？":[12,117480,9885,1,0.86],"八十":[12,127365,5085,1],"关心":[12,132450,4845,1,0.85],"关系":[12,137295,4845,1],"其实":[12,142140,4845,1,0.89],"其实奶奶最希望我们去看看她。虽然她不说，但是她很想我们。|m":[12,146985,34965,1],"别生气了，他已经说对不起了。":[12,181950,17445,1],"叔叔":[12,199395,4965,1,0.9],"同意":[12,204360,4725,1],"奶奶":[12,209085,4725,1],"奶奶生病了，妈妈在医院照顾她。":[12,213810,18765,1],"她很关心别人，连楼里每家人的名字她都记得。":[12,232575,24885,1],"好！爷爷也一定会很高兴。|m":[12,257460,17085,1],"害怕":[12,274545,4125,1,0.87],"张阿姨六十多岁了，对人非常热情。":[12,278670,20325,1],"张阿姨知道以后，每天都给我送饭，还经常来照顾我。":[12,298995,29925,1],"感冒好了以后，我买了一个礼物送给她。":[12,328920,20565,1],"愿意":[12,349485,4725,1],"我以为他是老师，其实他是学生。":[12,354210,19005,1,0.96],"我以为你不来了！":[12,373215,9045,1,0.96],"我以为你已经买好了！|m":[12,382260,11565,1],"我们很长时间没见面了。":[12,393825,12285,1],"我妹妹很害怕狗。":[12,406110,10365,1,0.88],"我想给她钱，她不同意，说：“你别给我钱，我们是邻居！”":[12,416475,33645,1],"我搬到这里以后，认识了邻居张阿姨。":[12,450120,20565,1],"我爷爷八十岁了，身体还很好。":[12,470685,18405,1,0.91],"我相信你一定能做好。":[12,489090,11445,1],"朋友要离开北京了，我很难过。":[12,500535,17925,1],"热情":[12,518460,4965,1],"照顾":[12,523425,4725,1],"爷爷":[12,528150,4605,1,0.87],"爸爸妈妈不同意我一个人去旅游。":[12,532755,16365,1],"现在我们的关系就像一家人一样。":[12,549120,17205,1],"生气":[12,566325,4485,1,0.89],"相信":[12,570810,4365,1,0.89],"礼物":[12,575175,4605,1],"祝":[12,579780,2925,1,0.35],"祝你生日快乐！":[12,582705,8805,1],"结婚":[12,591510,4725,1,0.75],"虽然下雨了，但是他还是来了。":[12,596235,18045,1],"虽然他很忙，但是他经常给我打电话。":[12,614280,21405,1],"虽然她已经不工作了，但是每天都很忙：早上去锻炼身体，下午去学校接孩子。":[12,635685,44085,1],"见面":[12,679770,4725,1,0.85],"谢谢你的关心。":[12,684495,8925,1],"还没有。奶奶好像什么都有。":[12,693420,17085,1,0.95],"这是我送给你的礼物。":[12,710505,10605,1,0.88],"这里的人都很热情。":[12,721110,10845,1],"连我奶奶都会用手机了。":[12,731955,12645,1],"阿姨":[12,744600,4845,1],"阿姨，您好！张叔叔在家吗？":[12,749445,19965,1],"难过":[12,769410,4725,1],"三千":[13,0,4965,1,0.96],"不用，谢谢。请问，这几天有什么节日吗？|m":[13,4965,28845,1],"世界":[13,33810,4845,1,0.95],"中国人":[13,38655,6165,1,0.8],"中秋节":[13,44820,6045,1],"中秋节是中国很重要的节日，这一天，家里人都要回家见面。":[13,50865,35445,1],"举行":[13,86310,4965,1,0.91],"久":[13,91275,3525,1,0.54],"了解":[13,94800,4845,1,0.97],"他普通话说得跟中国人一样好。":[13,99645,16365,1],"他的汉语水平提高得很快。":[13,116010,13725,1],"他笑了笑，表示同意。":[13,129735,13245,1,0.93],"你在中国住了多久了？":[13,142980,11205,1],"北京有三千多年的历史。":[13,154185,12645,1],"历史":[13,166830,5085,1,0.81],"去别的国家旅游，一定要带护照。":[13,171915,19005,1],"去年九月，她的朋友小李请她去家里过中秋节。":[13,190920,25605,1,0.95],"国家":[13,216525,4605,1,0.64],"太好了！我一直想了解中国的节日文化。|m":[13,221130,21405,1],"她很喜欢中国文化，一直想多了解一下中国人的节日。":[13,242535,27645,1,0.97],"她觉得这个节日既有意思又让人快乐。":[13,270180,19365,1],"好的，这是我的护照。|m":[13,289545,14325,1],"学校每年都举行一次体育比赛。":[13,303870,15045,1],"安娜来中国已经一年了。":[13,318915,12285,1],"家人":[13,331200,4725,1],"宾馆":[13,335925,4485,1,0.85],"对孩子来说，这个故事有点难。":[13,340410,17805,1],"对安娜来说，这是她第一次在中国人家里过中秋节。":[13,358215,27165,1,0.85],"对我来说，普通话不太难。":[13,385380,15765,1],"小李的奶奶给安娜讲了一个关于月亮的故事。":[13,401145,20205,1],"您好，欢迎！请给我看一下您的护照。":[13,421350,23085,1,0.96],"您的房间在八层。需要我们把行李箱送上去吗？":[13,444435,25245,1],"我一次也没去过那个国家。":[13,469680,12165,1,0.94],"我一点也不累。":[13,481845,8325,1,0.95],"我想了解中国文化。":[13,490170,10845,1,0.75],"我想去世界上很多国家看看。":[13,501015,16485,1,0.96],"护照":[13,517500,4725,1,0.85],"故事":[13,522225,4605,1,0.86],"文化":[13,526830,4965,1,0.73],"既":[13,531795,2925,1,0.35],"明天是中秋节。晚上很多人会和家人一起看月亮。":[13,534720,27045,1],"春节":[13,561765,4965,1],"春节是中国最重要的节日。":[13,566730,14925,1],"晚上，大家坐在一起，一边吃东西一边看月亮。":[13,581655,28725,1],"普通话":[13,610380,5925,1],"有名":[13,616305,4605,1],"来说":[13,620910,4845,1],"根据":[13,625755,4725,1,0.9],"根据地图，宾馆就在前面。":[13,630480,16005,1,0.96],"水平":[13,646485,5085,1,0.85],"爷爷经常给我讲故事。":[13,651570,11685,1],"节日":[13,663255,4725,1,0.88],"虽然有的地方安娜听不懂，但是她很喜欢这个故事。":[13,667980,27045,1],"行李箱":[13,695025,5925,1,0.78],"表示":[13,700950,4965,1],"过去":[13,705915,4605,1,0.88],"过去她只在书上读过关于中国的故事，现在她觉得自己真的开始了解中国了。":[13,710520,38805,1,0.92],"过去这里只有几家商店。":[13,749325,12525,1,0.93],"这个节日既有意思又让人快乐。":[13,761850,16005,1],"这个行李箱是谁的？":[13,777855,10485,1,0.96],"这家宾馆既干净又便宜。":[13,788340,12765,1],"这家饭馆非常有名。":[13,801105,11205,1],"这次旅游你带了几个行李箱？":[13,812310,14205,1,0.91],"这段时间我很忙。":[13,826515,10605,1,0.97],"上网":[14,0,4365,1,0.94],"不一定。这里工作机会多，买东西也方便，但是环境不太好。|m":[14,4365,36285,1],"为了使城市的环境更好，最近几年，城市里出现了很多新公园和花园，河边也种了很多树。":[14,40650,48765,1],"人们几乎每天都上网，用手机买东西、看新闻。":[14,89415,26445,1,0.94],"他家有一个小花园。":[14,115860,10725,1],"以前是。现在我觉得只有环境好，人才会健康快乐。|m":[14,126585,31005,1],"但是城市大了，车也多了，环境比过去差了。":[14,157590,26205,1,0.97],"住在这里买东西很方便。":[14,183795,13125,1],"你一般上网做什么？":[14,196920,10605,1],"你不是最喜欢大城市吗？":[14,207525,13005,1],"你不是说今天要来吗？":[14,220530,11565,1,0.83],"你在北京看过熊猫吗？":[14,232095,11925,1],"你打算一直住在这个城市吗？":[14,244020,14445,1],"使":[14,258465,3285,1,0.51],"公园":[14,261750,4485,1,0.93],"公园让这个城市更漂亮了。":[14,266235,14925,1],"公园里有很多树和花。":[14,281160,11805,1,0.95],"几乎":[14,292965,4725,1,0.89],"出现":[14,297690,4965,1,0.89],"动物":[14,302655,4125,1],"变化":[14,306780,4845,1,0.75],"只有":[14,311625,4605,1,0.8],"只有你去，他才会去。":[14,316230,14085,1],"只有多练习，才能说好汉语。":[14,330315,17085,1],"只有大家都关心环境，城市才会越来越漂亮。":[14,347400,24165,1],"听到":[14,371565,4485,1],"城市":[14,376050,5205,1],"城市里出现了很多新公园。":[14,381255,14565,1],"天气不好会影响我们的比赛。":[14,395820,14925,1],"影响":[14,410745,4965,1,0.83],"我们不是朋友吗？":[14,415710,9045,1],"我几乎每天都上网。":[14,424755,10965,1,0.79],"我在这个城市住了二十年了，这些年城市的变化非常大。":[14,435720,29205,1],"我打算以后一直住在这里。":[14,464925,13365,1],"我打算以后住在一个小城市，那里有河，有树，还能听到鸟叫。|m":[14,478290,40485,1],"我每天早上都看新闻。":[14,518775,12045,1],"我相信，只有大家都关心环境，我们的城市才会越来越漂亮。":[14,530820,35685,1,0.92],"打算":[14,566505,4845,1],"新闻":[14,571350,4845,1],"方便":[14,576195,4965,1,0.87],"是啊，车越来越多，公园越来越少。":[14,581160,21765,1],"树":[14,602925,3045,1,0.45],"树上有两只鸟。":[14,605970,9645,1],"河边有很多人在跑步。":[14,615615,12285,1,0.89],"河里的鱼越来越少，树上也几乎看不到鸟了。":[14,627900,23565,1,0.91],"熊猫":[14,651465,4845,1,0.8],"熊猫是一种很可爱的动物。":[14,656310,14085,1],"环境":[14,670395,5085,1,0.89],"现在，河里又有鱼了，树上的鸟也多了。":[14,675480,23685,1,0.91],"花园":[14,699165,4965,1],"车":[14,704130,3285,1,0.39],"边":[14,707415,3165,1,0.39],"过去这里只有几条街道，几乎没有高楼；现在高楼越来越多，地铁也越来越多，去哪里都很方便。":[14,710580,52485,1],"这个周末你打算做什么？":[14,763065,12285,1],"这个城市的变化太大了！":[14,775350,12765,1,0.97],"这个问题很简单，谁不会啊？":[14,788115,17685,1,0.91],"这件事情使我很难过。":[14,805800,11565,0,0.93],"这几年，城市里的车越来越多。":[14,817365,18885,1]}}